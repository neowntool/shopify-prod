{%- comment -%}
  neOwn Young Voices Championship (NYVC) landing page, built from the "New Website" Figma file
  (desktop frame 223:3, mobile frame 351:37741). Button links are settings so the registration form,
  video submission and thank-you flow can be wired in later without touching this markup.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign register_url = s.register_url | default: '#nyvc-register'
  assign submit_url = s.submit_url | default: '#nyvc-register'
  assign play_url = s.play_url | default: 'https://play.google.com/store/apps/details?id=com.neown'
  assign app_url = s.app_url | default: 'https://apps.apple.com/in/app/neown/id6483860525'
  assign arrow_purple = 'nyvc-ic-arrow-purple.svg' | asset_url
  assign arrow_white = 'nyvc-ic-arrow-white.svg' | asset_url
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geologica:wght@400;500;600;700;800&family=Outfit:wght@600;700&family=Quicksand:wght@700&display=swap">
{%- if s.hide_theme_whatsapp -%}<style>#whatsapp-widget{display:none!important}</style>{%- endif -%}

<div class="nyvc" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">

    {%- comment -%} 1. Hero {%- endcomment -%}
    <section class="nyvc-hero" aria-label="neOwn Young Voices Championship">
      <img class="nyvc-blob nyvc-blob--cyan" src="{{ 'nyvc-blob-cyan.svg' | asset_url }}" alt="" aria-hidden="true">
      <img class="nyvc-blob nyvc-blob--yellow" src="{{ 'nyvc-blob-yellow.svg' | asset_url }}" alt="" aria-hidden="true">
      <span class="nyvc-tick nyvc-desk" style="left:1.74%;top:51.8%;width:0.84%;height:0.85%;--r:-101.83deg;--k:-2.57deg"><img src="{{ 'nyvc-tL1.svg' | asset_url }}" alt=""></span>
      <span class="nyvc-tick nyvc-desk" style="left:2.26%;top:47.13%;width:0.73%;height:1.54%;--r:-101.83deg;--k:-2.57deg"><img src="{{ 'nyvc-tL2.svg' | asset_url }}" alt=""></span>
      <span class="nyvc-tick nyvc-desk" style="left:4.2%;top:44.57%;width:0.41%;height:1.73%;--r:-101.83deg;--k:-2.57deg"><img src="{{ 'nyvc-tL3.svg' | asset_url }}" alt=""></span>

      <div class="nyvc-hero-inner">
        <span class="nyvc-tick nyvc-desk" style="left:49.28%;top:4.86%;width:1.06%;height:2.25%;--r:-104.8deg;--k:2.13deg"><img src="{{ 'nyvc-taA1.svg' | asset_url }}" alt=""></span>
        <span class="nyvc-tick nyvc-desk" style="left:49.85%;top:2.16%;width:1.04%;height:2.75%;--r:-104.8deg;--k:2.13deg"><img src="{{ 'nyvc-taA2.svg' | asset_url }}" alt=""></span>
        <span class="nyvc-tick nyvc-desk" style="left:48.64%;top:7.87%;width:1.13%;height:1.36%;--r:-104.8deg;--k:2.13deg"><img src="{{ 'nyvc-taA3.svg' | asset_url }}" alt=""></span>

        <div class="nyvc-hero-left">
          <div class="nyvc-hero-top">
            <div class="nyvc-hero-brand">
              <div class="nyvc-logo">
                <img src="{{ 'nyvc-logo.png' | asset_url }}" alt="neOwn Young Voices Championship" width="635" height="635">
              </div>
              <div class="nyvc-art nyvc-art--mobile" aria-hidden="true">{% render 'nyvc-art' %}</div>
            </div>
            <p class="nyvc-hero-tagline">A reading and speaking championship that celebrates young readers <br class="nyvc-desk">and their ideas.</p>
            <div class="nyvc-hero-ctas">
              <a class="nyvc-btn nyvc-btn--hero nyvc-btn--primary" href="{{ register_url }}">
                <img class="nyvc-btn-ic" src="{{ 'nyvc-ic-doc-white.svg' | asset_url }}" alt="" aria-hidden="true">
                <span>Register Now</span>
                <img class="nyvc-btn-arrow" src="{{ arrow_white }}" alt="" aria-hidden="true">
              </a>
              <a class="nyvc-btn nyvc-btn--hero nyvc-btn--soft" href="{{ submit_url }}">
                <img class="nyvc-btn-ic" src="{{ 'nyvc-ic-video-purple.svg' | asset_url }}" alt="" aria-hidden="true">
                <span>Submit Your Video</span>
                <img class="nyvc-btn-arrow" src="{{ arrow_purple }}" alt="" aria-hidden="true">
              </a>
            </div>
          </div>
          <div class="nyvc-who">
            <p class="nyvc-who-title">Who can participate?</p>
            <p class="nyvc-who-text">Students in Standards 3–8 from participating schools in Mumbai can register.</p>
          </div>
        </div>

        <div class="nyvc-art nyvc-art--desktop" aria-hidden="true">{% render 'nyvc-art' %}</div>
      </div>
    </section>

    {%- comment -%} 2. How it works {%- endcomment -%}
    <section class="nyvc-how" aria-labelledby="nyvc-how-h">
      <h2 class="nyvc-h2" id="nyvc-how-h">How it works</h2>
      <div class="nyvc-how-grid">
        <div class="nyvc-step">
          <div class="nyvc-step-head"><span class="nyvc-step-no">1</span><img src="{{ 'nyvc-step-register.svg' | asset_url }}" alt="" width="18" height="16"></div>
          <div class="nyvc-step-body">
            <h3>Register</h3>
            <p>Register below 3 days from the workshop conducted in your school.</p>
          </div>
          <a class="nyvc-btn nyvc-btn--step" href="{{ register_url }}"><span>Register Now</span><img class="nyvc-btn-arrow" src="{{ arrow_purple }}" alt="" aria-hidden="true"></a>
        </div>
        <div class="nyvc-step">
          <div class="nyvc-step-head"><span class="nyvc-step-no">2</span><img src="{{ 'nyvc-step-books.svg' | asset_url }}" alt="" width="22" height="16"></div>
          <div class="nyvc-step-body">
            <h3>Choose your books</h3>
            <p>Select <span class="nyvc-ink">2 books</span> from the neOwn Young Voices Championship catalogue on the neOwn app.</p>
          </div>
          <div class="nyvc-stores">
            <a class="nyvc-store" href="{{ play_url }}" target="_blank" rel="noopener" aria-label="Get it on Google Play">
              <img class="nyvc-store-ic nyvc-store-ic--play" src="{{ 'nyvc-playstore.svg' | asset_url }}" alt="">
              <span class="nyvc-store-txt"><span class="nyvc-store-small">GET IT ON</span><img class="nyvc-store-word" src="{{ 'nyvc-googleplay-word.svg' | asset_url }}" alt=""></span>
            </a>
            <a class="nyvc-store" href="{{ app_url }}" target="_blank" rel="noopener" aria-label="Download on the App Store">
              <img class="nyvc-store-ic nyvc-store-ic--apple" src="{{ 'nyvc-apple.svg' | asset_url }}" alt="">
              <span class="nyvc-store-txt nyvc-store-txt--apple"><span class="nyvc-store-tiny">Download on the</span><span class="nyvc-store-big">App Store</span></span>
            </a>
          </div>
        </div>
        <div class="nyvc-step">
          <div class="nyvc-step-head"><span class="nyvc-step-no">3</span><img src="{{ 'nyvc-step-video.svg' | asset_url }}" alt="" width="20" height="16"></div>
          <div class="nyvc-step-body">
            <h3>Read and record</h3>
            <p>Choose any one of your selected books and record a video responding to the prompt for your category.</p>
          </div>
        </div>
        <div class="nyvc-step">
          <div class="nyvc-step-head"><span class="nyvc-step-no">4</span><img src="{{ 'nyvc-step-upload.svg' | asset_url }}" alt="" width="22" height="16"></div>
          <div class="nyvc-step-body">
            <h3>Submit your video</h3>
            <p>Click below to submit your video.</p>
          </div>
          <a class="nyvc-btn nyvc-btn--step" href="{{ submit_url }}"><span>Submit Your Video</span><img class="nyvc-btn-arrow" src="{{ arrow_purple }}" alt="" aria-hidden="true"></a>
        </div>
        <div class="nyvc-step">
          <div class="nyvc-step-head"><span class="nyvc-step-no">5</span><img src="{{ 'nyvc-step-announce.svg' | asset_url }}" alt="" width="22" height="22"></div>
          <div class="nyvc-step-body">
            <h3>Await result announcement</h3>
            <p>Results will be posted on the website and will be emailed to all participants who qualify for the Grand Finale</p>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} 3. Register / Submit {%- endcomment -%}
    <section class="nyvc-cta2" id="nyvc-register" aria-label="Register or submit your video">
      <div class="nyvc-cta2-col">
        <h2 class="nyvc-cta2-h">Register Your Child</h2>
        <p class="nyvc-cta2-sub">Complete the registration form to participate in the Young Voice Championship</p>
        <p class="nyvc-cta2-note">{{ s.entry_note }}</p>
        <a class="nyvc-btn nyvc-btn--big nyvc-btn--primary" href="{{ register_url }}">
          <img class="nyvc-btn-ic" src="{{ 'nyvc-ic-doc-white.svg' | asset_url }}" alt="" aria-hidden="true">
          <span>Register Now</span>
          <img class="nyvc-btn-arrow" src="{{ arrow_white }}" alt="" aria-hidden="true">
        </a>
      </div>
      <div class="nyvc-cta2-col">
        <h2 class="nyvc-cta2-h">Submit your video</h2>
        <p class="nyvc-cta2-sub">Once you have read your selected book and prepared your response, submit your video using the link below.</p>
        <p class="nyvc-cta2-note">{{ s.entry_note }}</p>
        <a class="nyvc-btn nyvc-btn--big nyvc-btn--pink" href="{{ submit_url }}">
          <img class="nyvc-btn-ic" src="{{ 'nyvc-ic-video-white.svg' | asset_url }}" alt="" aria-hidden="true">
          <span>Submit Your Video</span>
          <img class="nyvc-btn-arrow" src="{{ arrow_white }}" alt="" aria-hidden="true">
        </a>
      </div>
    </section>

    {%- comment -%} 4. Journey {%- endcomment -%}
    <section class="nyvc-card nyvc-journey" aria-labelledby="nyvc-journey-h">
      <div class="nyvc-head">
        <h2 class="nyvc-h2" id="nyvc-journey-h">Your journey to the grand finale</h2>
        <p class="nyvc-sub">The championship continues beyond video submission. Here's what happens next.</p>
      </div>
      <ol class="nyvc-stages">
        <li class="nyvc-stage">
          <div class="nyvc-stage-top"><span class="nyvc-stage-ic"><img src="{{ 'nyvc-j-video.svg' | asset_url }}" alt="" width="20" height="16"></span><span class="nyvc-stage-tag">Stage 01</span></div>
          <h3>Video submissions and judging</h3>
          <p>Submit your video by your school's deadline. Entries will be reviewed by the championship team.</p>
          <span class="nyvc-stage-date">School-wise deadlines</span>
        </li>
        <li class="nyvc-stage-arrow" aria-hidden="true"><img src="{{ 'nyvc-j-arrow.svg' | asset_url }}" alt=""></li>
        <li class="nyvc-stage">
          <div class="nyvc-stage-top"><span class="nyvc-stage-ic"><img src="{{ 'nyvc-j-finalists.svg' | asset_url }}" alt="" width="24" height="12"></span><span class="nyvc-stage-tag">Stage 02</span></div>
          <h3>Selection of finalists</h3>
          <p>Selected students from each school will be informed directly</p>
          <span class="nyvc-stage-date">{{ s.date_finalists }}</span>
        </li>
        <li class="nyvc-stage-arrow" aria-hidden="true"><img src="{{ 'nyvc-j-arrow.svg' | asset_url }}" alt=""></li>
        <li class="nyvc-stage">
          <div class="nyvc-stage-top"><span class="nyvc-stage-ic"><img src="{{ 'nyvc-j-training.svg' | asset_url }}" alt="" width="22" height="18"></span><span class="nyvc-stage-tag">Stage 03</span></div>
          <h3>Online training</h3>
          <p>120 Finalists will receive online training from IVY Spires and a Harvard Debate Council certificate</p>
          <span class="nyvc-stage-date">{{ s.date_training }}</span>
        </li>
        <li class="nyvc-stage-arrow" aria-hidden="true"><img src="{{ 'nyvc-j-arrow.svg' | asset_url }}" alt=""></li>
        <li class="nyvc-stage">
          <div class="nyvc-stage-top"><span class="nyvc-stage-ic"><img src="{{ 'nyvc-j-finale.svg' | asset_url }}" alt="" width="18" height="18"></span><span class="nyvc-stage-tag">Grand Finale</span></div>
          <h3>In-person grand finale</h3>
          <p>Finalists will come together in Mumbai to showcase their skills, and compete for prizes.</p>
          <span class="nyvc-stage-date">{{ s.date_finale }}</span>
        </li>
      </ol>
    </section>

    {%- comment -%} 5. Important dates {%- endcomment -%}
    <section class="nyvc-dates" aria-labelledby="nyvc-dates-h">
      <div class="nyvc-head">
        <h2 class="nyvc-h2" id="nyvc-dates-h">Important dates</h2>
        <p class="nyvc-sub">Dates vary by school. Please check your school’s schedule before registering.</p>
      </div>
      <div class="nyvc-dates-box">
        <div class="nyvc-table-scroll">
          <table class="nyvc-table">
            <thead>
              <tr><th scope="col">School</th><th scope="col">Workshop date</th><th scope="col">Registration closes</th><th scope="col">Video submission deadline</th></tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type == 'school' -%}
                  <tr {{ block.shopify_attributes }}>
                    <th scope="row">{{ block.settings.school | escape }}</th>
                    <td>{{ block.settings.workshop | escape }}</td>
                    <td>{{ block.settings.closes | escape }}</td>
                    <td>{{ block.settings.deadline | escape }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <p class="nyvc-dates-note"><img src="{{ 'nyvc-ic-info.svg' | asset_url }}" alt="" width="17" height="17"><span>Registration closes three days after your school’s workshop. Please refer to the table above for your deadlines.</span></p>
      </div>
    </section>

    {%- comment -%} 6. Video prompts {%- endcomment -%}
    <section class="nyvc-pad nyvc-prompts" aria-labelledby="nyvc-prompts-h">
      <div class="nyvc-head">
        <h2 class="nyvc-h2" id="nyvc-prompts-h">Video prompts</h2>
        <p class="nyvc-sub nyvc-sub--narrow">Find the prompt for your standard group below. Your video must respond to the prompt for your category and be about one of the two books you selected from the neOwn Young Voices Championship catalogue on the neOwn app.</p>
      </div>
      <div class="nyvc-prompt-grid">
        {%- assign cats = 'I|II|III' | split: '|' -%}
        {%- assign stds = '3–4|5–6|7–8' | split: '|' -%}
        {%- capture d1 -%}Focus on vivid character descriptions, emotional moments, and expressive reading aloud.{%- endcapture -%}
        {%- capture d2 -%}Explore personal perspectives, thematic connections, and how the narrative moved you.{%- endcapture -%}
        {%- capture d3 -%}Critique overarching plot arcs, author viewpoints, and ethical or real-world reflections.{%- endcapture -%}
        {%- assign descs = d1 | append: '||' | append: d2 | append: '||' | append: d3 | split: '||' -%}
        {%- for cat in cats -%}
          {%- assign n = forloop.index -%}
          {%- assign view_key = 'prompt' | append: n | append: '_view' -%}
          {%- assign pdf_key = 'prompt' | append: n | append: '_pdf' -%}
          <div class="nyvc-prompt nyvc-prompt--{{ n }}">
            <span class="nyvc-prompt-badge">CATEGORY {{ cat }}</span>
            <h3>Standards {{ stds[forloop.index0] }}:</h3>
            <p>{{ descs[forloop.index0] }}</p>
            <div class="nyvc-prompt-btns">
              <a class="nyvc-btn nyvc-btn--outline" href="{{ s[view_key] | default: '#' }}"{% if s[view_key] != blank %} target="_blank" rel="noopener"{% endif %}><span>View Prompt</span><img class="nyvc-btn-arrow" src="{{ arrow_purple }}" alt="" aria-hidden="true"></a>
              <a class="nyvc-btn nyvc-btn--outline" href="{{ s[pdf_key] | default: '#' }}"{% if s[pdf_key] != blank %} target="_blank" rel="noopener" download{% endif %}><span>Download PDF</span><img class="nyvc-btn-arrow" src="{{ arrow_purple }}" alt="" aria-hidden="true"></a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>

    {%- comment -%} 7. Judging {%- endcomment -%}
    <section class="nyvc-card nyvc-judge" aria-labelledby="nyvc-judge-h">
      <div class="nyvc-head">
        <h2 class="nyvc-h2" id="nyvc-judge-h">How will the videos be judged?</h2>
        <p class="nyvc-sub">Entries will be evaluated based on the following criteria. Age-appropriate expectations will apply for each category</p>
      </div>
      <ol class="nyvc-rubric">
        <li><span class="nyvc-rubric-no">1</span><h3>Understanding <br>of the book</h3></li>
        <li><span class="nyvc-rubric-no">2</span><h3>Original <br>thinking</h3></li>
        <li><span class="nyvc-rubric-no">3</span><h3>Clarity of <br>expression</h3></li>
        <li><span class="nyvc-rubric-no">4</span><h3>Relevance to <br>the prompt</h3></li>
        <li><span class="nyvc-rubric-no">5</span><h3>Engagement <br>and delivery</h3></li>
      </ol>
    </section>

    {%- comment -%} 8. Guidelines {%- endcomment -%}
    <section class="nyvc-pad nyvc-guides" aria-labelledby="nyvc-guides-h">
      <h2 class="nyvc-h2" id="nyvc-guides-h">Video submission guidelines</h2>
      <ul class="nyvc-guide-grid">
        <li><img src="{{ 'nyvc-g-duration.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>Duration:</strong> Maximum two minutes.</p></li>
        <li><img src="{{ 'nyvc-g-language.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>Language:</strong> English.</p></li>
        <li><img src="{{ 'nyvc-g-format.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>Format:</strong> Vertical video, in portrait <br class="nyvc-desk">orientation (9:16), suitable for mobile viewing.</p></li>
        <li><img src="{{ 'nyvc-g-filesize.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>File size:</strong> Less than 100 MB.</p></li>
        <li><img src="{{ 'nyvc-g-book.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>Book:</strong> Choose one of the two books <br class="nyvc-desk">selected through the neOwn app.</p></li>
        <li><img src="{{ 'nyvc-g-prompt.svg' | asset_url }}" alt="" width="40" height="40"><p><strong>Prompt:</strong> Respond to the category-specific <br class="nyvc-desk">prompt given above.</p></li>
      </ul>
    </section>

    {%- comment -%} 9. Before you record {%- endcomment -%}
    <section class="nyvc-check" aria-labelledby="nyvc-check-h">
      <h2 class="nyvc-h2" id="nyvc-check-h">Before you record</h2>
      <ul class="nyvc-check-list">
        {%- assign tips = "Help your child find a quiet, well-lit space.|Keep the camera steady and position it so your child's face is clearly visible.|Make sure the child's voice can be heard clearly.|Ask your child to speak naturally and look towards the camera.|Encourage your child to share their own ideas and opinions.|Check the final video and file size before uploading.|Keep the video within the two-minute limit." | split: '|' -%}
        {%- for tip in tips -%}
          <li><img src="{{ 'nyvc-ic-check.svg' | asset_url }}" alt="" width="20" height="20"><span>{{ tip }}</span></li>
        {%- endfor -%}
      </ul>
      <p class="nyvc-check-note">Parents may help with recording and uploading. However, the child's ideas and spoken response should be their own.</p>
    </section>

    {%- comment -%} 10. FAQ {%- endcomment -%}
    <section class="nyvc-pad nyvc-faq" aria-labelledby="nyvc-faq-h">
      <h2 class="nyvc-h2 nyvc-h2--dark" id="nyvc-faq-h">Frequently asked questions</h2>
      <div class="nyvc-faq-grid">
        <div class="nyvc-faq-item"><img src="{{ 'nyvc-faq-q1.svg' | asset_url }}" alt="" width="17" height="26"><div><h3>Can I choose any book?</h3><p>Choose two books from the <strong><em>neOwn Young Voices Championship</em></strong> catalogue on the neOwn app. Your video must be about one of those two books.</p></div></div>
        <div class="nyvc-faq-item"><img src="{{ 'nyvc-faq-q2.svg' | asset_url }}" alt="" width="17" height="26"><div><h3>When do I need to submit my video?</h3><p>Check the deadline listed for your school in the Important Dates table.</p></div></div>
        <div class="nyvc-faq-item"><img src="{{ 'nyvc-faq-q2.svg' | asset_url }}" alt="" width="17" height="26"><div><h3>Which prompt should I answer?</h3><p>Use the prompt listed for your standard group above.</p></div></div>
        <div class="nyvc-faq-item"><img src="{{ 'nyvc-faq-q1.svg' | asset_url }}" alt="" width="17" height="26"><div><h3>What happens after I submit my video?</h3><p>Entries will be reviewed by the championship team. Selected participants will be contacted with details of the next round.</p></div></div>
        <div class="nyvc-faq-item"><img src="{{ 'nyvc-faq-q1.svg' | asset_url }}" alt="" width="17" height="26"><div><h3>Can my parent help me make the video?</h3><p>Yes. A parent can help with recording and uploading, but the ideas and spoken response must be yours.</p></div></div>
      </div>
    </section>

    {%- comment -%} 11. About neOwn {%- endcomment -%}
    <section class="nyvc-about" aria-labelledby="nyvc-about-h">
      <div class="nyvc-about-text">
        <h2 id="nyvc-about-h">About neOwn</h2>
        <p>neOwn is India's 1st app-based children's book library operating out of Mumbai, with 15,000+ active subscribers and 25,000+ families served across the country. neOwn currently houses a curated collection of 75,000+ physical books from leading publishers, including Scholastic, HarperCollins, Penguin, Hachette, and many others, that are circulated to kids homes across the country.</p>
        <p>As a holistic initiative to help parents raise confident kids, neOwn offers a Book Library, Toy Library, and a free monthly Reading Challenge accessible to all via the neOwn app. neOwn regularly hosts free book exploration sessions and has conducted 90+ editions in the last 2 years. With a community of parents and a comprehensive ecosystem of reading resources, neOwn is building India's largest platform for encouraging kids to build a reading habit.</p>
      </div>
      <div class="nyvc-final">
        <p>Ready to participate? Register above and begin your <br class="nyvc-desk">Young Voices Championship journey.</p>
        <a class="nyvc-final-btn" href="{{ register_url }}">Register here</a>
      </div>
    </section>

  </div>
</div>

<style>
  #nyvc-{{ section.id }} {
    --nyvc-ink: #404040; --nyvc-muted: #6a6a6a; --nyvc-purple: #6730ef; --nyvc-purple-10: #e6e0ff; --nyvc-purple-20: #d2c8ff;
    --nyvc-pink: #ff2fac; --nyvc-pink-10: #ffe1f3; --nyvc-pink-20: #ffd3ee; --nyvc-pink-30: #ffc0e6; --nyvc-line: #e7e7e7;
    font-family: 'Geologica', sans-serif; color: var(--nyvc-ink); background: #fff;
  }
  #nyvc-{{ section.id }} *, #nyvc-{{ section.id }} *::before, #nyvc-{{ section.id }} *::after { box-sizing: border-box; }
  #nyvc-{{ section.id }} :where(h1, h2, h3, p, ul, ol, li, table) { margin: 0; padding: 0; font-family: inherit; letter-spacing: 0; text-transform: none; }
  #nyvc-{{ section.id }} :where(ul, ol) { list-style: none; }
  #nyvc-{{ section.id }} img { display: block; max-width: none; }
  #nyvc-{{ section.id }} a { text-decoration: none; }
  #nyvc-{{ section.id }} .nyvc-wrap { max-width: 1440px; margin: 0 auto; padding: 32px 40px 72px; display: flex; flex-direction: column; gap: 48px; }
  #nyvc-{{ section.id }} .nyvc-h2 { font-size: 28px; font-weight: 700; line-height: 1.25; color: var(--nyvc-ink); }
  #nyvc-{{ section.id }} .nyvc-h2--dark { color: #1a192f; }
  #nyvc-{{ section.id }} .nyvc-head { display: flex; flex-direction: column; gap: 4px; }
