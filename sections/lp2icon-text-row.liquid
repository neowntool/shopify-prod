{% schema %}
{
  "name": "Icon Text Row",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Column Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your text here"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Icon Text Row",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}

<div class="custom-icon-row">
  {% for block in section.blocks %}
    <div class="custom-icon-row-item" {{ block.shopify_attributes }}>

      {% if block.settings.icon %}
        <div class="custom-icon-row-icon">
          <img
            src="{{ block.settings.icon | image_url: width: 100 }}"
            alt="{{ block.settings.text | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="custom-icon-row-text">
          {{ block.settings.text }}
        </div>
      {% endif %}

    </div>
  {% endfor %}
</div>

<style>
.custom-icon-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  width: 100%;
  background: #fff;
}

.custom-icon-row-item {
  flex: 1;
  text-align: center;
  padding: 0 15px;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.custom-icon-row-item:not(:last-child) {
  border-right: 1px solid #ddd;
}

.custom-icon-row-icon {
  height: 40px; /* Same height for all icons */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.custom-icon-row-icon img {
  width: 28px;
  height: 28px;
  object-fit: contain;
  display: block;
}

.custom-icon-row-text {
  min-height: 42px; /* Same height for all text */
  display: flex;
  align-items: flex-start;
  justify-content: center;
  text-align: center;

  font-size: 14px;
  line-height: 1.3;
  color: #000;
}

@media screen and (max-width: 749px) {
  .custom-icon-row-item {
    padding: 0 8px;
  }

  .custom-icon-row-icon {
    height: 32px;
  }

  .custom-icon-row-icon img {
    width: 24px;
    height: 24px;
  }

  .custom-icon-row-text {
    min-height: 36px;
    font-size: 12px;
  }
}
</style>