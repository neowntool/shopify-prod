{% schema %}
{
  "name": "Past Workshops Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Left Heading",
      "default": "Past Workshops"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Workshop Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "top_image",
          "label": "Top Image"
        },
        {
          "type": "url",
          "id": "top_url",
          "label": "Top Image URL"
        },
        {
          "type": "image_picker",
          "id": "bottom_image",
          "label": "Bottom Image"
        },
        {
          "type": "url",
          "id": "bottom_url",
          "label": "Bottom Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Past Workshops Grid"
    }
  ]
}
{% endschema %}

<section class="pw-grid-section">
  <div class="pw-grid-container">
    
    <div class="pw-grid-left">
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="pw-grid-right">
      <div class="pw-columns-wrapper">
        
        {% for block in section.blocks %}
          <div class="pw-column" {{ block.shopify_attributes }}>
            
            {% if block.settings.top_image != blank %}
              <a href="{{ block.settings.top_url }}" class="pw-image-box">
                <img 
                  src="{{ block.settings.top_image | image_url: width: 800 }}" 
                  alt="Workshop Image"
                  loading="lazy">
              </a>
            {% endif %}

            {% if block.settings.bottom_image != blank %}
              <a href="{{ block.settings.bottom_url }}" class="pw-image-box">
                <img 
                  src="{{ block.settings.bottom_image | image_url: width: 800 }}" 
                  alt="Workshop Image"
                  loading="lazy">
              </a>
            {% endif %}

          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
.pw-grid-section {
  padding: 60px 20px;
}

.pw-grid-container {
  max-width: 1400px;
  margin: auto;
  display: flex;
  gap: 40px;
  align-items: center;
}

.pw-grid-left {
  flex: 0 0 33%;
}

.pw-grid-left h2 {
  font-family: Playpen Sans;
font-weight: 800;
font-style: ExtraBold;
font-size: 56px;
leading-trim: NONE;
line-height: 125%;
letter-spacing: 0px;

}

.pw-grid-right {
  flex: 1;
  overflow-x: auto;
}

.pw-columns-wrapper {
  display: flex;
  gap: 20px;
  min-width: max-content;
}

.pw-column {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 280px;
}

.pw-image-box {
  display: block;
  border-radius: 16px;
  overflow: hidden;
  transition: 0.3s ease;
}

.pw-image-box img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16px;
  transition: 0.3s ease;
}

.pw-image-box:hover img {
  transform: scale(1.05);
}

/* Scrollbar styling */
.pw-grid-right::-webkit-scrollbar {
  height: 6px;
}
.pw-grid-right::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 10px;
}

/* Responsive */
@media screen and (max-width: 992px) {


    .pw-grid-right {
        width: 100%;
}
  .pw-grid-container {
    flex-direction: column;
  }

  .pw-grid-left {
    flex: unset;
  }

  .pw-grid-left h2 {
    font-size: 26px;
  }
}

@media screen and (max-width: 600px) {
  .pw-column {
    width: 220px;
  }
}
</style>