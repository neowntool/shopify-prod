{% comment %} 
  Custom Section: IDEABAAZ Style Banner
  Unique Prefix: "neown-custom-"
{% endcomment %}

<section class="neown-custom-section" style="background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');">
  <div class="neown-custom-container">
    
    {% if section.settings.top_content_html != blank %}
      <div class="neown-custom-header-content">
        {{ section.settings.top_content_html }}
      </div>
    {% endif %}

    {% if section.settings.bottom_main_image != blank %}
      <div class="neown-custom-image-wrapper">
        <a href="#">
        <img 
          src="{{ section.settings.bottom_main_image | img_url: '1200x' }}" 
          alt="{{ section.settings.bottom_main_image.alt }}"
          loading="lazy"
          class="neown-custom-main-img"
        >
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .neown-custom-section {
    position: relative;
    width: 100%;
    padding: 260px 20px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .neown-custom-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .neown-custom-header-content {
    margin-bottom: 40px;
    line-height: 1.6;
    color: #333; /* Default text color */
  }

  /* HTML content styling - headings, paragraphs etc */
  .neown-custom-header-content h2 {
    font-size: 2.5rem;
    margin-bottom: 10px;
    font-weight: bold;
  }

  .neown-custom-image-wrapper {
    max-width: 900px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    line-height: 0;
  }

  .neown-custom-main-img {
    width: 100%;
    height: 440px;
    display: block;
    transition: transform 0.3s ease;
  }

  /* Responsive Design */
  @media screen and (max-width: 768px) {
    .neown-custom-section {
      padding: 140px 15px;
    }
    .neown-custom-header-content h2 {
      font-size: 1.8rem;
    }
    .neown-custom-header-content {
      margin-bottom: 25px;
    }
     .neown-custom-main-img {
    width: 100%;
    height: 100%;
  }
</style>

{% schema %}
{
  "name": "Neown Style Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "html",
      "id": "top_content_html",
      "label": "Top Content (HTML)",
      "default": "<h2>As seen on National TV</h2><p>neOwn is India's First App-Based Book Library</p>"
    },
    {
      "type": "image_picker",
      "id": "bottom_main_image",
      "label": "Bottom Main Image"
    }
  ],
  "presets": [
    {
      "name": "Neown Style Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}