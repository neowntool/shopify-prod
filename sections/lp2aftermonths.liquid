<section class="nsam-section">

  <div class="nsam-container">

    <div class="nsam-header">
      <h2 class="nsam-heading">
        {{ section.settings.heading }}
      </h2>

      <div class="nsam-subheading">
        {{ section.settings.subheading }}
      </div>
    </div>

    <div class="nsam-slider">

      {% for block in section.blocks %}

        <div
          class="nsam-card nsam-card--{{ block.settings.card_style }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="nsam-image-wrap">
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: class: 'nsam-image', loading: 'lazy'
              }}
            </div>
          {% endif %}

          <div class="nsam-content">

            <h3 class="nsam-name">
              {{ block.settings.name }}
            </h3>

            <div class="nsam-review">
              {{ block.settings.content }}
            </div>

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>

.nsam-section{
  padding:60px 0;
}

.nsam-container{
  max-width:1400px;
  margin:0 auto;
}

.nsam-header{
  text-align:center;
  margin-bottom:40px;
}

.nsam-heading{
  margin:0;
  font-size:44px;
  line-height:1.1;
  font-weight:800;
  color:#3d3d3d;
}

.nsam-subheading{
  margin-top:10px;
  color:#888;
  font-size:22px;
}

.nsam-slider{
  display:flex;
  gap:14px;
  overflow-x:auto;
  overflow-y:hidden;
  padding:0 0px 15px;
  scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch;
}

.nsam-slider::-webkit-scrollbar{
  height:8px;
}

.nsam-slider::-webkit-scrollbar-thumb{
  background:#cfcfcf;
  border-radius:30px;
}

.nsam-card{
  flex:0 0 220px;
  border-radius:16px;
  overflow:hidden;
}

.nsam-card--yellow{
  background:#ECF87D;
}

.nsam-card--pink{
  background:#FFE1F3;
}

.nsam-image-wrap{
  height:170px;
}

.nsam-image{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.nsam-content{
  padding:18px;
}

.nsam-name{
  margin:0 0 10px;
  font-size:18px;
  font-weight:700;
  color:#333;
}

.nsam-review{
  font-size:15px;
  line-height:1.55;
  color:#4e4e4e;
}

@media(max-width:767px){
  .nsam-header {
    text-align: left;
    margin-bottom: 22px;
}

  .nsam-section{
    padding:2px 10px 10px 10px;
  }

  .nsam-heading{
    font-size:34px;
  }

  .nsam-subheading{
    font-size:15px;
  }

  .nsam-card{
    flex:0 0 260px;
  }

  .nsam-image-wrap{
    height:150px;
  }

}

</style>

{% schema %}
{
  "name": "After 3 Months",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What happens after 3 months"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "From 10,000+ families across India"
    }
  ],
  "blocks": [
    {
      "type": "story_card",
      "name": "Story Card",
      "settings": [
        {
          "type": "select",
          "id": "card_style",
          "label": "Card Color",
          "options": [
            {
              "value": "yellow",
              "label": "Yellow"
            },
            {
              "value": "pink",
              "label": "Pink"
            }
          ],
          "default": "yellow"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Yashvi Gada"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "Add customer story here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "After 3 Months"
    }
  ]
}
{% endschema %}