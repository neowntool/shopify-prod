
{% schema %}
{
  "name": "Custom Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Form Heading",
      "default": "Leave a Message"
    }
  ],
  "blocks": [
    {
      "type": "contact_info",
      "name": "Contact Info",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Working Hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Form"
    }
  ]
}
{% endschema %}


<section class="custom-contact-section">

<div class="contact-wrapper">

<div class="contact-grid">


<!-- LEFT CONTACT INFO -->

<div class="contact-info">

{% for block in section.blocks %}

<h3>{{ block.settings.title }}</h3>

<p>
<img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/weui_location-outlined.png?v=1773300078" class="info_icons"/>
{{ block.settings.address }}
</p>

<p>
<img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/whatsappicon.png?v=1784635666" class="info_icons"/>
<a href="https://api.whatsapp.com/send/?phone=919324455972&text=Hi%2C+can+you+tell+me+about+neOwn+Subscriptions%3F&type=phone_number&app_absent=0" target="_blank">{{ block.settings.phone }}</a>
</p>

<p>
<img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/proicons_mail.png?v=1773300078" class="info_icons"/>
<a href="mailto:contact@neown.in" target="_blank">{{ block.settings.email }}</a>
</p>

<p>
<img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/formkit_time.png?v=1773300078" class="info_icons"/>
{{ block.settings.hours }}
</p>

{% endfor %}

<div class="social_icons_contact">
<a href="https://api.whatsapp.com/send/?phone=919324455972&text=Hi%2C+can+you+tell+me+about+neOwn+Subscriptions%3F&type=phone_number&app_absent=0" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/basil_whatsapp-solid.png?v=1773300079" class="info_social_icons"/></a>
<a href="https://www.instagram.com/neown.in/" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/Instagram.png?v=1773300079" class="info_social_icons"/></a>
<a href="https://www.linkedin.com/company/neown/" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/LinkedIn.png?v=1773300078" class="info_social_icons"/></a>
<a href="https://www.facebook.com/share/1RV6DxbeXDuA2QAX/?mibextid=qi2Omg" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/Facebook.png?v=1773300079" class="info_social_icons"/></a>
</div>

</div>


<!-- RIGHT CONTACT FORM -->

<div class="contact-form">

<h3>{{ section.settings.heading }}</h3>

{% form 'contact' %}

{% if form.posted_successfully? %}
<p class="success-msg">Thanks for contacting us. We'll get back to you soon.</p>
{% endif %}


<div class="form-field">

<label for="name">Full Name</label>

<input
type="text"
id="name"
name="contact[name]"
placeholder="John Doe"
required
>

</div>


<div class="form-field">

<label for="email">Email id</label>

<input
type="email"
id="email"
name="contact[email]"
placeholder="johndoe@gmail.com"
required
>

</div>


<div class="form-field">

<label for="phone">Phone Number</label>

<input
type="tel"
id="phone"
name="contact[phone]"
placeholder="+91 7XXXXXXXXX"
>

</div>


<div class="form-field">

<label for="message">Message</label>

<textarea
id="message"
name="contact[body]"
rows="6"
placeholder="Write your message here"
required
></textarea>

</div>


<button type="submit">
Submit
</button>

{% endform %}

</div>


</div>

</div>

</section>



<style>
.custom-contact-section{
background:#FAFFD0;
padding:40px 20px 100px 20px;
}

.custom-contact-section .contact-wrapper{
max-width:1240px;
margin:auto;
background:white;
border-radius:12px;
padding:40px;
box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.custom-contact-section .contact-grid{
display:grid;
grid-template-columns:348px 1fr;
gap:40px;
align-items:start;
}


/* LEFT BOX */

.custom-contact-section .contact-info{
background:#DFD7FF;
padding:51px 25px;
border-radius:10px;
font-size:14px;
line-height:1.7;
margin-top: 22px;
}

.custom-contact-section .contact-info h3{
font-family: Nunito;
font-weight: 600;
font-style: Bold;
font-size: 26px;
leading-trim: NONE;
line-height: 125%;
letter-spacing: 0px;
text-align: center;
margin-bottom: 14px;

}

.custom-contact-section .contact-info p{
margin-bottom:24px;
font-family: Nunito;
font-weight:500;
font-size:16px;
line-height:175%;
display:flex;
align-items:center;
gap:10px;
text-align: left;
}

/* FORM */

.custom-contact-section .contact-form h3{
text-align:left;
font-family: Nunito;
font-weight: 700;
font-style: Bold;
font-size: 26px;
leading-trim: NONE;
line-height: 125%;
letter-spacing: 0px;
margin-bottom:24px;
}


/* FORM FIELD */

.custom-contact-section .form-field{
display:flex;
flex-direction:column;
margin-bottom:0px;
border: none !important;
padding: 0px;
}


/* LABEL */

.custom-contact-section .form-field label{
font-family: Nunito;
font-weight: 700;
font-style: Bold;
font-size: 16px;
leading-trim: NONE;
line-height: 125%;
letter-spacing: 0px;
color: #2B2B2B;
margin-bottom: 8px;
text-align: left;
}


/* INPUT */

.custom-contact-section .contact-form input,
.custom-contact-section .contact-form textarea{
width:100%;
padding:16px;
border:1px solid #E0E0E0;
color: #000;
border-radius:6px;
font-size:14px;
background:transperant;
}


/* BUTTON */

.custom-contact-section .contact-form button{
width:100%;
background: #FF1A96;
border:none;
padding:14px;
color:white;
font-weight:600;
border-radius:6px;
cursor:pointer;
margin-top:10px;
}

.custom-contact-section .contact-form input::placeholder,
.custom-contact-section .contact-form textarea::placeholder{
color: #7F7F7F;
opacity:1;
}


/* SUCCESS */

.custom-contact-section .success-msg{
color:green;
margin-bottom:15px;
}


/* ICONS */

.custom-contact-section .info_icons{
width:24px;
}

.custom-contact-section .info_social_icons{
width:32px;
}

.custom-contact-section .social_icons_contact{
display:flex;
justify-content:center;
align-items:center;
gap:20px;
margin-top:20px;
}


/* MOBILE */

@media(max-width:900px){

.custom-contact-section .contact-form h3{
text-align:center;
}

.custom-contact-section .contact-info {
    margin-top: 0px;
}
.custom-contact-section{
padding:40px 14px 100px 14px;
}

.custom-contact-section .contact-grid{
grid-template-columns:1fr;
}

.custom-contact-section .contact-wrapper{
padding:14px;
}

}

</style>
