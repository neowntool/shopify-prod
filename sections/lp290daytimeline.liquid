{% schema %}
{
  "name": "(90 Day Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The 90-day reading journey"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "month",
          "label": "Month Label",
          "default": "MONTH 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "90 Day Timeline"
    }
  ]
}
{% endschema %}

<section class="rjt-section">
  <div class="rjt-wrapper">

    <h2 class="rjt-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="rjt-timeline">

      <div class="rjt-line"></div>

      {% for block in section.blocks %}
        <div class="rjt-step" {{ block.shopify_attributes }}>

          <div class="rjt-vertical-line"></div>

          <div class="rjt-number">
            {{ block.settings.number }}
          </div>

          <div class="rjt-month">
            {{ block.settings.month }}
          </div>

          <h3 class="rjt-title">
            {{ block.settings.title }}
          </h3>

          <div class="rjt-description">
            {{ block.settings.description }}
          </div>

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.rjt-section{
  padding:20px;
}

.rjt-wrapper{
  max-width:1400px;
  margin:0 auto;
  background: #FFE6F5;
  border-radius:20px;
  padding:32px 35px 35px;
}

.rjt-heading{
  text-align:center;
  margin:0 0 25px;
  color:#3e3e3e;
  font-size:42px;
  line-height:1.1;
  font-weight:700;
}

.rjt-timeline{
  position:relative;
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding-top:0px;
}

.rjt-line{
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:2px;
  background:#f766b2;
}

.rjt-step:nth-of-type(2) { 
  padding-top:150px !important;
}
.rjt-step:nth-of-type(2) .rjt-vertical-line {
  height:150px;
}

.rjt-step:nth-of-type(3) { 
  padding-top:90px !important;
}
.rjt-step:nth-of-type(3) .rjt-vertical-line {
  height:95px;
}

.rjt-step:nth-of-type(4) { 
  padding-top:150px !important;
}
.rjt-step:nth-of-type(4) .rjt-vertical-line {
  height:150px;
}

.rjt-line:before,
.rjt-line:after{
  content:'';
  position:absolute;
  width:8px;
  height:8px;
  background:#FF66BA;
  border-radius:50%;
  top:50%;
  transform:translateY(-50%);
}

.rjt-line:before{
  left:0;
}

.rjt-line:after{
  right:0;
}

.rjt-step{
  position:relative;
  flex:1;
  text-align:center;
  {% comment %} padding-top:70px; {% endcomment %}
}

.rjt-vertical-line{
  position:absolute;
  top:0;
  left:50%;
  transform:translateX(-50%);
  width:2px;
  background:#FF66BA;
}

.rjt-number{
  width:46px;
  height:46px;
  border-radius:50%;
  background:#FF66BA;
  color:#fff;
  font-size:24px;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 12px;
  position:relative;
  z-index:2;
}

.rjt-month{
  font-size:16px;
  color:#777;
  text-transform:uppercase;
  margin-bottom:8px;
}

.rjt-title{
  margin:0 0 10px;
  color:#333;
  font-size:20px;
  line-height:1.3;
  font-weight:700;
}

.rjt-description{
  color:#666;
  font-size:16px;
  line-height:1.5;
  max-width:auto;
  margin:0 auto;
}

/* Tablet */
@media(max-width:991px){

  .rjt-heading{
    font-size:42px;
  }

  .rjt-title{
    font-size:18px;
  }

  .rjt-description{
    font-size:14px;
  }
}

/* Mobile */
/* Timeline horizontal hi rahegi */
@media(max-width:767px){

  .rjt-section {
    padding: 0px 14px;
}

  .rjt-wrapper{
    padding:32px 15px 32px;
  }

  .rjt-heading{
    font-size:28px;
    margin-bottom:20px;
  }

  .rjt-timeline{
    gap:10px;
    padding-top:0px;
  }

  .rjt-step{
    padding-top:55px;
  }

  .rjt-vertical-line{
    height:75px;
  }

  .rjt-number{
    width:34px;
    height:34px;
    font-size:18px;
    margin-bottom:8px;
  }

  .rjt-month{
    font-size:11px;
  }

  .rjt-title{
    font-size:12px;
    margin-bottom:6px;
  }

  .rjt-description{
    font-size:11px;
    line-height:1.4;
    max-width:100%;
  }

  
.rjt-step:nth-of-type(2) { 
  padding-top:92px !important;
}
.rjt-step:nth-of-type(2) .rjt-vertical-line {
  height:92px;
}

.rjt-step:nth-of-type(3) { 
  padding-top:70px !important;
}
.rjt-step:nth-of-type(3) .rjt-vertical-line {
  height:75px;
}

.rjt-step:nth-of-type(4) { 
  padding-top:92px !important;
}
.rjt-step:nth-of-type(4) .rjt-vertical-line {
  height:92px;
}

}
</style>