<section
  class="rrs-wrapper"
  style="
    --bg-desktop: url({{ section.settings.bg_image | image_url }});
    --bg-mobile: url({{ section.settings.bg_image_mobile | image_url }});
  "
>
  <div class="rrs-container">

    <div class="rrs-stats">
      <div class="rrs-box rrs-box-yellow">
        <h3>{{ section.settings.stat1_value }}</h3>
        <p>{{ section.settings.stat1_text }}</p>
      </div>

      <div class="rrs-box rrs-box-pink">
        <h3>{{ section.settings.stat2_value }}</h3>
        <p>{{ section.settings.stat2_text }}</p>
      </div>

      <div class="rrs-box rrs-box-blue">
        <h3>{{ section.settings.stat3_value }}</h3>
        <p>{{ section.settings.stat3_text }}</p>
      </div>

      <div class="rrs-box rrs-box-purple">
        <h3>{{ section.settings.stat4_value }}</h3>
        <p>{{ section.settings.stat4_text }}</p>
      </div>
    </div>

    <div class="rrs-content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

  </div>
</section>
{% comment %} 
<style>
.rrs-wrapper {
  padding: 220px 20px;
  background-image: var(--bg-desktop);
  background-size: cover;
  background-position: center;
}

.rrs-container {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.rrs-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.rrs-box {
  padding: 24px;
  border-radius: 12px;
}

.rrs-box h3 {
  font-size: 36px;
  margin-bottom: 8px;
}

.rrs-box p {
  font-size: 14px;
  color: #333;
}

.rrs-box-yellow { background: #FAFFC8; border: 1px solid #A8B800; }
.rrs-box-pink   { background: #FFE6F5; border: 1px solid #FF1A96; }
.rrs-box-blue   { background: #CCFEFF; border: 1px solid #008FA1; }
.rrs-box-purple { background: #F0EBFF; border: 1px solid #7437FF; }

.rrs-box-yellow h3 { color: #A8B800; }
.rrs-box-pink h3   { color: #FF1A96; }
.rrs-box-blue h3   { color: #008FA1; }
.rrs-box-purple h3 { color: #7437FF; }

.rrs-content h2 {
  font-size: 38px;
  margin-bottom: 10px;
}

.rrs-content p {
  max-width: 420px;
  color: #444;
}




/* Mobile */
@media (max-width: 768px) {
  .rrs-wrapper {
    background-image: var(--bg-mobile);
    padding: 140px 20px;
  }

  .rrs-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .rrs-content p {
    margin: auto;
  }
}
</style> {% endcomment %}



<style>
.rrs-wrapper {
  padding: 220px 20px;
  background-image: var(--bg-desktop);
  background-size: cover;
  background-position: center;
}

.rrs-container {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

/* =======================
   LEFT STATS (FLEX BASED)
   ======================= */

.rrs-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

/* Base box */
.rrs-box {
  padding: 24px;
  border-radius: 12px;
  box-sizing: border-box;
}

/* ✅ USE FLEX ONLY (NO WIDTH) */
.rrs-stats .rrs-box:nth-child(1),
.rrs-stats .rrs-box:nth-child(4) {
  flex: 0 0 calc(45% - 10px);
}

.rrs-stats .rrs-box:nth-child(2),
.rrs-stats .rrs-box:nth-child(3) {
  flex: 0 0 calc(55% - 10px);
}

/* Typography */
.rrs-box h3 {
  font-size: 36px;
  margin-bottom: 8px;
}

.rrs-box p {
  font-size: 14px;
  color: #333;
}

/* Colors */
.rrs-box-yellow { background: #FAFFC8; border: 1px solid #A8B800; }
.rrs-box-pink   { background: #FFE6F5; border: 1px solid #FF1A96; }
.rrs-box-blue   { background: #CCFEFF; border: 1px solid #008FA1; }
.rrs-box-purple { background: #F0EBFF; border: 1px solid #7437FF; }

.rrs-box-yellow h3 { color: #A8B800; }
.rrs-box-pink h3   { color: #FF1A96; }
.rrs-box-blue h3   { color: #008FA1; }
.rrs-box-purple h3 { color: #7437FF; }

/* =======================
   RIGHT CONTENT
   ======================= */

.rrs-content h2 {
  font-size: 48px;
  margin-bottom: 10px;
}

.rrs-content p {
  max-width: 420px;
  color: #444;
}

/* =======================
   MOBILE FIX
   ======================= */

@media (max-width: 768px) {
  .rrs-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .rrs-content p {
    margin: auto;
  }
  .rrs-content h2 {
  font-size: 38px;
  }
}

</style>

{% schema %}
{
  "name": "Real Results Stats",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results From Real Families"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "See the difference when kids stay with us for 12 months."
    },
    {
      "type": "text",
      "id": "stat1_value",
      "label": "Stat 1 Value",
      "default": "85%"
    },
    {
      "type": "text",
      "id": "stat1_text",
      "label": "Stat 1 Text",
      "default": "Kids finish their books, while only 60% of new readers do."
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Stat 2 Value",
      "default": "60+"
    },
    {
      "type": "text",
      "id": "stat2_text",
      "label": "Stat 2 Text",
      "default": "Books read yearly, compared to just 2 for the average child."
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Stat 3 Value",
      "default": "90th"
    },
    {
      "type": "text",
      "id": "stat3_text",
      "label": "Stat 3 Text",
      "default": "Percentile scores for kids who read 20 minutes daily."
    },
    {
      "type": "text",
      "id": "stat4_value",
      "label": "Stat 4 Value",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "stat4_text",
      "label": "Stat 4 Text",
      "default": "Bigger vocabulary for daily readers than non-readers."
    }
  ],
  "presets": [
    {
      "name": "Real Results Stats"
    }
  ]
}
{% endschema %}
