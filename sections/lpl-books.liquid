{%- unless template.suffix contains 'lovable' -%}{%- render 'lpl-assets' -%}{%- endunless -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: 'top-books' | handleize
  assign title_id = anchor | append: '-title'
  assign use_collection = false
  if s.collection != blank and s.collection.products_count > 0
    assign use_collection = true
  endif
-%}
<div class="lpl">
<section id="{{ anchor }}" aria-labelledby="{{ anchor }}-title" class="mt-12 scroll-mt-24 md:mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div data-shown="false" class="reveal reveal-blur">
      {%- render 'lpl-heading', eyebrow: s.eyebrow, tone: s.tone, title: s.title, accent: s.accent, animate: s.animate, subtitle: s.subtitle, title_id: title_id -%}
    </div>
    <div class="group/shelf relative -mx-4 overflow-hidden py-4 sm:-mx-6 [mask-image:linear-gradient(90deg,transparent,black_6%,black_94%,transparent)]">
      <ul class="flex w-max gap-5 px-4 animate-[marquee_var(--shelf-speed)_linear_infinite] group-hover/shelf:[animation-play-state:paused] group-active/shelf:[animation-play-state:paused] md:gap-7" style="--shelf-speed:{{ s.speed }}s">
        {%- comment -%} The list is rendered twice so the marquee loops without a gap. {%- endcomment -%}
        {%- for pass in (1..2) -%}
          {%- if use_collection -%}
            {%- for product in s.collection.products limit: s.limit -%}
              {%- capture img -%}{{ product.featured_image | image_url: width: 400 }}{%- endcapture -%}
              {%- render 'lpl-book-card', title: product.title, img: img, url: product.url, tilt: forloop.index0, hidden: pass -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- liquid
                if block.settings.image != blank
                  assign img = block.settings.image | image_url: width: 400
                elsif block.settings.image_fallback != blank
                  assign img = block.settings.image_fallback | asset_url
                else
                  assign img = ''
                endif
              -%}
              {%- render 'lpl-book-card', title: block.settings.title, img: img, url: block.settings.link, tilt: forloop.index0, hidden: pass, attrs: block.shopify_attributes -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "LP: Book shelf",
  "tag": "div",
  "class": "section-lpl",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor (for #links)", "default": "top-books" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Popular now" },
    { "type": "select", "id": "tone", "label": "Eyebrow colour", "default": "lime", "options": [
      { "value": "pink", "label": "Pink" }, { "value": "violet", "label": "Violet" }, { "value": "cyan", "label": "Cyan" },
      { "value": "lime", "label": "Lime" }, { "value": "orange", "label": "Orange" }, { "value": "teal", "label": "Teal" }
    ] },
    { "type": "text", "id": "title", "label": "Heading", "default": "Popular children's books on the shelf now" },
    { "type": "checkbox", "id": "animate", "label": "Animate heading words", "default": false },
    { "type": "text", "id": "accent", "label": "Gradient words in heading" },
    { "type": "text", "id": "subtitle", "label": "Text under heading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional. When set, its products are shown instead of the book blocks below." },
    { "type": "range", "id": "limit", "label": "Products from collection", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds per loop)", "min": 15, "max": 120, "step": 5, "unit": "s", "default": 45 }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "Book",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Book title" },
        { "type": "image_picker", "id": "image", "label": "Cover" },
        { "type": "text", "id": "image_fallback", "label": "Cover from theme assets (used when no cover is picked)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "LP: Book shelf" }]
}
{% endschema %}
