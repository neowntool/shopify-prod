{%- render 'nyvc-styles' -%}
<div class="nyvc-root" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-pad nyvc-guides" aria-labelledby="nyvc-h-{{ section.id }}">
      <h2 class="nyvc-h2" id="nyvc-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <ul class="nyvc-guide-grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li {{ block.shopify_attributes }}>
            {%- if b.icon_image != blank -%}
              {{ b.icon_image | image_url: width: 80 | image_tag: alt: '', width: 40, height: 40 }}
            {%- else -%}
              <img src="{{ 'nyvc-g-' | append: b.icon | append: '.svg' | asset_url }}" alt="" width="40" height="40">
            {%- endif -%}
            <p>{%- if b.label != blank -%}<strong>{{ b.label | escape }}</strong> {% endif -%}{{ b.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: Guidelines",
  "tag": "div",
  "class": "section-nyvc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Video submission guidelines" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Guideline",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "duration", "options": [
          { "value": "duration", "label": "Timer" },
          { "value": "language", "label": "Language" },
          { "value": "format", "label": "Phone" },
          { "value": "filesize", "label": "Paper clip" },
          { "value": "book", "label": "Book" },
          { "value": "prompt", "label": "Megaphone" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon", "info": "40 x 40. Overrides the icon above." },
        { "type": "text", "id": "label", "label": "Label (bold)", "default": "Duration:" },
        { "type": "text", "id": "text", "label": "Text", "default": "Maximum two minutes." }
      ]
    }
  ],
  "presets": [{ "name": "NYVC: Guidelines", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
