{% schema %}
{
  "name": "Blog Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_desktop",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Mobile Background Image"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    }
  ],
  "presets": [
    {
      "name": "Blog Slider"
    }
  ]
}
{% endschema %}

<section class="blog-slider-section">
  <div class="page-width">
    <h2 class="section-title">Suggested for you</h2>

    <div class="blog-slider">
      {% for article in blogs[section.settings.blog].articles %}
        <div class="blog-card">
          <div class="blog-image">
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}">
          </div>

          <div class="blog-content">
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
            <a href="{{ article.url }}" class="read-more">Read More</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.blog-slider-section {
  padding: 160px 20px;
  background-image: url({{ section.settings.bg_desktop | image_url }});
  background-size: cover;
  background-position: center;
  margin: 20px 0px;
}
.blog-slider-section .page-width{
max-width: 1000px;
margin: auto;
}
/* Mobile background */
@media (max-width: 768px) {
  .blog-slider-section {
    background-image: url({{ section.settings.bg_mobile | image_url }});
  }
}

.section-title {
  margin-bottom: 20px;
  font-size: 22px;
  font-weight: 600;
}

/* Slider */
.blog-slider {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 10px;
}

.blog-slider::-webkit-scrollbar {
  display: none;
}

/* Card */
.blog-card {
  min-width: 300px;
  max-width: 300px;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  scroll-snap-align: start;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

.blog-image img {
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.blog-content {
  padding: 15px;
}

.blog-content h3 {
  font-size: 16px;
  margin-bottom: 10px;
}

.blog-content p {
  font-size: 14px;
  color: #555;
  margin-bottom: 15px;
}

.read-more {
  display: inline-block;
  padding: 8px 14px;
  background: #ff2b8a;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  font-size: 13px;
}

/* Desktop Grid */
@media (min-width: 1024px) {
  .blog-slider {
    overflow: hidden;
    flex-wrap: nowrap;
  }
}
</style>