{%- render 'nyvc-styles' -%}
{%- assign s = section.settings -%}
<div class="nyvc-root nyvc--last" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-about" aria-labelledby="nyvc-h-{{ section.id }}">
      <div class="nyvc-about-text">
        <h2 id="nyvc-h-{{ section.id }}">{{ s.heading | escape }}</h2>
        {{ s.body }}
      </div>
      {%- if s.cta_text != blank or s.button_label != blank -%}
        <div class="nyvc-final">
          {%- if s.cta_text != blank -%}<p>{{ s.cta_text }}</p>{%- endif -%}
          {%- if s.button_label != blank -%}<a class="nyvc-final-btn" href="{{ s.button_url | default: '#nyvc-register' }}">{{ s.button_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: About and final CTA",
  "tag": "div",
  "class": "section-nyvc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About neOwn" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "header", "content": "Final call to action" },
    { "type": "inline_richtext", "id": "cta_text", "label": "Text", "default": "Ready to participate? Register above and begin your Young Voices Championship journey." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Register here" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Blank scrolls to the Register section." }
  ],
  "presets": [{ "name": "NYVC: About and final CTA" }]
}
{% endschema %}
