{% schema %}
{
  "name": "Skill Growth Timeline",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Left Heading",
      "default": "Grow Every Skill, Every Day"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Left Subheading",
      "default": "Fun toys that boost thinking, coordination, creativity, and emotional growth"
    }
  ],
  "blocks": [
    {
      "type": "skill",
      "name": "Skill Block",
      "settings": [
        {
          "type": "color",
          "id": "dot_color",
          "label": "Dot & Connector Color",
          "default": "#00c2d1"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background",
          "default": "#e9fbff"
        },
        {
          "type": "color",
          "id": "card_border",
          "label": "Card Border Color",
          "default": "#00c2d1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cognitive Development"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Fun toys to boost your little one's brain"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skill Growth Timeline",
      "blocks": [
        { "type": "skill" },
        { "type": "skill" },
        { "type": "skill" },
        { "type": "skill" }
      ]
    }
  ]
}
{% endschema %}

<section class="neown-skill">
  <div class="neown-skill-bg">
    <div class="neown-skill-wrap">

      <!-- LEFT -->
      <div class="neown-skill-left">
        <h2 class="neown-skill-heading">{{ section.settings.heading }}</h2>
        <p class="neown-skill-subheading">{{ section.settings.subheading }}</p>
      </div>

      <!-- RIGHT -->
      <div class="neown-skill-right">

        <!-- Vertical Line -->
        <div class="neown-skill-vertical-line"></div>

        {% for block in section.blocks %}
          <div class="neown-skill-item" {{ block.shopify_attributes }}>

          

            <!-- Horizontal Connector -->
            <span
              class="neown-skill-connector"
              style="background: {{ block.settings.dot_color }}">
            </span>

              <!-- Dot -->
            <span
              class="neown-skill-dot"
              style="background: {{ block.settings.dot_color }}">
            </span>

            <!-- Card -->
            <div
              class="neown-skill-card"
              style="
                background: {{ block.settings.card_bg }};
                border-color: {{ block.settings.card_border }};
              ">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.desc }}</p>
            </div>

          </div>
        {% endfor %}

      </div>
    </div>
  </div>
</section>

<style>
.neown-skill {
  width: 100%;
}

.neown-skill-bg {
  background-image: url({{ section.settings.bg_desktop | image_url }});
  background-size: cover;
  background-position: center;
  padding: 160px 20px;
}

.neown-skill-wrap {
  max-width: 1320px;
  margin: auto;
  display: flex;
  gap: 80px;
  align-items: center;
}

/* LEFT */
.neown-skill-left {
  flex: 1;
}

.neown-skill-heading {
  font-size: 44px;
  font-weight: 700;
  margin-bottom: 12px;
}

.neown-skill-subheading {
  font-size: 15px;
  line-height: 1.6;
}

/* RIGHT */
.neown-skill-right {
  flex: 1;
  position: relative;
}

/* Vertical timeline */
.neown-skill-vertical-line {
  position: absolute;
  left: 7px;
  top: 0;
  bottom: 0;
  width: 10px;
  background: #b6cc00;
  border-radius: 10px;
}

/* Item */
.neown-skill-item {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 38px;
}

/* Dot */
.neown-skill-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  z-index: 2;
  margin-right: 10px;
}

/* Connector line */
.neown-skill-connector {
  width: 80px;
  height: 2px;
  margin: 0 0 0 8px;
}

/* Card */
.neown-skill-card {
  border: 2px solid;
  border-radius: 10px;
  padding: 16px 18px;
  max-width: 360px;
}

.neown-skill-card h4 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 6px;
}

.neown-skill-card p {
  font-size: 13px;
  line-height: 1.5;
}

/* MOBILE */
@media (max-width: 768px) {
  .neown-skill-bg {
    background-image: url({{ section.settings.bg_mobile | image_url }});
    padding: 130px 16px;
  }

  .neown-skill-wrap {
    flex-direction: column;
    gap: 50px;
  }

  .neown-skill-heading {
    font-size: 32px;
  }

  .neown-skill-card {
    max-width: 100%;
  }
}
</style>
