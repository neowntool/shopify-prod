<section class="prblm-sec">

  <div class="prblm-container">

    <h2 class="prblm-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="prblm-wrapper prblm-mobile-{{ section.settings.mobile_layout }}">

      {% for block in section.blocks %}
        <div class="prblm-card">

          <div class="prblm-icon-wrap">
            {% if block.settings.icon != blank %}
              {{
                block.settings.icon
                | image_url: width: 100
                | image_tag: class: 'prblm-icon'
              }}
            {% endif %}
          </div>

          <div class="prblm-text">
            {{ block.settings.text }}
          </div>

        </div>
      {% endfor %}

    </div>

  </div>

</section>

<style>
.prblm-sec{
  padding:40px 20px 0px 20px;
}

.prblm-container{
  max-width:1400px;
  margin:0 auto;
}

.prblm-heading{
  font-size:34px;
  font-weight:800;
  margin-bottom:30px;
  color:#111;
}

/* DESKTOP */
.prblm-wrapper{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.prblm-card{
  background: #D8EAFF;
  border-radius:12px;
  padding:20px;
  min-height:150px;
  position:relative;
}

.prblm-icon-wrap{
  width:50px;
  height:50px;
  background:#fff;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:15px;
}

.prblm-icon{
  width:24px;
  height:24px;
  object-fit:contain;
}

.prblm-text{
  font-size:16px;
  color:#000000;
  line-height:1.4;
  font-weight: 600;
}

/* MOBILE GRID */
@media(max-width:768px){
.prblm-sec{
  padding:30px 10px 0px 10px;
}

  .prblm-mobile-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
  }

  .prblm-mobile-scroll{
    display:flex;
    overflow-x:auto;
    gap:12px;
  }

  .prblm-mobile-scroll .prblm-card{
    flex:0 0 75%;
  }

  .prblm-heading{
    font-size:28px;
  }

  .prblm-text{
    font-size:14px;
  }

}
</style>

{% schema %}
{
  "name": "Problem Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Problem"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid (2 columns)"
        },
        {
          "value": "scroll",
          "label": "Horizontal Scroll"
        }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Problem Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add your problem text here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem Section",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}