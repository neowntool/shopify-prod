{% comment %}
  Smart Parenting Custom Section
  Desktop + Mobile Background Image Support
{% endcomment %}

<section
  class="spc-wrapper"
  style="
    {% if section.settings.bg_image != blank %}
      --bg-desktop: url({{ section.settings.bg_image | image_url: width: 2000 }});
    {% endif %}
    {% if section.settings.bg_image_mobile != blank %}
      --bg-mobile: url({{ section.settings.bg_image_mobile | image_url: width: 1200 }});
    {% endif %}
  "
>
  <div class="spc-container {% if section.settings.image_position == 'left' %}spc-reverse{% endif %}">

    <!-- LEFT CONTENT -->
    <div class="spc-content">
      {% if section.settings.sku != blank %}
        <div class="spc-sku">
          <strong>SKU:</strong> {{ section.settings.sku }}
        </div>
      {% endif %}

      <div class="spc-liquid-content">
        {{ section.settings.left_liquid }}
      </div>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="spc-image">
      {% if section.settings.right_image != blank %}
        <img
          src="{{ section.settings.right_image | image_url: width: 1000 }}"
          alt="Section Image"
          loading="lazy"
        >
      {% else %}
        <div class="spc-image-placeholder">
          Upload Image
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
/* ===========================
   SMART PARENTING CUSTOM CSS
   =========================== */

.spc-wrapper {
  width: 100%;
  padding: 180px 20px;
  background-image: var(--bg-desktop);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.spc-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 40px;
}

.spc-container.spc-reverse {
  flex-direction: row-reverse;
}

.spc-content {
  flex: 1;
  padding: 40px;
  border-radius: 16px;
}

.spc-sku {
  font-size: 14px;
  margin-bottom: 16px;
  color: #444;
}

.spc-liquid-content {
  font-size: 16px;
  line-height: 1.6;
}

.spc-image {
  flex: 1;
  text-align: center;
}

.spc-image img {
  max-width: 100%;
  border-radius: 20px;
}

.spc-image-placeholder {
  width: 100%;
  height: 350px;
  background: #f2f2f2;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
}

/* Responsive */
@media (max-width: 768px) {
  .spc-wrapper {
    background-image: var(--bg-mobile);
    padding: 220px 20px;
  }

  .spc-container,
  .spc-container.spc-reverse {
    flex-direction: column;
  }

  .spc-content {
    padding: 10px;
  }

.np-footer {
    flex-direction: column;
    gap: 10px;
}

}


{% comment %}  {% endcomment %}
.np-wrapper {
  display: flex;
  justify-content: center;
  padding: 0px;
}

.np-card {
  max-width: 420px;
}

.np-title {
  font-size: 32px;
  font-weight: 800;
  margin-bottom: 10px;
}

.np-subtitle {
  font-size: 14px;
  margin-bottom: 24px;
}

.np-feature {
  position: relative;
  padding-left: 0px;
  margin-bottom: 22px;
}

.np-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  position: absolute;
  left: 100;
  top: -5px;
right: 0;
}

.np-line {
  height: 2px;
  width: 100%;
  margin-bottom: 8px;
}

.np-feature h3 {
  margin: 6px 0 4px;
  font-size: 16px;
}

.np-feature p {
  font-size: 13px;
  margin: 0;
}

.np-pink { background: #FF1A96; }
.np-pink-line { background: #FF1A96; }

.np-yellow { background: #94A100; }
.np-yellow-line { background: #94A100; }

.np-purple { background: #7b4bff; }
.np-purple-line { background: #7b4bff; }

.np-blue { background: #28d7ff; }
.np-blue-line { background: #28d7ff; }

.np-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24px;
}

.np-buttons img {
  height: 38px;
  margin-right: 8px;
}

.np-buttons{
display: flex;
}
.np-qr img {
  width: 110px;
  height: 110px;
}
@media (max-width: 768px) {
  .spc-container {
    display: flex;
    flex-direction: column;
  }

  .spc-image {
    order: -1; /* Image ko upar laayega */
    text-align: center;
    margin-bottom: 20px;
  }

  .spc-image img {
    width: 100%;
    max-width: 350px;
  }
.np-qr{
display: none;
}
}


{% comment %} np-2 {% endcomment %}

.np2-wrapper {
  display: flex;
  justify-content: center;
  padding: 20px;
}

.np2-card {
  max-width: 420px;
}

.np2-title {
  font-size: 52px;
  font-weight: 900;
  line-height: 1.05;
  margin-bottom: 14px;
}

.np2-desc {
  font-size: 14px;
  margin-bottom: 20px;
}

.np2-cta {
  display: flex;
  gap: 12px;
  margin-bottom: 22px;
}

.np2-btn {
  padding: 10px 18px;
  font-size: 14px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
width: 100%;
    text-align: center;
}
.np2-store-btns{
display: flex;
}
.np2-btn-primary {
  background: #FF1A96;
  color: #fff;
}

.np2-btn-outline {
  border: 0px solid #FF1A96;
  color: #FF1A96;
}

.np2-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.np2-store p {
  font-size: 13px;
  margin-bottom: 6px;
}

.np2-store-btns img {
  height: 34px;
  margin-right: 6px;
}

.np2-or {
  font-size: 14px;
  font-weight: bold;
}

.np2-qr img {
  width: 110px;
  height: 110px;
}
@media(max-width: 767px){
.np2-wrapper{
padding: 0px;
}
.np2-footer{
{% comment %} display: none; {% endcomment %}
}
.np2-title{
text-align: left;
}
}

</style>

{% schema %}
{
  "name": "Smart Parenting Custom",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "sku",
      "label": "Product SKU"
    },
    {
      "type": "liquid",
      "id": "left_liquid",
      "label": "Left Content (Liquid / HTML)",
      "default": "<h2>Smart Parenting Starts Here</h2><p>Add your content here.</p>"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Side Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smart Parenting Custom"
    }
  ]
}
{% endschema %}
