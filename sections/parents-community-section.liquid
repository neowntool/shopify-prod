{% comment %}
  Parents Community CTA Section
  Desktop + Mobile Background Image Support
{% endcomment %}

<section
  class="pcs-wrapper"
  style="
    {% if section.settings.bg_image != blank %}
      --bg-desktop: url({{ section.settings.bg_image | image_url: width: 2000 }});
    {% endif %}
    {% if section.settings.bg_image_mobile != blank %}
      --bg-mobile: url({{ section.settings.bg_image_mobile | image_url: width: 1200 }});
    {% endif %}
  "
>
  <div class="pcs-container">

    <!-- LEFT SIDE -->
    <div class="pcs-left">
      {% for block in section.blocks %}
        <div class="pcs-line-item">
          <span class="pcs-dot"></span>
          <span class="pcs-text"><b>{{ block.settings.text }}</b> <br>{{ block.settings.text_desc }} </span>
          
        </div>
      {% endfor %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="pcs-btn">
          <img
            src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/logos_whatsapp-icon.png?v=1769157724"
            style="padding-right:10px;"
          />
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <!-- RIGHT SIDE -->
    <div class="pcs-right">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

  </div>
</section>

<style>
/* ================================
   PARENTS COMMUNITY SECTION (PCS)
   ================================ */

.pcs-wrapper {
  padding: 220px 20px;
  background-image: var(--bg-desktop);
  background-size: cover;
  background-position: center;
}

.pcs-container {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px;
}

.pcs-left {
  flex: 1;
}

.pcs-line-item {
  display: flex;
  margin-bottom: 24px;
  position: relative;
}

.pcs-dot {
  width: 10px;
  height: 10px;
  background: #ff3fa4;
  border-radius: 50%;
  margin-right: 16px;
  flex-shrink: 0;
  margin-top: -5px;
}

.pcs-line-item::after {
  content: "";
  position: absolute;
  left: 5px;
  top: 0%;
  width: 100%;
  height: 2px;
  background: rgba(255, 63, 164, 0.3);
  z-index: 1;
}

.pcs-text {
  font-size: 15px;
  color: #333;
  padding-top: 10px;
}

.pcs-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 30px;
  padding: 12px 22px;
  background: #6b3cff;
  color: #fff;
  border-radius: 8px;
  font-size: 14px;
  text-decoration: none;
  transition: 0.3s ease;
}

.pcs-btn:hover {
  background: #5630d9;
}

.pcs-right {
  flex: 1;
}

.pcs-right h2 {
  font-size: 50px;
  font-weight: 700;
  margin-bottom: 12px;
}

.pcs-right p {
  font-size: 16px;
  opacity: 0.8;
}

/* Mobile */
@media (max-width: 900px) {
  .pcs-right h2 {
  font-size: 38px;
  }
  .pcs-wrapper {
    background-image: var(--bg-mobile);
    padding: 160px 20px;
  }

  .pcs-container {
    flex-direction: column-reverse;
    text-align: center;
    align-items: flex-start;
  }

  .pcs-text {
    text-align: left;
}
  .pcs-left {
    margin-top: 0;
  }
}
</style>

{% schema %}
{
  "name": "Parents Community CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Right Heading",
      "default": "Join the neOwn Parent's Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Right Subheading",
      "default": "Get Book Recommendations & Expert Advice"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join WhatsApp Community"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Left Line Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Line Text",
          "default": "6,000+ Active Parents"
        },
        {
          "type": "richtext",
          "id": "text_desc",
          "label": "Line Desc."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parents Community CTA",
      "blocks": [
        { "type": "line" },
        { "type": "line" },
        { "type": "line" },
        { "type": "line" }
      ]
    }
  ]
}
{% endschema %}
