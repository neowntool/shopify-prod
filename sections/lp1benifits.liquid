<section class="velora-benefits-section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="velora-benefits-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="velora-benefits-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div class="velora-benefits-grid">

      {% for block in section.blocks %}
        <div class="velora-benefits-card" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div class="velora-benefits-icon">
              <img
                src="{{ block.settings.icon | image_url: width: 100 }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="velora-benefits-title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="velora-benefits-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>

.velora-benefits-section{
  padding:30px 0;
  max-width: 1400px;
  margin: auto;
}

.velora-benefits-heading{
  text-align:center;
 font-size: calc(((var(--font-h3-desktop)) / (var(--font-base-size))) * 1rem);
        line-height: 1.278;
  font-weight:700;
  margin:0;
}

.velora-benefits-subheading{
  text-align:center;
  color:#7d7d7d;
  font-size:18px;
  margin-top:12px;
  margin-bottom:45px;
}

.velora-benefits-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  padding: 0px 252px;
}

.velora-benefits-card{
  background:#FDFFE5;
  border:1px solid #BCCF00;
  border-radius:10px;
  padding:14px;
  transition:.3s;
}

.velora-benefits-card:hover{
  transform:translateY(-3px);
}

.velora-benefits-icon{
  margin-bottom:15px;
}

.velora-benefits-icon img{
  width:38px;
  height:38px;
  object-fit:contain;
  display:block;
}

.velora-benefits-title{
  font-size:18px;
  font-weight:600;
  margin:0 0 12px;
  line-height:1.3;
}

.velora-benefits-description{
  font-size:14px;
  color:#555;
  line-height:1.6;
}

@media screen and (max-width: 990px){

  .velora-benefits-section{
    padding-top: 0px;
  }

  .velora-benefits-grid{
    grid-template-columns:repeat(2,1fr);
    padding: 0px 10px;
  }

  .velora-benefits-heading{
    font-size:40px;
  }

}

@media screen and (max-width: 749px){

  .velora-benefits-grid{
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }

  .velora-benefits-heading{
    font-size:30px;
  }

  .velora-benefits-subheading{
    font-size:14px;
    margin-bottom:25px;
    padding: 0px 40px;
  }

  .velora-benefits-card{
    padding:14px;
  }

  .velora-benefits-icon img{
    width:30px;
    height:30px;
  }

  .velora-benefits-title{
    font-size:16px;
    margin-bottom:8px;
  }

  .velora-benefits-description{
    font-size:13px;
    line-height:1.5;
  }

}

</style>

{% schema %}
{
  "name": "Subscription Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything in Your Subscription"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Not just books — a complete reading ecosystem built for habit formation."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "5 Books Every Month"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hand-curated, age-appropriate books delivered monthly automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription Benefits"
    }
  ]
}
{% endschema %}