<section class="jrfaq-section">
  <div class="jrfaq-container">

    <div class="jrfaq-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="jrfaq-grid">

      {% for block in section.blocks %}
        <div class="jrfaq-card" {{ block.shopify_attributes }}>

          <div class="jrfaq-title-wrap">
            <span class="jrfaq-icon">?</span>
            <h3>{{ block.settings.question }}</h3>
          </div>

          <div class="jrfaq-content">
            {{ block.settings.answer }}
          </div>

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.jrfaq-section{
  padding:30px 20px;
  background:#ffffff;
}

.jrfaq-container{
  max-width:1400px;
  margin:auto;
}

.jrfaq-header{
  text-align:center;
  margin-bottom:35px;
}

.jrfaq-header h2{
  font-size: calc(((var(--font-h3-desktop)) / (var(--font-base-size))) * 1rem);
        line-height: 1.278;
  font-weight:800;
  margin:0 0 10px;
  color:#333;
}

.jrfaq-header p{
  margin:0;
  color:#777;
  font-size:16px;
}

.jrfaq-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.jrfaq-card{
  border:1px solid #ddd1ff;
  border-radius:6px;
  padding:18px;
  background:#fff;
}

.jrfaq-title-wrap{
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-bottom:8px;
}

.jrfaq-icon{
  color:#A37AFF;
  font-size:26px;
  font-weight:700;
  line-height:1;
  flex-shrink:0;
}

.jrfaq-title-wrap h3{
  margin:0;
  font-size:18px;
  font-weight:600;
  color:#2B2B2B;
}

.jrfaq-content{
  padding-left:24px;
  color:#666;
  font-size:15px;
  line-height:1.6;
}

.jrfaq-content p{
  margin:0 0 8px;
}

.jrfaq-content ul{
  margin:8px 0;
  padding-left:18px;
}

.jrfaq-content li{
  margin-bottom:4px;
}

@media(max-width:768px){

  .jrfaq-grid{
    grid-template-columns:1fr;
  }

  .jrfaq-header h2{
    font-size:34px;
  }

  .jrfaq-title-wrap h3{
    font-size:16px;
  }

  .jrfaq-content{
    padding-left:0;
    margin-top:10px;
  }
}
</style>

{% schema %}
{
  "name": "JR FAQ Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still Have Questions?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Most parents ask these before subscribing. Here are the answers."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JR FAQ Grid"
    }
  ]
}
{% endschema %}