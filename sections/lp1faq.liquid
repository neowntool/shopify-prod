<section class="jrfaq-section{% if section.settings.style == 'compact' %} jrfaq-section--compact{% endif %}">
  <div class="jrfaq-container">

    <div class="jrfaq-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="jrfaq-grid">

      {% for block in section.blocks %}
        <div class="jrfaq-card" {{ block.shopify_attributes }}>

          <div class="jrfaq-title-wrap">
            <span class="jrfaq-icon">?</span>
            <h3>{{ block.settings.question }}</h3>
          </div>

          <div class="jrfaq-content">
            {{ block.settings.answer }}
          </div>

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.jrfaq-section{
  padding:30px 20px;
  background:#ffffff;
}

.jrfaq-container{
  max-width:1400px;
  margin:auto;
}

.jrfaq-header{
  text-align:center;
  margin-bottom:35px;
}

.jrfaq-header h2{
  font-size: calc(((var(--font-h3-desktop)) / (var(--font-base-size))) * 1rem);
        line-height: 1.278;
  font-weight:800;
  margin:0 0 10px;
  color:#333;
}

.jrfaq-header p{
  margin:0;
  color:#777;
  font-size:16px;
}

.jrfaq-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.jrfaq-card{
  border:1px solid #ddd1ff;
  border-radius:6px;
  padding:18px;
  background:#fff;
}

.jrfaq-title-wrap{
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-bottom:8px;
}

.jrfaq-icon{
  color:#A37AFF;
  font-size:26px;
  font-weight:700;
  line-height:1;
  flex-shrink:0;
}

.jrfaq-title-wrap h3{
  margin:0;
  font-size:18px;
  font-weight:600;
  color:#2B2B2B;
}

.jrfaq-content{
  padding-left:24px;
  color:#666;
  font-size:15px;
  line-height:1.6;
}

.jrfaq-content p{
  margin:0 0 8px;
}

.jrfaq-content ul{
  margin:8px 0;
  padding-left:18px;
}

.jrfaq-content li{
  margin-bottom:4px;
}

@media(max-width:768px){

  .jrfaq-grid{
    grid-template-columns:1fr;
  }

  .jrfaq-header h2{
    font-size:34px;
  }

  .jrfaq-title-wrap h3{
    font-size:16px;
  }

  .jrfaq-content{
    padding-left:0;
    margin-top:10px;
  }
}
/* Compact style (used on the NYVC page): left heading, smaller text, matches the NYVC design */
.jrfaq-section--compact{ padding:24px 40px; font-family:'Geologica',sans-serif; }
.jrfaq-section--compact .jrfaq-container{ max-width:1312px; }
.jrfaq-section--compact .jrfaq-header{ text-align:left; margin-bottom:24px; }
.jrfaq-section--compact .jrfaq-header h2{ font-family:inherit; font-size:28px; line-height:1.25; font-weight:700; color:#1a192f; margin:0 0 4px; letter-spacing:0; text-transform:none; }
.jrfaq-section--compact .jrfaq-header p{ font-size:16px; line-height:1.25; color:#6a6a6a; }
.jrfaq-section--compact .jrfaq-header p:empty{ display:none; }
.jrfaq-section--compact .jrfaq-grid{ grid-template-columns:repeat(2,minmax(0,650px)); gap:12px; }
.jrfaq-section--compact .jrfaq-card{ border:.4px solid #795ff5; border-radius:8px; padding:12px; min-height:78px; }
.jrfaq-section--compact .jrfaq-title-wrap{ gap:12px; margin-bottom:5px; align-items:flex-start; }
.jrfaq-section--compact .jrfaq-icon{ width:17px; font-family:inherit; font-size:26px; font-weight:800; color:#6730ef; text-align:center; }
.jrfaq-section--compact .jrfaq-title-wrap h3{ font-family:inherit; font-size:14px; line-height:1.25; font-weight:700; color:#404040; letter-spacing:0; text-transform:none; padding-top:4px; }
.jrfaq-section--compact .jrfaq-content{ padding-left:29px; margin-top:-6px; font-size:12px; line-height:1.25; color:#6a6a6a; }
.jrfaq-section--compact .jrfaq-content p{ margin:0; }
.jrfaq-section--compact .jrfaq-content strong{ color:#404040; }
@media(max-width:1199px){ .jrfaq-section--compact{ padding-left:24px; padding-right:24px; } .jrfaq-section--compact .jrfaq-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:767px){
  .jrfaq-section--compact{ padding:20px 16px; }
  .jrfaq-section--compact .jrfaq-header h2{ font-size:24px; }
  .jrfaq-section--compact .jrfaq-grid{ grid-template-columns:1fr; }
  .jrfaq-section--compact .jrfaq-card{ min-height:0; }
  .jrfaq-section--compact .jrfaq-title-wrap h3{ font-size:14px; }
  .jrfaq-section--compact .jrfaq-content{ padding-left:29px; margin-top:-6px; }
}
</style>

{% schema %}
{
  "name": "JR FAQ Grid",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "standard",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact (left heading, smaller text)" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still Have Questions?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Most parents ask these before subscribing. Here are the answers."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JR FAQ Grid"
    }
  ]
}
{% endschema %}