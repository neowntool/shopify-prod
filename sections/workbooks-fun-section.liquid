<section
  class="workbooks-fun"
  style="
    --bg-desktop: url({{ section.settings.bg_image | image_url }});
    --bg-mobile: url({{ section.settings.bg_image_mobile | image_url }});
  "
>
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p class="subtitle">{{ section.settings.subheading }}</p>

    <div class="cards">
      <div class="card card-blue">
        <div class="icon">
          <img
            src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/Worbook_by_grade.png?v=1768981349"
            class="workbook-fun-icon"
            alt="Workbook by Grade"
          />
        </div>
        <h3>{{ section.settings.card1_title }}</h3>
        <p>{{ section.settings.card1_text }}</p>
        <a href="{{ section.settings.card1_link }}" class="arrow">→</a>
      </div>

      <div class="card card-purple">
        <div class="icon">
          <img
            src="https://cdn.shopify.com/s/files/1/0687/8557/0066/files/Workbook_by_subject.png?v=1768981349"
            class="workbook-fun-icon"
            alt="Workbook by Subject"
          />
        </div>
        <h3>{{ section.settings.card2_title }}</h3>
        <p>{{ section.settings.card2_text }}</p>
        <a href="{{ section.settings.card2_link }}" class="arrow">→</a>
      </div>
    </div>
  </div>
</section>

<style>
.workbook-fun-icon {
  width: 56px;
  margin: auto;
  display: block;
}

.workbooks-fun {
  padding: 120px 20px;
  background-image: var(--bg-desktop);
  background-size: cover;
  background-position: center;
}

.workbooks-fun .container {
  max-width: 1100px;
  margin: auto;
  text-align: center;
  padding: 40px 0;
}

.workbooks-fun h2 {
  font-size: 36px;
  font-weight: 700;
}

.subtitle {
  max-width: 700px;
  margin: 10px auto 50px;
  color: #444;
}

.cards {
  display: flex;
  gap: 30px;
  justify-content: center;
  flex-wrap: wrap;
}

.card {
  width: 300px;
  padding: 30px;
  border-radius: 16px;
  text-align: center;
}

.card-blue {
  background: #ccfeff;
}

.card-purple {
  background: #e0d4ff;
}

.card h3 {
  margin-top: 15px;
  font-size: 20px;
}

.card p {
  font-size: 14px;
  color: #444;
}

.arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 15px;
  font-size: 22px;
  text-decoration: none;
}

.card-blue .arrow {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #00bccf;
  color: #fff;
}

.card-purple .arrow {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #9364ff;
  color: #fff;
}

/* Mobile */
@media (max-width: 767px) {
  .workbooks-fun {
    background-image: var(--bg-mobile);
    padding: 80px 20px;
  }

  .cards {
    flex-wrap: nowrap;
  }

  .card {
    width: 50%;
    padding: 16px 20px;
  }
}
</style>

{% schema %}
{
  "name": "Workbooks Fun Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Workbooks that Make Learning Fun"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Engaging workbooks for Grades 1–3—build strong skills in math, language & science."
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Card 1 Title",
      "default": "By Grade"
    },
    {
      "type": "text",
      "id": "card1_text",
      "label": "Card 1 Text",
      "default": "Tailored for Grades 1, 2 & 3"
    },
    {
      "type": "url",
      "id": "card1_link",
      "label": "Card 1 Link"
    },
    {
      "type": "text",
      "id": "card2_title",
      "label": "Card 2 Title",
      "default": "By Subject"
    },
    {
      "type": "text",
      "id": "card2_text",
      "label": "Card 2 Text",
      "default": "Math, Brain Booster, English"
    },
    {
      "type": "url",
      "id": "card2_link",
      "label": "Card 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Workbooks Fun Section"
    }
  ]
}
{% endschema %}

