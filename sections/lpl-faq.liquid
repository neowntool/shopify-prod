{%- unless template.suffix contains 'lovable' -%}{%- render 'lpl-assets' -%}{%- endunless -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: 'faq' | handleize
  assign title_id = anchor | append: '-title'
  assign bars = 'pink,violet,cyan,lime,orange,teal' | split: ','
-%}
<div class="lpl">
<section id="{{ anchor }}" aria-labelledby="{{ title_id }}" class="scroll-mt-24" data-lpl-faq>
  <div class="mx-auto px-4 sm:px-6 mt-20 max-w-3xl md:mt-28">
    <div data-shown="false" class="reveal reveal-blur">
      {%- render 'lpl-heading', eyebrow: s.eyebrow, tone: s.tone, title: s.title, accent: s.accent, animate: s.animate, subtitle: s.subtitle, title_id: title_id -%}
    </div>
    <div class="space-y-3">
      {%- for block in section.blocks -%}
        {%- assign bar = forloop.index0 | modulo: 6 -%}
        {%- assign qid = section.id | append: '-q' | append: forloop.index -%}
        <div data-state="closed" class="border-b relative overflow-hidden rounded-2xl sticker bg-card px-5 last:border-b" {{ block.shopify_attributes }}>
          <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-ink-{{ bars[bar] }}"></span>
          <h3 class="flex">
            <button type="button" aria-expanded="false" aria-controls="{{ qid }}-a" id="{{ qid }}" data-lpl-faq-q class="flex flex-1 items-center justify-between cursor-pointer transition-all py-5 text-left font-heading text-base font-medium hover:no-underline md:text-lg">{{ block.settings.question | escape }}{% render 'lpl-icon', name: 'chevron-down', class: 'h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 lpl-faq-chev' %}</button>
          </h3>
          <div id="{{ qid }}-a" role="region" aria-labelledby="{{ qid }}" hidden class="overflow-hidden text-sm">
            <div class="lpl-rte pb-5 leading-relaxed text-muted-foreground md:text-base">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.link_label != blank -%}
      <div class="mt-8 text-center"><a href="{{ s.link_url }}" target="_blank" rel="noreferrer" class="group inline-flex items-center font-semibold text-primary">{{ s.link_label | escape }} {% render 'lpl-icon', name: 'chevron-right', class: 'size-4 transition group-hover:translate-x-0.5' %}</a></div>
    {%- endif -%}
  </div>
</section>
{%- if s.schema_faq and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
  </script>
{%- endif -%}
</div>

{% schema %}
{
  "name": "LP: FAQ",
  "tag": "div",
  "class": "section-lpl",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor (for #links)", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "select", "id": "tone", "label": "Eyebrow colour", "default": "pink", "options": [
      { "value": "pink", "label": "Pink" }, { "value": "violet", "label": "Violet" }, { "value": "cyan", "label": "Cyan" },
      { "value": "lime", "label": "Lime" }, { "value": "orange", "label": "Orange" }, { "value": "teal", "label": "Teal" }
    ] },
    { "type": "text", "id": "title", "label": "Heading", "default": "Kids book subscription FAQs" },
    { "type": "checkbox", "id": "animate", "label": "Animate heading words", "default": false },
    { "type": "text", "id": "accent", "label": "Gradient words in heading" },
    { "type": "text", "id": "subtitle", "label": "Text under heading" },
    { "type": "text", "id": "link_label", "label": "Link under the questions", "default": "Still have a question? WhatsApp a book expert" },
    { "type": "text", "id": "link_url", "label": "Link URL", "default": "https://wa.me/919324455972" },
    { "type": "checkbox", "id": "schema_faq", "label": "Add FAQ structured data for Google", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [{ "name": "LP: FAQ" }]
}
{% endschema %}
