{% comment %}
  Custom Section: Neown Split Content
  Left Content + Right Image
{% endcomment %}

<section class="neown-split-section">

  <div class="neown-split-bg desktop-bg"
    style="background-image:url('{{ section.settings.bg_image_desktop | img_url: 'master' }}');">
  </div>

  <div class="neown-split-bg mobile-bg"
    style="background-image:url('{{ section.settings.bg_image_mobile | img_url: 'master' }}');">
  </div>

  <div class="neown-split-container">

    {% if section.settings.top_heading_html != blank %}
      <div class="neown-top-heading">
        {{ section.settings.top_heading_html }}
      </div>
    {% endif %}

    <div class="neown-split-grid">

      <div class="neown-left-content">
        {{ section.settings.left_content_html }}
      </div>

      <div class="neown-right-image">
        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | img_url: '900x' }}"
            alt="{{ section.settings.right_image.alt }}"
            loading="lazy">
        {% endif %}
      </div>

    </div>

  </div>

</section>

<style>

.neown-split-section{
  position:relative;
  padding:120px 0px;
  overflow:hidden;
  width: 100%;
}

.neown-split-bg{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background-size:cover;
  background-position:center;
  z-index:-1;
}

.mobile-bg{
  display:none;
}

.neown-split-container{
  max-width:1200px;
  margin:auto;
}

.neown-top-heading{
  text-align:center;
  margin-bottom:60px;
}

.neown-top-heading h2{
  font-size:42px;
  margin-bottom:10px;
}

.neown-split-grid{
  display:flex;
  align-items:center;
  gap:60px;
}

.neown-left-content{
  flex:1;
  font-size:16px;
  line-height:1.7;
}

.neown-right-image{
  flex:1;
}

.neown-right-image img{
  width:100%;
  border-radius:14px;
  display:block;
}

/* Tablet */
@media(max-width:991px){

.neown-split-grid{
  gap:20px;
}

}

/* Mobile */

@media(max-width:768px){

.desktop-bg{
  display:none;
}

.mobile-bg{
  display:block;
}

.neown-split-section{
  padding: 140px 15px;
}

.neown-top-heading h2{
  font-size:28px;
}

.neown-split-grid{
  flex-direction:column;
  text-align:center;
}

}

</style>

{% schema %}
{
  "name": "Neown Split Section",
  "settings": [

    {
      "type":"image_picker",
      "id":"bg_image_desktop",
      "label":"Background Image Desktop"
    },

    {
      "type":"image_picker",
      "id":"bg_image_mobile",
      "label":"Background Image Mobile"
    },

    {
      "type":"html",
      "id":"top_heading_html",
      "label":"Top Heading HTML",
      "default":"<h2>As Seen On National TV</h2>"
    },

    {
      "type":"html",
      "id":"left_content_html",
      "label":"Left Content HTML",
      "default":"<p>Add your content here</p>"
    },

    {
      "type":"image_picker",
      "id":"right_image",
      "label":"Right Image"
    }

  ],
  "presets":[
    {
      "name":"Neown Split Section",
      "category":"Custom"
    }
  ]
}
{% endschema %}