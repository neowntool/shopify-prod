{%- render 'nyvc-styles' -%}
<div class="nyvc-root" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-cta2" id="{{ section.settings.anchor | default: 'nyvc-register' | handleize }}" aria-label="{{ section.settings.aria_label | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="nyvc-cta2-col" {{ block.shopify_attributes }}>
          <h2 class="nyvc-cta2-h">{{ b.heading | escape }}</h2>
          {%- if b.subheading != blank -%}<p class="nyvc-cta2-sub">{{ b.subheading | escape }}</p>{%- endif -%}
          {%- if b.note != blank -%}<p class="nyvc-cta2-note">{{ b.note }}</p>{%- endif -%}
          {%- if b.button_label != blank -%}
            <a class="nyvc-btn nyvc-btn--big nyvc-btn--{% if b.style == 'pink' %}pink{% else %}primary{% endif %}" href="{% if b.button_action == 'form' %}#nyvc-form{% elsif b.button_action == 'upload' %}#nyvc-upload{% else %}{{ b.button_url | default: '#nyvc-register' }}{% endif %}">
              <img class="nyvc-btn-ic" src="{% if b.icon == 'video' %}{{ 'nyvc-ic-video-white.svg' | asset_url }}{% else %}{{ 'nyvc-ic-doc-white.svg' | asset_url }}{% endif %}" alt="" aria-hidden="true">
              <span>{{ b.button_label | escape }}</span>
              <img class="nyvc-btn-arrow" src="{{ 'nyvc-ic-arrow-white.svg' | asset_url }}" alt="" aria-hidden="true">
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: Register / Submit",
  "tag": "div",
  "class": "section-nyvc",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor", "default": "nyvc-register", "info": "Buttons with no link scroll here (#nyvc-register)." },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Register or submit your video" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Register Your Child" },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "inline_richtext", "id": "note", "label": "Small note" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Register Now" },
        { "type": "select", "id": "button_action", "label": "Button opens", "default": "link", "options": [
          { "value": "form", "label": "Registration form" },
          { "value": "upload", "label": "Video upload" },
          { "value": "link", "label": "Link below" }
        ] },
        { "type": "url", "id": "button_url", "label": "Button link" },
        { "type": "select", "id": "style", "label": "Button colour", "default": "purple", "options": [
          { "value": "purple", "label": "Purple" },
          { "value": "pink", "label": "Pink" }
        ] },
        { "type": "select", "id": "icon", "label": "Button icon", "default": "form", "options": [
          { "value": "form", "label": "Form" },
          { "value": "video", "label": "Video" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "NYVC: Register / Submit", "blocks": [{ "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
