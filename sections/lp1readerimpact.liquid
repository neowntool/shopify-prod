<section class="jr-reader-impact">
  <div class="jr-reader-impact__container">

    <div class="jr-reader-impact__header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="jr-reader-impact__grid">

      {% for block in section.blocks %}
        <div class="jr-reader-impact__card" {{ block.shopify_attributes }}>
          <div class="jr-reader-impact__number">
            {{ block.settings.number }}
          </div>

          <div class="jr-reader-impact__text">
            {{ block.settings.text }}
          </div>
        </div>
      {% endfor %}

    </div>

    <div class="jr-reader-impact__research">
      <div class="jr-reader-impact__research-title">
        {{ section.settings.research_title }}
      </div>

      <div class="jr-reader-impact__research-text">
        {{ section.settings.research_text }}
      </div>
    </div>

  </div>
</section>

<style>

.jr-reader-impact{
  padding: 30px 20px;
}

.jr-reader-impact__container{
  max-width:1400px;
  margin:0 auto;
}

.jr-reader-impact__header{
  text-align:center;
  margin-bottom:30px;
}

.jr-reader-impact__header h2{
  margin:0 0 10px;
  font-size:40px;
  line-height:1.1;
  font-weight:700;
}

.jr-reader-impact__header p{
  margin:0;
  color:#777;
  font-size:18px;
}

.jr-reader-impact__grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  max-width: 800px;
  margin:0 auto 25px;
}

.jr-reader-impact__card{
  background:#FFE6F5;
  padding:24px 14px;
  border-style: solid;
  border-width: 1px 1px 2px 2px;
  border-color: #FFB3DD;
  border-radius: 14px;
}

.jr-reader-impact__number{
  color: #FF4DAE;
  font-size:48px;
  font-weight:700;
  line-height:1;
  margin-bottom:15px;
}

.jr-reader-impact__text{
  color:#555;
  font-size:17px;
  line-height:1.5;
}

.jr-reader-impact__research{
  max-width: 800px;
  margin:0 auto;
  background: #F7F7F7F7;
  border:1px solid #DEDEDE;
  border-radius:12px;
  padding:18px;
}

.jr-reader-impact__research-title{
  font-size:18px;
  font-weight:700;
  margin-bottom:10px;
}

.jr-reader-impact__research-text{
  color:#666;
  font-size:14px;
  line-height:1.6;
}

@media screen and (max-width:768px){

  .jr-reader-impact{
    padding: 26px 15px;
  }
  .jr-reader-impact__header{
  margin-bottom: 20px;
  }

  .jr-reader-impact__header h2{
    font-size:34px;
  }

  .jr-reader-impact__header p{
    font-size:14px;
  }

  .jr-reader-impact__grid{
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }

  .jr-reader-impact__card{
    padding:18px 12px;
  }

  .jr-reader-impact__number{
    font-size:42px;
  }

  .jr-reader-impact__text{
    font-size:13px;
  }

  .jr-reader-impact__research{
    padding:15px;
  }

}

</style>

{% schema %}
{
  "name": "Reader Impact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Becoming a Reader Changes Everything"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Backed by University research"
    },
    {
      "type": "text",
      "id": "research_title",
      "label": "Research Title",
      "default": "Research sources:"
    },
    {
      "type": "textarea",
      "id": "research_text",
      "label": "Research Text"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "85%"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reader Impact",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}