{%- render 'nyvc-styles' -%}
<div class="nyvc-root" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-check" aria-labelledby="nyvc-h-{{ section.id }}">
      <h2 class="nyvc-h2" id="nyvc-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <ul class="nyvc-check-list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><img src="{{ 'nyvc-ic-check.svg' | asset_url }}" alt="" width="20" height="20"><span>{{ block.settings.text | escape }}</span></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.note != blank -%}<p class="nyvc-check-note">{{ section.settings.note }}</p>{%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: Checklist",
  "tag": "div",
  "class": "section-nyvc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you record" },
    { "type": "inline_richtext", "id": "note", "label": "Highlighted note", "default": "Parents may help with recording and uploading. However, the child's ideas and spoken response should be their own." }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Help your child find a quiet, well-lit space." }
      ]
    }
  ],
  "presets": [{ "name": "NYVC: Checklist", "blocks": [{ "type": "tip" }, { "type": "tip" }] }]
}
{% endschema %}
