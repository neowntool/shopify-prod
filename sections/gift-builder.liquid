<script>

const variants = {{ product.variants | json }};

let selections = {
  location: document.querySelector('[data-type="location"].active')?.dataset.value,
  plan: document.querySelector('[data-type="plan"].active')?.dataset.value,
  duration: document.querySelector('[data-type="duration"].active')?.dataset.value,
  giftType: document.querySelector('.gift-type.active')?.dataset.value
};

// ✅ FIND VARIANT
function getSelectedVariant() {
  return variants.find(v => {

    let options = [v.option1, v.option2, v.option3].filter(Boolean);

    return (
      options.includes(selections.plan) &&
      options.includes(selections.duration) &&
      options.includes(selections.location) // ✅ ADD THIS LINE
    );

  });
}

// UI plan + duration → library/subscription variant ID (line item property only)
const planVariantMap = {
  "Book Regular Plan|3 Months": 44393369305362,
  "Book Regular Plan|6 Months": 45440633209106,
  "Book Regular Plan|12 Months": 45440633241874,
  "Book Sibling Plan (3+3)|3 Months": 46510654390546,
  "Book Sibling Plan (3+3)|6 Months": 46510654521618,
  "Book Sibling Plan (3+3)|12 Months": 47613284811026,
  "Book Sibling Plan (5+5)|3 Months": 47599342223634,
  "Book Sibling Plan (5+5)|6 Months": 47599342256402,
  "Book Sibling Plan (5+5)|12 Months": 47613284843794,
  "Toy + Book Plan|3 Months": 48989945135378,
  "Toy + Book Plan|6 Months": 48989945168146,
  "Toy + Book Plan|12 Months": 48989945200914,
  "Toy Regular Plan|3 Months": 47743238504722,
  "Toy Regular Plan|6 Months": 48989887758610,
  "Toy Regular Plan|12 Months": 48989887791378
};

function getConfiguredVariantId() {
  const key = `${selections.plan}|${selections.duration}`;
  const id = planVariantMap[key];
  return id ? Number(id) : null;
}

// ✅ UPDATE PRICE
function updatePrice() {
  let variant = getSelectedVariant();

  if (variant && variant.price !== undefined && variant.price !== null) {
    let price = variant.price / 100;

    document.getElementById("giftpro-price").innerText =
      "₹" + price.toLocaleString();

  } else {
    document.getElementById("giftpro-price").innerText = "—";
  }
}

// ✅ PLAN DESCRIPTION (NEW 🔥)
function updatePlanDescription() {
  let text = "";

  switch (selections.plan) {
    case "Toy + Book Plan":
      text = "3 toys and 2 books per month";
      break;

    case "Book Sibling Plan (3+3)":
      text = "3 books per month per child (Total 6 books)";
      break;

    case "Book Sibling Plan (5+5)":
      text = "5 books per month per child (Total 10 books)";
      break;

    case "Book Regular Plan":
      text = "5 books per month";
      break;

    case "Toy Regular Plan":
      text = "4 toys per month";
      break;

    case "Book Sibling Plan":
      text = "Sibling plan available in multiple combinations";
      break;

    default:
      text = "";
  }

  let el = document.getElementById("plan-description");
  if (el) el.innerText = text;
}


//new
function filterPlansByLocation() {
  const allPlanButtons = document.querySelectorAll('[data-type="plan"]');

  allPlanButtons.forEach((btn, index) => {
    if (selections.location === "Out Of Mumbai") {
      if (index < 3) {
        btn.style.display = "inline-block";
      } else {
        btn.style.display = "none";
      }
    } else {
      btn.style.display = "inline-block";
    }
  });

  // auto select first visible
  let firstVisible = [...allPlanButtons].find(btn => btn.style.display !== "none");

  if (firstVisible) {
    allPlanButtons.forEach(b => b.classList.remove('active'));
    firstVisible.classList.add('active');
    selections.plan = firstVisible.dataset.value;
  }

  updatePrice();
  updatePlanDescription();
}
//end

// ✅ SHOW / HIDE FORM
function toggleForm() {
  if (selections.giftType && selections.giftType.includes("Digital")) {
    document.getElementById('giftpro-form').style.display = 'block';
  } else {
    document.getElementById('giftpro-form').style.display = 'none';
  }
}

// ✅ CLICK HANDLER
document.querySelectorAll('.giftpro-btn').forEach(btn => {
  btn.addEventListener('click', function () {

    let type = this.dataset.type;

    if (type) {
      selections[type] = this.dataset.value;
    }

    if (this.classList.contains('gift-type')) {
      selections.giftType = this.dataset.value;
    }

    // active toggle
    let parent = this.closest('.giftpro-options');
    parent.querySelectorAll('.giftpro-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // ✅ ONLY HERE call filter (for location only)
    if (type === "location") {
      filterPlansByLocation();
    }

    toggleForm();
    updatePrice();
    updatePlanDescription();
  });
});

// ✅ INITIAL LOAD
toggleForm();
updatePrice();
updatePlanDescription();
filterPlansByLocation(); // ✅ NEW

// ✅ ADD TO CART (FIXED - SINGLE EVENT ONLY)
document.getElementById('giftpro-add-to-cart').addEventListener('click', function (e) {

  let variant = getSelectedVariant();
  let configuredVariantId = getConfiguredVariantId();

  if (!variant || !configuredVariantId) {
    alert("Please select valid options");
    return;
  }

  let props = {
    "Location": selections.location,
    "Plan": selections.plan,
    "Duration": selections.duration,
    "Gift Type": selections.giftType,
    "Variant ID": configuredVariantId
  };

  // DIGITAL DATA
  if (selections.giftType && selections.giftType.includes("Digital")) {
    const recipientEmail = document.getElementById('recipient_email').value.trim();
    const recipientPhone = document.getElementById('recipient_phone').value.trim();

    if (!recipientEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(recipientEmail)) {
      alert("Please enter a valid recipient email");
      return;
    }

    if (!/^\d{10}$/.test(recipientPhone)) {
      alert("Please enter a valid 10-digit phone number");
      return;
    }

    props["Recipient Name"] = document.getElementById('recipient_name').value;
    props["Recipient Email"] = recipientEmail;
    props["Recipient Phone"] = recipientPhone;
    props["Message"] = document.getElementById('gift_message').value;
    props["Sender Name"] = document.getElementById('sender_name').value;
  }

  // GOKWIK BUY NOW
  if (typeof onBuyNowClick === "function") {
    onBuyNowClick(e, false, [
      {
        id: variant.id,
        quantity: 1,
        properties: props
      }
    ]);
  } else {
    window.location.href = "/checkout";
  }

});






// for out of mumbai


</script>



