{% assign product = all_products[section.settings.product] %}

<div class="giftpro-wrapper">

  <!-- PRODUCT -->
  <div class="giftpro-product-box">
    <h2>{{ product.title }}</h2>
  </div>

  <!-- LOCATION -->
  {% assign locations = "Mumbai,Out Of Mumbai" | split: "," %}
  <div class="giftpro-step">
    <h3>SELECT RECIPIENT’S LOCATION</h3>
    <div class="giftpro-options">
      {% for item in locations %}
        <button class="giftpro-btn {% if forloop.first %}active{% endif %}" data-type="location" data-value="{{ item }}">
          {{ item }}
        </button>
      {% endfor %}
    </div>
  </div>

  <!-- PLAN -->
  {% assign plans = "Book Regular Plan,Book Sibling Plan (3+3),Book Sibling Plan (5+5),Toy + Book Plan,Toy Regular Plan" | split: "," %}
  <div class="giftpro-step">
    <h3>SELECT YOUR GIFT PLAN</h3>
     <p id="plan-description" class="plan-desc"></p>
    <div class="giftpro-options">
     
      {% for item in plans %}
        <button class="giftpro-btn {% if forloop.first %}active{% endif %}" data-type="plan" data-value="{{ item }}">
          {{ item }}
        </button>
      {% endfor %}
    </div>
  </div>

  <!-- DURATION -->
  {% assign durations = "3 Months,6 Months,12 Months" | split: "," %}
  <div class="giftpro-step">
    <h3>SELECT DURATION</h3>
    <div class="giftpro-options">
      {% for item in durations %}
        <button class="giftpro-btn {% if forloop.first %}active{% endif %}" data-type="duration" data-value="{{ item }}">
          {{ item }}
        </button>
      {% endfor %}
    </div>
  </div>

 

  <!-- GIFT TYPE -->
{% assign gift_types = "Digital Gift Card,Physical Gift Card" | split: "," %}
<div class="giftpro-step">
  <h3>CHOOSE GIFT TYPE</h3>
  
  <div class="giftpro-options">
    {% for item in gift_types %}
      <button class="giftpro-btn gift-type {% if forloop.first %}active{% endif %}" 
              data-type="giftType"
              data-value="{{ item }}">
        {{ item }}
      </button>
    {% endfor %}

  </div>

  <!-- ✅ NOTE -->
  <div id="physical-note" style="margin-top:10px; padding:8px 12px; background:#f5f5f5; border-radius:6px; font-size:13px;">
    📦 Physical Gift Card will be delivered to the gifter's address.
  </div>
</div>

<script>
 document.querySelectorAll('.giftpro-btn').forEach(btn => {
  btn.addEventListener('click', function () {

    let type = this.dataset.type;

    // ✅ store selection
    if (type) {
      selections[type] = this.dataset.value;
    }

    // ✅ active class toggle
    let parent = this.closest('.giftpro-options');
    parent.querySelectorAll('.giftpro-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // ✅ LOCATION FILTER
    if (type === "location") {
      filterPlansByLocation();
    }

    // ✅ show note only when Physical Gift Card is selected
    if (type === "giftType") {
      const note = document.getElementById("physical-note");
      note.style.display = selections.giftType === "Physical Gift Card" ? "block" : "none";
    }

    // ✅ update UI
    toggleForm();
    updatePrice();
    updatePlanDescription();
  });
});


/* =========================
   PLAN FILTER FUNCTION
========================= */

function filterPlansByLocation() {
  const allPlanButtons = document.querySelectorAll('[data-type="plan"]');

  allPlanButtons.forEach((btn, index) => {
    if (selections.location === "Out Of Mumbai") {
      if (index < 3) {
        btn.style.display = "inline-block";
      } else {
        btn.style.display = "none";
      }
    } else {
      btn.style.display = "inline-block";
    }
  });

  // ✅ auto select first visible
  let visiblePlans = [...allPlanButtons].filter(btn => btn.style.display !== "none");

  if (visiblePlans.length > 0) {
    allPlanButtons.forEach(b => b.classList.remove('active'));
    visiblePlans[0].classList.add('active');
    selections.plan = visiblePlans[0].dataset.value;
  }
}


/* =========================
   INITIAL LOAD
========================= */

// run UI updates
toggleForm();
updatePrice();
updatePlanDescription();
filterPlansByLocation();
</script>

  <!-- FORM -->
  <div id="giftpro-form" class="giftpro-form">
    <h3>RECIPIENT’S DETAILS</h3>
    <p class="giftpro-note">Recipient’s will receive gift card on email</p>

    <input type="text" id="recipient_name" placeholder="Recipient’s Name">
    <input type="email" id="recipient_email" placeholder="Recipient’s Email" required>
    <input type="tel" id="recipient_phone" placeholder="Recipient’s Phone Number" maxlength="10" inputmode="numeric" pattern="[0-9]{10}">
    <textarea id="gift_message" placeholder="Write your message here"></textarea>
    <input type="text" id="sender_name" placeholder="Sender's Name">
  </div>

<div class="giftpro-price-box">
  Total Price: <span id="giftpro-price"></span>
</div>

  <!-- BUTTON -->
  <button id="giftpro-add-to-cart" class="giftpro-main-btn">Continue</button>

</div>




