{%- render 'nyvc-styles' -%}
{%- assign s = section.settings -%}
<div class="nyvc-root" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-pad nyvc-prompts" aria-labelledby="nyvc-h-{{ section.id }}">
      <div class="nyvc-head">
        <h2 class="nyvc-h2" id="nyvc-h-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- if s.subheading != blank -%}<p class="nyvc-sub nyvc-sub--narrow">{{ s.subheading }}</p>{%- endif -%}
      </div>
      <div class="nyvc-prompt-grid">
        {%- for block in section.blocks -%}
          {%- render 'nyvc-prompt-card', b: block.settings, attrs: block.shopify_attributes -%}
        {%- endfor -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: Video prompts",
  "tag": "div",
  "class": "section-nyvc",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Video prompts" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "select", "id": "color", "label": "Card colour", "default": "pink", "options": [
          { "value": "pink", "label": "Pink" },
          { "value": "yellow", "label": "Yellow" },
          { "value": "cyan", "label": "Cyan" }
        ] },
        { "type": "text", "id": "badge", "label": "Badge", "default": "CATEGORY I" },
        { "type": "text", "id": "title", "label": "Title", "default": "Standards 3–4:" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "view_label", "label": "First button label", "default": "View Prompt" },
        { "type": "url", "id": "view_url", "label": "First button link" },
        { "type": "text", "id": "pdf_label", "label": "Second button label", "default": "Download PDF" },
        { "type": "url", "id": "pdf_url", "label": "Second button link" },
        { "type": "text", "id": "pdf_file", "label": "Or PDF file URL", "info": "Paste a link from Content > Files. Used instead of the link above." }
      ]
    }
  ],
  "presets": [{ "name": "NYVC: Video prompts", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
