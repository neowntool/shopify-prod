{%- render 'nyvc-styles' -%}
{%- assign s = section.settings -%}
<div class="nyvc-root" id="nyvc-{{ section.id }}">
  <div class="nyvc-wrap">
    <section class="nyvc-wa" aria-labelledby="nyvc-h-{{ section.id }}">
      <span class="nyvc-wa-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H9l-5 4V5a1 1 0 0 1 1-1z" fill="#4caf50"/><path d="M8 9h8M8 12.5h5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>
      </span>
      <div class="nyvc-wa-text">
        {%- if s.pill != blank -%}
          <span class="nyvc-wa-pill">
            <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="#fff" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.2" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ s.pill | escape }}
          </span>
        {%- endif -%}
        <h2 id="nyvc-h-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      </div>
      {%- if s.button_label != blank and s.link != blank -%}
        <a class="nyvc-wa-btn" href="{{ s.link }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
          {{ s.button_label | escape }}
        </a>
      {%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "NYVC: WhatsApp group",
  "tag": "div",
  "class": "section-nyvc",
  "settings": [
    { "type": "text", "id": "pill", "label": "Small label", "default": "Parent & Guardian Community • Broadcast & verified updates only (no spam)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join WhatsApp Group for Official Communication" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Stay updated with important championship announcements, schedule reminders, live session links, and parent support." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join WhatsApp" },
    { "type": "url", "id": "link", "label": "WhatsApp group link", "info": "The button shows once a link is added." }
  ],
  "presets": [{ "name": "NYVC: WhatsApp group" }]
}
{% endschema %}
