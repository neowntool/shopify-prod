{% schema %}
{
  "name": "Million Reader Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Growing the Million Reader Movement"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Together with schools, corporates, and communities across India."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "32"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Schools Participation"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Million Reader Stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}

<section class="mr-section-wrapper">
  <div class="mr-container">
    
    <h2 class="mr-heading">{{ section.settings.heading }}</h2>
    <p class="mr-subheading">{{ section.settings.subheading }}</p>

    <div class="mr-stats-grid">
      {% for block in section.blocks %}
        <div class="mr-stat-item" {{ block.shopify_attributes }}>
          <h3 class="mr-number">{{ block.settings.number }}</h3>
          <p class="mr-label">{{ block.settings.label }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
/* Wrapper */
.mr-section-wrapper {
  padding: 60px 20px;
  text-align: center;
}

/* Container */
.mr-container {
  max-width: 1100px;
  margin: 0 auto;
}

/* Heading */
.mr-heading {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 10px;
  color: #222;
}

/* Subheading */
.mr-subheading {
  font-size: 16px;
  color: #666;
  margin-bottom: 40px;
}

/* Grid */
.mr-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0px;
}

/* Stat Item */
.mr-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Number */
.mr-number {
  font-size: 56px;
  font-weight: 700;
  color: #A5B32B;
  margin: 0;
}

/* Label */
.mr-label {
  font-size: 16px;
  color: #333;
  margin-top: 10px;
}

/* Responsive */
@media (max-width: 768px) {
  .mr-heading {
    font-size: 32px;
  }

  .mr-number {
    font-size: 44px;
  }

  .mr-stats-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }
}
</style>