{%- comment -%}
  Page backdrop from the Lovable LP: faint grid plus floating doodles (desktop only), fixed behind the page.
  Rendered by the LP hero section when "Show grid and doodles background" is on.
{%- endcomment -%}
{%- liquid
  assign doodles = 'book-open|text-brand-pink/45|top:12%;left:4%;width:44px;height:44px;animation:float 7s ease-in-out 0s infinite,star|text-brand-violet/45|top:22%;left:92%;width:30px;height:30px;animation:wiggle 8s ease-in-out 1.5s infinite,puzzle|text-brand-cyan/55|top:48%;left:2.5%;width:36px;height:36px;animation:sway 9s ease-in-out 3s infinite,sparkles|text-brand-lime/55|top:62%;left:94%;width:34px;height:34px;animation:drift 10s ease-in-out 0.8s infinite,rocket|text-brand-orange/45|top:82%;left:6%;width:38px;height:38px;animation:float 7s ease-in-out 2.2s infinite,heart|text-brand-teal/50|top:88%;left:90%;width:28px;height:28px;animation:wiggle 8s ease-in-out 4s infinite,music|text-brand-pink/45|top:36%;left:96%;width:26px;height:26px;animation:sway 9s ease-in-out 2.8s infinite,pencil|text-brand-violet/45|top:72%;left:1.5%;width:28px;height:28px;animation:drift 10s ease-in-out 1.1s infinite,book|text-brand-cyan/55|top:6%;left:70%;width:30px;height:30px;animation:float 7s ease-in-out 0.4s infinite,pencil-line|text-brand-lime/55|top:30%;left:8%;width:30px;height:30px;animation:wiggle 8s ease-in-out 2.5s infinite,palette|text-brand-orange/45|top:55%;left:88%;width:34px;height:34px;animation:sway 9s ease-in-out 1.8s infinite,ruler|text-brand-teal/50|top:92%;left:40%;width:30px;height:30px;animation:drift 10s ease-in-out 3.4s infinite,book-marked|text-brand-pink/45|top:40%;left:86%;width:28px;height:28px;animation:float 7s ease-in-out 0.6s infinite,shapes|text-brand-violet/45|top:66%;left:10%;width:30px;height:30px;animation:wiggle 8s ease-in-out 4.2s infinite,brush|text-brand-cyan/55|top:16%;left:18%;width:26px;height:26px;animation:sway 9s ease-in-out 2.9s infinite,library|text-brand-lime/55|top:78%;left:82%;width:34px;height:34px;animation:drift 10s ease-in-out 1.3s infinite,crown|text-brand-orange/45|top:4%;left:34%;width:24px;height:24px;animation:float 7s ease-in-out 3.8s infinite,smile|text-brand-teal/50|top:96%;left:70%;width:26px;height:26px;animation:wiggle 8s ease-in-out 0.2s infinite' | split: ','
-%}
<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="bg-grid absolute inset-0"></div>
  {%- for d in doodles -%}
    {%- assign p = d | split: '|' -%}
    {%- assign cls = 'absolute hidden md:block ' | append: p[1] -%}
    <span class="{{ cls }}" style="{{ p[2] }}">{% render 'lpl-icon', name: p[0], class: 'size-full', stroke: '1.25' %}</span>
  {%- endfor -%}
</div>
