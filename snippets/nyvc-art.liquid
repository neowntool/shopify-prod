{%- comment -%}
  NYVC hero artwork: glow, girl photo, crown, bulb, stars and sparkle ticks.
  Positions are % of a 620 x 650 box in desktop-hero pixels (Figma frame 224:2130), so the same
  markup scales down for the mobile hero. Used by sections/nyvc.liquid.
{%- endcomment -%}
<img class="nyvc-art-glow" src="{{ 'nyvc-glow.svg' | asset_url }}" alt="">
{%- if photo != blank -%}
  {{ photo | image_url: width: 1100 | image_tag: class: 'nyvc-art-girl', alt: '', loading: 'eager', fetchpriority: 'high', widths: '400, 700, 1100' }}
{%- else -%}
  <img class="nyvc-art-girl" src="{{ 'nyvc-girl.png' | asset_url }}" alt="" width="1026" height="1026" loading="eager" fetchpriority="high">
{%- endif -%}
