{%- comment -%}
  GA4 P3 "secondary engagement" events for GTM: faq_expand, scroll_depth, blog_read,
  workbook_bundle_click, login_click, page_not_found. Never push name, phone or email.
{%- endcomment -%}
<script>
(function () {
  function dl(o) { window.dataLayer = window.dataLayer || []; window.dataLayer.push(o); }
  function pt() { return window.neownPageType || ''; }
  function clean(t) { return String(t || '').replace(/\s+/g, ' ').trim(); }
  function slug(t, n) { return clean(t).toLowerCase().replace(/&/g, 'and').replace(/[’'?]/g, '').replace(/[^a-z0-9+]+/g, '_').replace(/^_+|_+$/g, '').slice(0, n || 60); }
  var ARTICLE = {% if template.name == 'article' and article %}{{ article.handle | json }}{% else %}null{% endif %};

  // page_not_found (full URL without the query string, which can carry personal data)
  if (pt() === '404') dl({ event: 'page_not_found', page_location: location.origin + location.pathname });

  // scroll_depth on key landing pages; blog_read at 60% of an article
  var SCROLL_PAGES = { sip_page: 1, lp1: 1, home: 1, books: 1 };
  var marks = [25, 50, 75, 100], sent = {}, readSent = false, ticking = false;
  function depth() {
    var d = document.documentElement, h = Math.max(d.scrollHeight - window.innerHeight, 1);
    return Math.min(100, Math.round((window.scrollY || d.scrollTop) / h * 100));
  }
  function onScroll() {
    ticking = false;
    var p = depth();
    if (SCROLL_PAGES[pt()]) marks.forEach(function (m) {
      if (p >= m && !sent[m]) { sent[m] = 1; dl({ event: 'scroll_depth', percent: m, page_type: pt() }); }
    });
    if (ARTICLE && !readSent && p >= 60) { readSent = true; dl({ event: 'blog_read', article_id: ARTICLE }); }
  }
  if (SCROLL_PAGES[pt()] || ARTICLE) {
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; setTimeout(onScroll, 250); } }, { passive: true });
  }

  document.addEventListener('click', function (e) {
    var t = e.target;

    // faq_expand: collapsible FAQ questions (fires only when the answer is being opened)
    var trig = t.closest && t.closest('collapsible-tab [data-trigger], .m-collapsible--button, details > summary');
    if (trig) {
      var box = trig.closest('collapsible-tab, details');
      var content = box && box.querySelector('[data-content], .m-collapsible--content');
      var wasOpen = box && (box.tagName === 'DETAILS' ? box.open : (box.classList.contains('active') || box.hasAttribute('open') || (content && !content.hidden && content.offsetHeight > 0)));
      if (!wasOpen) dl({ event: 'faq_expand', faq_id: slug(trig.innerText || trig.textContent), page_type: pt() });
    }

    var a = t.closest && t.closest('a[href], button');
    if (!a) return;
    var text = clean(a.innerText || a.textContent || a.getAttribute('aria-label') || '');

    // workbook_bundle_click: bundle cards on the workbooks page
    var card = a.closest('.fm-card') || (a.matches('.fm-card') ? a : null);
    if (card && /workbook/.test(pt())) {
      var sec = card.closest('.shopify-section');
      var head = sec && sec.querySelector('h1, h2, h3');
      var ht = clean(head && head.innerText).toLowerCase();
      var grade = /activity/.test(ht) ? 'activity' : /preschool|nursery|kg/.test(ht) ? 'preschool' : /grade\s*1/.test(ht) ? 'grade_1' : /grade\s*2/.test(ht) ? 'grade_2' : slug(ht, 30);
      var title = card.querySelector('h1, h2, h3, h4, [class*="title"]');
      dl({ event: 'workbook_bundle_click', bundle_name: slug(title ? title.innerText : text), grade: grade });
    }

    // login_click: "Log in" / "Register" / "Account" (My Account)
    var href = a.getAttribute('href') || '';
    if (/^(log ?in|login|sign ?in|register|create (an )?account|account|my account)$/i.test(text) || /\/account\/(login|register)/.test(href)) {
      dl({ event: 'login_click', link_text: slug(text || href) });
    }
  }, true);
})();
</script>
