    {% render 'shopflo-sso-add-button' %}

      {%- comment -%} GA4: app_download_click on any Play Store / App Store link (thank-you page handles its own). {%- endcomment -%}
    {%- liquid
      assign ga_tpl = template.suffix | default: template.name
      case ga_tpl
        when 'index'
          assign ga_page_type = 'home'
        when 'reading-sip'
          assign ga_page_type = 'sip_page'
        when 'reading-sip-thank-you'
          assign ga_page_type = 'sip_thank_you'
        when 'LP1'
          assign ga_page_type = 'lp1'
        when 'books'
          assign ga_page_type = 'books'
        when 'toy-library', 'toys-landing-page'
          assign ga_page_type = 'toys'
        when 'book-product', 'books-product-page'
          assign ga_page_type = 'book_pdp'
        when 'workbook-main-page-new', 'workbooks-main-page'
          assign ga_page_type = 'workbooks'
        else
          assign ga_page_type = ga_tpl | handleize | replace: '-', '_'
      endcase
    -%}
    <script>
      (function () {
        window.neownPageType = '{{ ga_page_type }}';
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.closest('[id^="sty-"]')) return;
          var h = a.href || '', store = /play\.google\.com\/store\/apps/i.test(h) ? 'play' : (/apps\.apple\.com\//i.test(h) ? 'app_store' : '');
          if (!store) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'app_download_click', store: store, page_type: window.neownPageType });
        }, true);
      })();
    </script>
    {% render 'ga4-plan-events' %}
    {% render 'ga4-p2-events' %}
    {% render 'ga4-p3-events' %}
</body>
</html>
