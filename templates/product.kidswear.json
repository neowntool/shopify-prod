der: none;\n            padding: 5px 10px;\n            cursor: pointer;\n            border-radius: 5px;\n        }\n    @media (max-width: 480px) {\n      .popup-overlay-size-chart {\n        height: 70%;\n      }\n    }\n    @media (max-width: 480px) {\n      .popup-content-size-chart {\n        max-width: 90%;\n      }\n    }\n    \n    <\/style>\n<\/head>\n<body>\n    <p class=\"size-chart-link\" onclick=\"showPopup()\">Size chart<\/p>\n\n    <div class=\"popup-overlay-size-chart\" id=\"popupOverlaySizeChart\">\n        <div class=\"popup-content-size-chart\">\n            <button class=\"close-btn\" onclick=\"closePopup()\">X<\/button>\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Size-Chart.jpg?v=1721719369\" alt=\"Size Chart\">\n        <\/div>\n    <\/div>\n\n    <script>\n        function showPopup() {\n            document.getElementById('popupOverlaySizeChart').style.display = 'flex';\n        }\n\n        function closePopup() {\n            document.getElementById('popupOverlaySizeChart').style.display = 'none';\n        }\n    <\/script>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_quantity_selector":true,"show_atc_button":true,"show_dynamic_checkout":true,"show_gift_card_recipient":true}},"collapsible_tab_6Qwipw":{"type":"collapsible_tab","settings":{"heading":"Product Description","content":"","liquid":"{{product.description}}","default_open":true}},"shipping_hVtWBg":{"type":"shipping","settings":{"show_delivery_times":true,"deliver_text":"Estimated Delivery:","deliver_days":"5","date_format":"%b %d","show_shipping_text":true,"shipping_text":"<p><strong>Shipping Costs:<\/strong> FREE in India<\/p>"}}},"block_order":["title","price","variant_picker","custom_liquid_t4zxXK","buy_buttons","collapsible_tab_6Qwipw","shipping_hVtWBg"],"settings":{"container":"container","layout":"layout-6","show_atwl":true,"enable_history_state":true,"enable_variant_group_images":false,"disable_selected_variant_default":false,"show_featured_media":true,"show_zoom_button":true,"enable_video_autoplay":false,"show_nav_media_mobile":false,"show_pagination_mobile":true,"use_sticky_atc":true,"use_sticky_atc_on_mobile":true,"enable_dynamic_checkout":false,"sticky_atc_wishtlist":false,"sticky_atc_compare":false}},"product-details-tabs":{"type":"product-details-tabs","blocks":{"tab":{"type":"tab","settings":{"header":"<b>Circular, the neOwn Way<b><\/b><\/b>","content":"<p>Bored of the same tees? Has your child outgrown the tees? Recycle responsibly by sending them back to us! <strong>Get Rs. 50\/- <\/strong>in store credit on every t-shirt that you send in our return bag!<\/p>","content_page":""}},"tab_3CnkGE":{"type":"tab","settings":{"header":"Disclaimer","content":"<ul><li>The colors on the t-shirts may appear different due to lighting variations during photography.<\/li><li>Do not iron over the print. Gentle machine wash.<\/li><\/ul>","content_page":""}}},"block_order":["tab","tab_3CnkGE"],"settings":{"container":"container-fluid","color_scheme":"","default_open":true,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"product-recommendations":{"type":"product-recommendations","custom_css":["h3 {font-size: 16px; \/* Sets the font size for h2 to h6 headings *\/}"],"settings":{"container":"container","color_scheme":"","remove_params":false,"heading":"You Might Also Like","heading_size":"h3","text_align":"left","limit":8,"columns":4,"column_gap":30,"enable_slider":true,"use_scroll_mobile":true,"padding_top":30,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"recent-viewed-products":{"type":"recent-viewed-products","settings":{"container":"container","color_scheme":"","heading":"Recently Viewed Products","heading_size":"h3","text_align":"left","limit":8,"columns":4,"column_gap":30,"pcard_layout":"","pcard_image_ratio":"","show_vendor":false,"hide_title":false,"enable_slider":true,"show_pagination":false,"show_navigation":false,"mobile_disable_slider":false,"use_scroll_mobile":true,"item_gap_mobile":16,"padding_top":100,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"collapsible_tabs_Yq864N":{"type":"collapsible-tabs","blocks":{"item_RTYT3J":{"type":"item","settings":{"header":"What will I get in the neOwn Kidswear Pack?","text_size":"h5","content":"<p>You will get: <\/p><ul><li>The t-shirt(s) you have purchased<\/li><li>Free worksheets & stickers <\/li><\/ul>","content_page":"","open":false}},"item_3WpDxh":{"type":"item","settings":{"header":"How long will it take to get my order?","text_size":"h5","content":"<p>Once you have selected your items, delivery will occur within 2-5 working days. If you have any more questions, feel free to get in touch with us at +91 9137081640<\/p>","content_page":"","open":false}},"item_D888fX":{"type":"item","settings":{"header":"Can I cancel my order?","text_size":"h5","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your product, we’d love to hear what you would like us to change or improve! WhatsApp us on 9137081640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","content_page":"","open":false}},"item_gTNAmK":{"type":"item","settings":{"header":"Can I exchange my order if it’s not the right size?","text_size":"h5","content":"<p>Yes! We have a 7-day exchange period where you can exchange your clothing (against the same product SKU) if it’s not the right size. <\/p>","content_page":"","open":false}},"item_fUF3EF":{"type":"item","settings":{"header":"What is your return\/exchange policy?","text_size":"h5","content":"<p>For Exchange due to size issue, you can request a size exchange within 7 days of receiving your products. <\/p><p>If you wish to Return the products, we offer neOwn store credit amounting to the value of the items to be returned within 7 days of receiving your products. <\/p><p>To exchange or return your products, please reach out to us with your order number and the new size you require. <\/p>","content_page":"","open":false}},"item_bAMdz8":{"type":"item","settings":{"header":"What is your refund policy?","text_size":"h5","content":"<p>At the moment, we only provide neOwn store credit as a refund. <\/p>","content_page":"","open":false}},"item_gRw8Ve":{"type":"item","settings":{"header":"Do you have a sizing guide?","text_size":"h5","content":"<p>Yes! You can check our size guide here. <\/p>","content_page":"","open":false}},"item_EXCLBP":{"type":"item","settings":{"header":"How can I recycle neOwn Kidswear? ","text_size":"h5","content":"<p>Get ₹50\/- neOwn store credit for every neOwn t-shirt sent to us for recycling or reuse! <br\/>You can recycle your t-shirts in 3 easy steps: <\/p><ol><li>Get in touch with the neOwn team to schedule a free pick-up for the clothes here<\/li><li>Pack the T-Shirts in the neOwn Poly-Bag provided for the return <\/li><li>Once the courier is booked, the T-Shirts will be picked up from your location and delivered back to us to be recycled or reused. <\/li><\/ol><p>Please note: We accept t-shirts in any condition except for holes and tears. <\/p><p>To recycle with neOwn, please reach out to us with your order number and the items you wish to recycle. <\/p>","content_page":"","open":false}}},"block_order":["item_RTYT3J","item_3WpDxh","item_D888fX","item_gTNAmK","item_fUF3EF","item_bAMdz8","item_gRw8Ve","item_EXCLBP"],"settings":{"container":"container","color_scheme":"","image_position":"left","column_gap":90,"heading":"frequently asked questions","heading_size":"h3","subheading":"","description":"","header_alignment":"center","padding_top":0,"padding_bottom":0,"animations":"inherit","custom_class":""}}},"order":["16341802176432806c","empty_space_era8Wn","main","product-details-tabs","product-recommendations","recent-viewed-products","collapsible_tabs_Yq864N"]}