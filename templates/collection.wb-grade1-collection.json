e=1.0\">\n    <title>Responsive Video Player<\/title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            \/* background-color: #000; *\/\n            color: #fff;\n            font-family: Arial, sans-serif;\n        }\n\n        .thumbnail-container {\n            display: flex;\n            gap: 10px;\n            overflow-x: auto; \/* Enables horizontal scrolling *\/\n            padding: 10px;\n            scroll-snap-type: x mandatory; \/* Enables scroll snapping *\/\n        }\n\n        \/* Hide scrollbar *\/\n        .thumbnail-container::-webkit-scrollbar {\n            display: none; \/* For WebKit browsers (Chrome, Safari) *\/\n        }\n        .thumbnail-container {\n            -ms-overflow-style: none;  \/* For Internet Explorer and Edge *\/\n            scrollbar-width: none;    \/* For Firefox *\/\n        }\n\n        .thumbnail {\n            position: relative;\n            flex-shrink: 0; \/* Prevents shrinking *\/\n            width: 30vw; \/* 70% of the viewport width *\/\n            height: 30vh; \/* 40% of the viewport height *\/\n            background: #333;\n            border-radius: 8px;\n            overflow: hidden;\n            cursor: pointer;\n            scroll-snap-align: center; \/* Aligns items in the center when scrolling *\/\n        }\n\n        .thumbnail img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .fullscreen-player {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            background-color: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            display: none;\n        }\n\n        .fullscreen-player video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .close-btn {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: rgba(255, 255, 255, 0.8);\n            border: none;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            \/* padding: 10px; *\/\n            font-size: 16px;\n            cursor: pointer;\n            z-index: 2000;\n            justify-content: center;\n            align-items: center;\n            transition: background 0.1s ease-out; \n        }\n\n        .close-btn:hover {\n            background: rgba(117, 117, 117, 0.8);\n        }\n\n        \/* Responsive Styling *\/\n        @media (min-width: 768px) {\n            .thumbnail {\n                width: 100px;\n                height: 200px;\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .thumbnail {\n                width: 150px;\n                height: 300px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"thumbnail-container\">\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/52d6816b1d644872b1e21aab3fde84d4.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks1_compressed.avifs?v=1750067006\" alt=\"Thumbnail for 1.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/22ab5cba2b6042febafdc77710fe3195.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks2_compressed.avifs?v=1750066995\" alt=\"Thumbnail for 2.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/51d429461bb04ee58a9e692aece0aaf8.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks3_compressed.avifs?v=1750066995\" alt=\"Thumbnail for 3.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/4667aa9c1ac84b5cace8c692a23bbd78.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks4_compressed.avifs?v=1750066995\" alt=\"Thumbnail for 4.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/61cbfc53c1124b6882c40a87e86bc8fb.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks5compressed.avifs?v=1750066995\" alt=\"Thumbnail for 5.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/5dbcacd102ac42329602f9fb6e014b11.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks6compressed.avifs?v=1750066995\" alt=\"Thumbnail for 6.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/eb10be539ec045a5b615ace4d9ff6cfb.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks7compressed.avifs?v=1750066995\" alt=\"Thumbnail for 7.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/27e1f41d919d4019872169b65760b1e1.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks8compressed-ezgif.com-video-to-avif-converter.avifs?v=1750066995\" alt=\"Thumbnail for 8.mp4\">\n        \n        <\/div>\n    <\/div>\n\n    <div class=\"fullscreen-player\" id=\"fullscreen-player\">\n        <button class=\"close-btn\" id=\"close-btn\">✕<\/button>\n        <video id=\"video-player\" controls autoplay><\/video>\n    <\/div>\n\n    <script>\n        const thumbnails = document.querySelectorAll('.thumbnail');\n        const fullscreenPlayer = document.getElementById('fullscreen-player');\n        const videoPlayer = document.getElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        \/\/ Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        \/\/ Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); \/\/ Stop video playback\n            videoPlayer.src = ''; \/\/ Clear video source\n        });\n    <\/script>","custom_class":""}},"collapsible_tabs_mPcRRM":{"type":"collapsible-tabs","blocks":{"item_RdkBYb":{"type":"item","settings":{"header":"What age group are these workbooks suitable for?","text_size":"h5","content":"<p>Our workbooks are curated for children aged 6–8 years (Grades 1–3), covering key foundational skills in English, Math, and Brain Boosters (puzzles, logic, and critical thinking).<br\/><br\/><\/p>","content_page":"","open":false}},"item_z4mXU7":{"type":"item","settings":{"header":"What subjects are covered in these workbooks?","text_size":"h5","content":"<p>We currently offer workbooks in:<\/p><p>✅ English – Reading comprehension, grammar, vocabulary, and writing skills<\/p><p>✅ Math – Problem-solving, number operations, mental math, and application-based learning<\/p><p>✅ Brain Boosters – Logical reasoning, puzzles, critical thinking, and fun learning activities<\/p><p>We are always open to adding more workbooks! If you’d like to see specific topics covered, let us know.<br\/><br\/><\/p>","content_page":"","open":false}},"item_Ghtyna":{"type":"item","settings":{"header":"Are these workbooks created by neOwn?","text_size":"h5","content":"<p>No, we do not publish our own workbooks. We carefully curate the best workbooks from multiple top publishers to ensure your child gets high-quality, effective practice materials.<br\/><br\/><\/p>","content_page":"","open":false}},"item_WdCHmi":{"type":"item","settings":{"header":"Can I return or exchange a workbook? ","text_size":"h5","content":"<p>Since workbooks are learning materials, we do not accept returns or exchanges once an order is placed. However, if you receive a damaged product, please contact us within 48 hours of delivery, and we’ll help resolve the issue.<br\/><br\/><\/p>","content_page":"","open":false}},"item_8MqHRj":{"type":"item","settings":{"header":"Do the workbooks come with an answer key?","text_size":"h5","content":"<p>Some workbooks include answer keys, while others focus on practice and interactive learning. If answer keys are a priority for you, please check the workbook description before purchasing or reach out to us for details.<br\/><br\/><\/p>","content_page":"","open":false}},"item_kYA9Xf":{"type":"item","settings":{"header":"Do you provide a structured learning plan?","text_size":"h5","content":"<p>Each workbook set is designed for flexible, self-paced learning. However, we include a FREE Workbook Practice Tracker with every order to help parents and kids track progress, set goals, and build a consistent learning habit.<br\/><\/p>","content_page":"","open":false}},"item_h6kw34":{"type":"item","settings":{"header":"How do I choose the right workbook for my child?","text_size":"h5","content":"<p>If you're unsure which workbooks to choose, consider:<\/p><p>Your child’s grade level and current skills<\/p><p>Their learning style and interests (e.g., puzzle-based vs. structured exercises)<\/p><p>Areas where they need extra practice or confidence-building<\/p><p>Still need help? Feel free to contact us for personalized recommendations!<\/p>","content_page":"","open":false}},"item_aNDH8U":{"type":"item","settings":{"header":"Can I subscribe to receive workbooks monthly?","text_size":"h5","content":"<p>We currently offer individual workbook purchases, but if you're interested in a monthly workbook subscription, get in touch with us <a href=\"https:\/\/wa.me\/919137081640?text=Hi,%20I%20would%20be%20interested%20in%20a%20monthly%20workbooks%20subscription\"><span style=\"text-decoration:underline\">here<\/span><\/a>. <br\/><br\/><\/p>","content_page":"","open":false}},"item_4M43QA":{"type":"item","disabled":true,"settings":{"header":"Can I see your collection before subscribing? What kind of books do you have? ","text_size":"h5","content":"<p>Yes, you can see our collections here: <\/p><p>Book Collection: <\/p><p>We keep a very wide variety of fiction books for children between the ages of 0-15 years, and we also have a lot of non-fiction and educational books for children between the ages of 0-15 years. <\/p>","content_page":"","open":false}},"item_Uq9Rfr":{"type":"item","settings":{"header":"Do you ship across India?","text_size":"h5","content":"<p>Yes! We offer Pan-India delivery so you can get the best workbooks delivered right to your doorstep.<\/p>","content_page":"","open":false}},"item_9dML8g":{"type":"item","disabled":true,"settings":{"header":"How do you sanitize the books? ","text_size":"h5","content":"<p>Our process to ensure the books are hygenic and in good condition: <\/p><ul><li>⁠We do a thorough check of all books twice - once after they have come back from customers and the second time before they are going to another customer <\/li><li>⁠⁠We also clean board books to ensure they are 100% sanitary <\/li><li>⁠⁠If any books are of bad quality we don't circulate them among customers anymore<\/li><\/ul>","content_page":"","open":false}},"item_7giwLe":{"type":"item","disabled":true,"settings":{"header":"If I subscribe today, will my 30 days start now? ","text_size":"h5","content":"<p>No, your 30 days will start after the books have been delivered to you. <\/p><p>Once you subscribe, you have to download our app to select your books. After selection, they will be delivered in 2-5 days within Mumbai and 4-8 days outside Mumbai. <\/p><p>Your 30 days start from the day when the books are delivered. <\/p>","content_page":"","open":false}},"item_7HnUMH":{"type":"item","disabled":true,"settings":{"header":"What are the shipping charges for outstation? ","text_size":"h5","content":"<p>The shipping charges for out-of-Mumbai deliveries are as follows: <\/p><p><strong>Plan Name<\/strong><\/p><p><strong>Number of items per month <\/strong><\/p><p><strong>Outside Mumbai Shipping Charge <\/strong><\/p><p>Book Library (1 child)<\/p><p>5 books per month<\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (3+3 Plan)<\/p><p>3+3 (total 6) books per month <\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (5+5 Plan)<\/p><p>5+5 books (total 10) per month<\/p><p>₹200\/- per month<\/p><p>Currently our Toy Library is only being serviced in Mumbai, Navi Mumbai, & Thane. <\/p>","content_page":"","open":false}},"item_QK6PYx":{"type":"item","disabled":true,"settings":{"header":"My pin code is showing not serviceable. What do I do? ","text_size":"h5","content":"<p>We may still be able to deliver to you! WhatsApp us at +91 9137081640 and let us know your pin code, we’ll inform you if your area is serviceable. <\/p>","content_page":"","open":false}},"item_rrAeTE":{"type":"item","disabled":true,"settings":{"header":"How do I return the Library books? ","text_size":"h5","content":"<p>Once you are done reading the books, you can select ‘Done Reading’ on our app. Then you have to select your next set of books. Once the next set is confirmed, our team will schedule a delivery for the new items and a pickup to return the old books. The return process is as follows: We’ll send our delivery partner directly to your doorstep for the pickup of the books. You’ll be notified of the timelines, and you can keep the books packed for when it's time for the pickup.<\/p>","content_page":"","open":false}},"item_i8tCm9":{"type":"item","disabled":true,"settings":{"header":"Do you have other languages books?","text_size":"h5","content":"<p>Yes! We also have a limited collection of books in Hindi, Marathi, and Gujarati. <\/p>","content_page":"","open":false}},"item_X7TPNQ":{"type":"item","disabled":true,"settings":{"header":"Can I cancel the Library Subscription at any time? ","text_size":"h5","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on 9137081640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","content_page":"","open":false}}},"block_order":["item_RdkBYb","item_z4mXU7","item_Ghtyna","item_WdCHmi","item_8MqHRj","item_kYA9Xf","item_h6kw34","item_aNDH8U","item_4M43QA","item_Uq9Rfr","item_9dML8g","item_7giwLe","item_7HnUMH","item_QK6PYx","item_rrAeTE","item_i8tCm9","item_X7TPNQ"],"settings":{"container":"container","color_scheme":"","image_position":"left","column_gap":100,"heading":"FAQs","heading_size":"h3","subheading":"","description":"","header_alignment":"center","padding_top":0,"padding_bottom":0,"animations":"inherit","custom_class":""}},"custom_code_QnxVk7":{"type":"custom-code","custom_css":[],"settings":{"custom_css":".m-price {\n  visibility: hidden;\n}"}}},"order":["collection-header","slider_MQbpNN","main","custom_commitment_section_QyMGFd","reviews_sec_B4MKwk","parents_community_section_ARALPR","rich_text_DcmpYe","custom_liquid_na4jVf","collapsible_tabs_mPcRRM","custom_code_QnxVk7"]}