 margin: 40px auto;\n  padding: 10px 20px;\n}\n.mrm-heading {\n  text-align: center;\n  margin-bottom: 10px;\n}\n.mrm-heading h2 {\n  font-size: 36px;\n  font-weight: 700;\n  margin: 0;\n}\n.mrm-heading p {\n  color: #666;\n  font-size: 14px;\n  margin-top: 8px;\n  margin-bottom: 25px;\n}\n.mrm-field {\n  margin-bottom: 18px;\n}\n.mrm-field label {\n  display: block;\n  font-size: 14px;\n  font-weight: 700;\n  margin-bottom: 6px;\n  color: #000000;\n}\n.mrm-field input,\n.mrm-field select,\n.mrm-field textarea {\n  width: 100%;\n  border: 1px solid #ddd;\n  color: #000;\n  padding: 14px;\n  font-size: 14px;\n  border-radius: 6px;\n  outline: none;\n}\n.mrm-field textarea {\n  height: 120px;\n  resize: none;\n}\n.mrm-btn {\n  width: 100%;\n  background: #ff2d8f;\n  color: white;\n  padding: 14px;\n  border: none;\n  font-size: 16px;\n  border-radius: 6px;\n  cursor: pointer;\n}\n.mrm-field input::placeholder,\n.mrm-field textarea::placeholder {\n  color: #898989;\n}\n.mrm-field input::-webkit-input-placeholder,\n.mrm-field textarea::-webkit-input-placeholder {\n  color: #898989;\n}\n.mrm-field input:-ms-input-placeholder,\n.mrm-field textarea:-ms-input-placeholder {\n  color: #898989;\n}\n<\/style>\n\n<div class=\"mrm-form-wrapper\">\n\n  <div class=\"mrm-heading\">\n    <h2>Collaborate With MRM<\/h2>\n    <p>Partner with us to bring reading programs to your school, organization, or community.<\/p>\n  <\/div>\n\n  {% form 'contact' %}\n\n    <div class=\"mrm-field\">\n      <label>Full Name<\/label>\n      <input type=\"text\" name=\"contact[name]\" placeholder=\"John Doe\" required>\n    <\/div>\n\n    <div class=\"mrm-field\">\n      <label>Email id<\/label>\n      <input type=\"email\" name=\"contact[email]\" placeholder=\"Johndoe@gmail.com\" required>\n    <\/div>\n\n    <div class=\"mrm-field\">\n      <label>Phone Number<\/label>\n      <input type=\"tel\" name=\"contact[phone]\">\n    <\/div>\n\n    <!-- Who are you -->\n    <div class=\"mrm-field\">\n      <label>Who are you?<\/label>\n      <select id=\"roleSelect\" name=\"contact[Who are you?]\">\n        <option value=\"\"><\/option>\n        <option>School<\/option>\n        <option>Organization<\/option>\n        <option>Individual<\/option>\n        <option>Other<\/option>\n      <\/select>\n    <\/div>\n\n    <!-- Other Role -->\n    <div class=\"mrm-field\" id=\"other-role-field\" style=\"display:none;\">\n      <label>Specify<\/label>\n      <input type=\"text\" id=\"otherRoleInput\" placeholder=\"Enter your role\">\n    <\/div>\n\n    <!-- City -->\n    <div class=\"mrm-field\">\n      <label>City<\/label>\n      <select id=\"citySelect\" name=\"contact[City]\">\n        <option value=\"\"><\/option>\n        <option>Delhi<\/option>\n        <option>Mumbai<\/option>\n        <option>Bangalore<\/option>\n        <option>Hyderabad<\/option>\n        <option>Chennai<\/option>\n        <option>Kolkata<\/option>\n        <option>Pune<\/option>\n        <option>Ahmedabad<\/option>\n        <option>Jaipur<\/option>\n        <option>Lucknow<\/option>\n        <option>Chandigarh<\/option>\n        <option>Indore<\/option>\n        <option>Bhopal<\/option>\n        <option>Surat<\/option>\n        <option>Nagpur<\/option>\n        <option>Patna<\/option>\n        <option>Ranchi<\/option>\n        <option>Other<\/option>\n      <\/select>\n    <\/div>\n\n    <!-- Other City -->\n    <div class=\"mrm-field\" id=\"other-city-field\" style=\"display:none;\">\n      <label>Enter Your City<\/label>\n      <input type=\"text\" id=\"otherCityInput\" placeholder=\"Enter your city\">\n    <\/div>\n\n    <div class=\"mrm-field\">\n      <label>Message<\/label>\n      <textarea name=\"contact[body]\" placeholder=\"Write your message here\"><\/textarea>\n    <\/div>\n\n    <button type=\"submit\" class=\"mrm-btn\">Submit<\/button>\n\n  {% endform %}\n\n<\/div>\n\n<script>\n\/\/ City\ndocument.getElementById(\"citySelect\").addEventListener(\"change\", function () {\n  const field = document.getElementById(\"other-city-field\");\n  const input = document.getElementById(\"otherCityInput\");\n\n  if (this.value === \"Other\") {\n    field.style.display = \"block\";\n    input.name = \"contact[City]\";\n    input.required = true;\n  } else {\n    field.style.display = \"none\";\n    input.removeAttribute(\"name\");\n    input.required = false;\n  }\n});\n\n\/\/ Role\ndocument.getElementById(\"roleSelect\").addEventListener(\"change\", function () {\n  const field = document.getElementById(\"other-role-field\");\n  const input = document.getElementById(\"otherRoleInput\");\n\n  if (this.value === \"Other\") {\n    field.style.display = \"block\";\n    input.name = \"contact[Who are you?]\";\n    input.required = true;\n  } else {\n    field.style.display = \"none\";\n    input.removeAttribute(\"name\");\n    input.required = false;\n  }\n});\n<\/script>","custom_class":""}},"rich_text_WMfEpf":{"type":"rich-text","blocks":{"heading_zeVtCL":{"type":"heading","settings":{"heading":"What We’ve Done So Far","heading_size":"h3"}},"text_AkJ3VM":{"type":"text","settings":{"text":"<p>Workshops, literacy sessions, events, and community initiatives happening across India.<\/p>"}}},"block_order":["heading_zeVtCL","text_AkJ3VM"],"custom_css":[".container {margin-bottom: 10px;}"],"name":"Rich text","settings":{"container":"container","color_scheme":"","content_alignment":"center","padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"custom_liquid_98Emqp":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Video Player<\/title>\n    <style>\n\n        .thumbnail-container {\n            display: flex;\n            gap: 10px;\n            overflow-x: auto; \/* Enables horizontal scrolling *\/\n            padding: 10px;\n            scroll-snap-type: x mandatory; \/* Enables scroll snapping *\/\n        }\n\n        \/* Hide scrollbar *\/\n        .thumbnail-container::-webkit-scrollbar {\n            display: none; \/* For WebKit browsers (Chrome, Safari) *\/\n        }\n        .thumbnail-container {\n            -ms-overflow-style: none;  \/* For Internet Explorer and Edge *\/\n            scrollbar-width: none;    \/* For Firefox *\/\n        }\n\n        .thumbnail {\n            position: relative;\n            flex-shrink: 0; \/* Prevents shrinking *\/\n            width: 30vw; \/* 70% of the viewport width *\/\n            height: 30vh; \/* 40% of the viewport height *\/\n            background: #333;\n            border-radius: 8px;\n            overflow: hidden;\n            cursor: pointer;\n            scroll-snap-align: center; \/* Aligns items in the center when scrolling *\/\n        }\n\n        .thumbnail img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .fullscreen-player {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            background-color: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            display: none;\n        }\n\n        .fullscreen-player video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .close-btn {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: rgba(255, 255, 255, 0.8);\n            border: none;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            \/* padding: 10px; *\/\n            font-size: 16px;\n            cursor: pointer;\n            z-index: 2000;\n            justify-content: center;\n            align-items: center;\n            transition: background 0.1s ease-out; \n        }\n\n        .close-btn:hover {\n            background: rgba(117, 117, 117, 0.8);\n        }\n\n        \/* Responsive Styling *\/\n        @media (min-width: 768px) {\n            .thumbnail {\n                width: 100px;\n                height: 200px;\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .thumbnail {\n                width: 150px;\n                height: 300px;\n            }\n        }\n@media(max-width: 767px){\n.thumbnail{\nwidth: 70vw;\nheight: auto;\n}\n}\n    <\/style>\n<\/head>\n<body>\n    <div class=\"thumbnail-container\">\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/887bd9d275b24ac481637a372a0d58ae.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/1_Sapno_Ki_Rani.avifs?v=1732253357\" alt=\"Thumbnail for 1.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/3f0679673be34c0ab4160c8c81362b38.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/2_Growing_Up_Surrounded_by_Books.avifs?v=1732253357\" alt=\"Thumbnail for 2.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/32b40e2913324263a8052788eed28877.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/3_Playing_with_Toys.avifs?v=1732253357\" alt=\"Thumbnail for 3.mp4\">\n        <\/div>\n        <div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/4667aa9c1ac84b5cace8c692a23bbd78.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks4_compressed.avifs?v=1750066995\" alt=\"Thumbnail for 4.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/c732b2070b9645799bac421b8e24a470.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/5_POV_Building_the_Habit_of_Reading.avifs?v=1732253357\" alt=\"Thumbnail for 5.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/12aafa0d1bd74b23b756e325da0f3453.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/6_Book_Toy_Combo.avifs?v=1732253357\" alt=\"Thumbnail for 6.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/27e1f41d919d4019872169b65760b1e1.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks8compressed-ezgif.com-video-to-avif-converter.avifs?v=1750066995\" alt=\"Thumbnail for 7.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/27e1f41d919d4019872169b65760b1e1.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/8_Reading_improves_concentration.avifs?v=1732253357\" alt=\"Thumbnail for 8.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/2ae0436ab3594a82bc5083efc9ced68a.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/9_Weekly_Toys_Play_Schedule.avifs?v=1732253357\" alt=\"Thumbnail for 9.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/3bde7beb0c4f4504bd1331b5bc1cfb9b.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/10_Fun_Comfort_Go_Hand_in_Hand.avifs?v=1732253357\" alt=\"Thumbnail for 10.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/ffa910c4fba7427886be11ebc1590e6b.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/11_neOwn_library_customer_Unboxing.avifs?v=1732253358\" alt=\"Thumbnail for 11.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/e4aa58c2a4534f5fb069e35e95edef1e.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/12_Bath_Books.avifs?v=1732253357\" alt=\"Thumbnail for 12.mp4\">\n        <\/div><div class=\"thumbnail\" data-video=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/eb10be539ec045a5b615ace4d9ff6cfb.mp4\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/workbooks7compressed.avifs?v=1750066995\" alt=\"Thumbnail for 7.mp4\" alt=\"Thumbnail for 13.mp4\">\n        <\/div>\n    <\/div>\n\n    <div class=\"fullscreen-player\" id=\"fullscreen-player\">\n        <button class=\"close-btn\" id=\"close-btn\">✕<\/button>\n        <video id=\"video-player\" controls autoplay><\/video>\n    <\/div>\n\n    <script>\n        const thumbnails = document.querySelectorAll('.thumbnail');\n        const fullscreenPlayer = document.getElementById('fullscreen-player');\n        const videoPlayer = document.getElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        \/\/ Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        \/\/ Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); \/\/ Stop video playback\n            videoPlayer.src = ''; \/\/ Clear video source\n        });\n    <\/script>","custom_class":""}},"rich_text_UHKPdn":{"type":"rich-text","blocks":{"heading_nLaxXj":{"type":"heading","settings":{"heading":"<b>FAQs<\/b>","heading_size":"h2"}}},"block_order":["heading_nLaxXj"],"settings":{"container":"container","color_scheme":"","content_alignment":"center","padding_top":12,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"page_faqs_jY7xLJ":{"type":"page-faqs","blocks":{"accordion_98FnHe":{"type":"accordion","settings":{"title":"How does the Reading Challenge work?","content":"<p>Step 1: Register by filling this form: <a href=\"https:\/\/tinyurl.com\/4j67yx4r\"><span style=\"text-decoration:underline\">https:\/\/tinyurl.com\/4j67yx4r<\/span><\/a>  <\/p><p>Step 2: Request to join the WhatsApp Group (we will approve the request 2-5 days before the upcoming challenge) <\/p><p>Step 3: Read the Challenge Instructions which will be sent on the WhatsApp Group 1 day before the challenge <\/p><p>Step 4: Await Instructions for App Download to track daily reading!<\/p><p>Step 5: Win Certificates & Badges upon successful completion of the challenge <\/p>","open":false}},"accordion_TjN8da":{"type":"accordion","settings":{"title":"How to download the neOwn app?","content":"<p>📲 neOwn App Link: <\/p><p>🔗 Android: <a href=\"https:\/\/play.google.com\/store\/apps\/details?id=com.neown\"><span style=\"text-decoration:underline\">https:\/\/play.google.com\/store\/apps\/details?id=com.neown<\/span><\/a> <\/p><p>🔗 Apple: <a href=\"https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525\"><span style=\"text-decoration:underline\">https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525<\/span><\/a> <\/p>","open":false}},"accordion_XiWthW":{"type":"accordion","settings":{"title":"Do I have to be a neOwn subscriber to join?","content":"<p>No, you don’t have to be a neOwn subscriber to join. Our Reading Challenges are open for all children between the ages of 0-14 years. <\/p>","open":false}},"accordion_wWxapm":{"type":"accordion","settings":{"title":"Can we participate from anywhere in India?","content":"<p>Yes! The challenge is conducted completely online. <\/p>","open":false}},"accordion_fhEYkH":{"type":"accordion","settings":{"title":"What are the rewards for participating in the Reading Challenge?","content":"<p>🏆Certificates (Platinum, Gold, Silver, Bronze)<\/p><p>🎁 Collectible Badges & goodies for Platinum Readers<\/p><p>📱Get Featured on our Instagram & on our website <\/p>","open":false}},"accordion_JGFVja":{"type":"accordion","settings":{"title":"Which age group is this Reading Challenge for?","content":"<p>The reading challenge is for children between the ages of 0-14 years. If your child is not reading independently yet, you can take it on as a challenge to read to them daily! <\/p>","open":false}},"accordion_VUQPmJ":{"type":"accordion","settings":{"title":"Which books have to be read? Can kids read books of their choice, or is any list going to be provided?","content":"<p>Kids can read any books of their choice! For our challenges, the focus is on consistency and habit of reading for 25 mins a day rather than on choice of books <\/p><p>We can share some recommendations, but it’s not necessary to read only from the list of recos. <\/p>","open":false}},"accordion_dXNAQy":{"type":"accordion","settings":{"title":"How will the monitoring be done?","content":"<p>The tracking of 20 mins daily reading has to be done on our app. <\/p><p>As for the books which are being read, we will do a weekly check-in on the WhatsApp Group where parents can share the book names and pics\/short reviews from the kids. <\/p><p>For any add-on challenges like Genre Explorer, Book Bingo, Vocabulary, etc - we share an additional Google Form to take your entries for those. <\/p>","open":false}},"accordion_ikFw3k":{"type":"accordion","settings":{"title":"Where can I see my child’s progress in the Reading Challenge?","content":"<p>You will be able to see your child's progress in the app itself. <\/p>","open":false}},"accordion_gdKihh":{"type":"accordion","settings":{"title":"I’m unable to join the Reading Challenge group, what do I do?","content":"<p>You will initially have to request to join the group and you will be added to the group 2-5 days before the next challenge begins. <\/p>","open":false}},"accordion_An7P48":{"type":"accordion","settings":{"title":"My child is under 5 years old and is not an independent reader yet. Can they participate in the Reading Challenge? How will they participate?","content":"<p>Yes, they can definitely participate! You can take it on as a challenge to read to them daily! The continued exposure and habit will help him to practice and improve their reading skills. <\/p>","open":false}},"accordion_hkpzbC":{"type":"accordion","settings":{"title":"My child is learning to read currently. How can I help her to succeed in the Reading Challenge?","content":"<p>We would suggest starting out by sitting and reading with them to slowly build their confidence in reading. For the first few days you can do reading for the entire Challenge time together. Then move on to reading for 10-15 mins together and letting her read independently for 10-15 mins for a few more days. And then finally she can attempt to do the Challenge’s full daily reading time independently! <\/p><p>Another way would be to give them books that are more simple than what they are used to. This will also help them practice the basics of reading and gain the confidence to read more! Then, you can slowly increase the difficulty level of the books.<\/p>","open":false}},"accordion_CDDD3E":{"type":"accordion","settings":{"title":"Do I have to read for the entire daily time in one go OR can I break it up throughout the day?","content":"<p>You can break it up or do it all in one go! As long as reading for the minimum daily time is done consistently. <\/p>","open":false}},"accordion_yfMLJP":{"type":"accordion","settings":{"title":"Can my child read at any time in the day?","content":"<p>Your child can read any time during the day, and you can mark their reading in the challenge at your convenience.<\/p>","open":false}},"accordion_mQpgdp":{"type":"accordion","settings":{"title":"Can I log my child's reading late in the night, in case I only get free at that time?","content":"<p>Yes, the daily poll will be active for the entire day + for the 2 following days, in case you forget to vote on any day. <\/p>","open":false}},"accordion_PAKXyM":{"type":"accordion","settings":{"title":"Do I need to record a video of my child reading?","content":"<p>No video recording is needed for the basic level of the challenge. You can vote on the app to track your child's daily reading. We will do a weekly check-in on the WhatsApp Group where parents can share the book names and pics\/short reviews of the books from the kids. <\/p>","open":false}},"accordion_rF4wgm":{"type":"accordion","disabled":true,"settings":{"title":"Can I cancel the Library Subscription at any time?","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on +91 91370 81640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","open":false}}},"block_order":["accordion_98FnHe","accordion_TjN8da","accordion_XiWthW","accordion_wWxapm","accordion_fhEYkH","accordion_JGFVja","accordion_VUQPmJ","accordion_dXNAQy","accordion_ikFw3k","accordion_gdKihh","accordion_An7P48","accordion_hkpzbC","accordion_CDDD3E","accordion_yfMLJP","accordion_mQpgdp","accordion_PAKXyM","accordion_rF4wgm"],"settings":{"headingsec":"","container":"container","color_scheme":"","menu":"","custom_class":""}},"custom_liquid_bjkGf8":{"type":"custom-liquid","disabled":true,"custom_css":[],"settings":{"custom_liquid":"<title>Responsive Div<\/title>\n    <style>\n        body {\n            margin: 0;\n            font-family: \"DM Sans\", sans-serif;\n            background-color: #f0f0f0;\n        }\n        .container-chat {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            \/* min-height: 100vh; *\/\n            padding: 20px;\n            background-color: #ffffff;\n        }\n        .content-chat {\n            background: linear-gradient(to bottom, #7A62E4, #a32ed5);\n            border-radius: 20px;\n            text-align: center;\n            padding: 90px;\n            max-width: 1200px;\n            width: 100%;\n            color: white;\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n        }\n        .content-chat h1 {\n            font-size: 28px;\n            color: #ffffff;\n            margin-bottom: 20px;\n        }\n        .content-chat p {\n            margin: 10px 0;\n            font-size: 18px;\n        }\n        .content-chat a {\n            display: inline-block;\n            background: white;\n            color: #EB5CE8;\n            padding: 15px 30px;\n            border-radius: 50px;\n            text-decoration: none;\n            font-weight: bold;\n            transition: background 0.3s, color 0.3s;\n            margin-top: 20px;\n        }\n        .content-chat a:hover {\n            background: #EB5CE8;\n            color: white;\n        }\n        @media (max-width: 600px) {\n            .content-chat {\n                padding: 20px;\n            }\n            .content-chat h1 {\n                font-size: 22px;\n            }\n            .content-chat p {\n                font-size: 16px;\n            }\n            .content-chat a {\n                padding: 10px 20px;\n                font-size: 16px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"container-chat\">\n        <div class=\"content-chat\">\n            <h1>Still not convinced?<\/h1>\n            <p>Join our FREE Parents’ Community on WhatsApp<\/p>\n            <p>📚 Kids Sessions: Online book club, storytelling, & creative writing<\/p>\n            <p>💡 Monthly Reading Challenges<\/p>\n            <p>💬 Q&A sessions with experts<\/p>\n            <a href=\"https:\/\/chat.whatsapp.com\/Ixt3hz8fc6g6digIYWBeOj\">Join Now<\/a>\n        <\/div>\n    <\/div>\n<\/body>","custom_class":""}}},"order":["main","slider_nk8kRa","million_reader_cyB8Rm","scroll_image_content_94zFDw","rich_text_tp3n9k","scrolling_promotion_XreH74","empty_space_jJDn9h","brands_list_JKyRzD","rich_text_Q3B6ac","custom_liquid_BMd3Hp","custom_liquid_3HL9Cg","rich_text_WMfEpf","custom_liquid_98Emqp","rich_text_UHKPdn","page_faqs_jY7xLJ","custom_liquid_bjkGf8"]}