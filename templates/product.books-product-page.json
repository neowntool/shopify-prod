    "custom_liquid_UnKQ8p": {
      "type": "custom-liquid",
      "custom_css": [],
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    #testimonials-container {\n      width: 90%;\n      margin: 0 auto;\n      font-family: \"DM Sans\", sans-serif;\n      font-weight: 400;\n      font-style: normal;\n    }\n\n    #testimonials-list {\n      list-style-type: none;\n      padding: 0;\n    }\n\n    .testimonial-item {\n      display: flex;\n      flex-direction: column;\n      margin-bottom: 20px;\n      border: 1px solid #ddd;\n      padding: 10px;\n      border-radius: 5px;\n    }\n\n    .review-content {\n      flex-grow: 1;\n    }\n\n    .review-header {\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n    }\n\n    .review-name {\n      margin-left: 10px;\n      font-style: italic;\n    }\n\n    .checkmark {\n      color: green;\n      margin-left: 5px;\n    }\n\n    .stars {\n      color: gold;\n      margin-left: 10px;\n    }\n\n    .review-body {\n      margin-top: 5px;\n    }\n\n    #pagination {\n      text-align: center;\n      margin-top: 20px;\n    }\n\n    #pagination button {\n      padding: 10px 20px;\n      margin: 0 5px;\n      background-color: #007bff;\n      color: #fff;\n      border: none;\n      border-radius: 5px;\n      cursor: pointer;\n    }\n\n    #pagination button:disabled {\n      background-color: #ccc;\n      cursor: not-allowed;\n    }\n  </style>\n</head>\n<body>\n\n<div id=\"testimonials-container\">\n  <ul id=\"testimonials-list\"></ul>\n  <div id=\"pagination\">\n    <button id=\"prev-page\" onclick=\"changePage(-1)\" disabled><</button>\n    <span id=\"page-info\"></span>\n    <button id=\"next-page\" onclick=\"changePage(1)\">></button>\n  </div>\n</div>\n\n<script>\n  const testimonials = [\n    // Sample testimonials data\n    {\n      header: \"Perfect books for my daughter\",\n      name: \"Neha Mathur\",\n      verified: true,\n      stars: 5,\n      body: \"Thank you so much neOwn for recommending the perfect books to my daughter, according to her interest.\"\n    },\n    {\n      header: \"The quality of books are really good\",\n      name: \"Parul Jalan\",\n      verified: true,\n      stars: 5,\n      body: \"The process has also been very very smooth And my daughter really enjoyed reading all of them\"\n    },\n    // Add more testimonials as needed\n    {\n      header: \"Seeing improvement in vocabulary, knowledge\",\n      name: \"Tara Baluwala\",\n      verified: true,\n      stars: 4,\n      body: \"My child really enjoys reading and she is able to find all the kind of books she wants at neOwn. I can see that she is improving her vocabulary, knowledge, etc.The experience has been very nice.\"\n    },\n    {\n      header: \"My young one loved the touch-n-feel books\",\n      name: \"Bhavna Juthani\",\n      verified: true,\n      stars: 4,\n      body: \"The best part I liked is the drop n pick up service where parents of nuclear family like me is all that we need 😇 My young one loved the touch n feel books she wants the same book, no matter how many times she might have seen it 😀\"\n    },\n    {\n      header: \"I love neOwn!!\",\n      name: \"Rashmi Tibrewala\",\n      verified: true,\n      stars: 5,\n      body: \"It truly helped me in making my child start reading.\"\n    },\n    {\n      header: \"Virtual library has been good option\",\n      name: \"Vanshika Sethi\",\n      verified: true,\n      stars: 4,\n      body: \"Library is a comfort place for my daughter and this virtual library has been good option for her virtually She got to read quite a few books through the last 3 months We celebrated her bday recently with Library theme, it being her favourite place with books around her\"\n    },\n    {\n      header: \"My son loved the books\",\n      name: \"Amruta Samant\",\n      verified: true,\n      stars: 5,\n      body: \"In his excitement, he powered through all 5 books in a week.😊\"\n    },\n    {\n      header: \"I can see improvement 😊\",\n      name: \"Parul Jalan\",\n      verified: true,\n      stars: 5,\n      body: \"The books are in great condition and the availability of books at the time of selection is also too good. I can see improvement in my child’s focus on reading. She has started reading chapter books. And she enjoys the books she gets😊\"\n    },\n    {\n      header: \"Thanks for the wonderful picks\",\n      name: \"Anusha Gamidi\",\n      verified: false,\n      stars: 5,\n      body: \"She is so excited as usual to see the new books😃😃😃 Not just my daughter, I too am enjoying reading these books\"\n    },\n    {\n      header: \"Love the concept\",\n      name: \"Bhagyashree Gogte\",\n      verified: true,\n      stars: 4,\n      body: \"I am really happy with your services and I just love your concept of sharing resources.\"\n    }\n  ];\n\n  const reviewsPerPage = 4;\n  let currentPage = 1;\n\n  function renderTestimonials() {\n    const start = (currentPage - 1) * reviewsPerPage;\n    const end = start + reviewsPerPage;\n    const paginatedReviews = testimonials.slice(start, end);\n    \n    const testimonialsList = document.getElementById('testimonials-list');\n    testimonialsList.innerHTML = \"\";\n\n    paginatedReviews.forEach(review => {\n      const testimonialItem = document.createElement('li');\n      testimonialItem.className = 'testimonial-item';\n\n      const reviewContent = document.createElement('div');\n      reviewContent.className = 'review-content';\n\n      const reviewHeader = document.createElement('div');\n      reviewHeader.className = 'review-header';\n      reviewHeader.textContent = review.header;\n\n      const reviewName = document.createElement('span');\n      reviewName.className = 'review-name';\n      reviewName.textContent = `- ${review.name}`;\n\n      if (review.verified) {\n        const checkmark = document.createElement('span');\n        checkmark.className = 'checkmark';\n        checkmark.textContent = '✔️';\n        reviewHeader.appendChild(checkmark);\n      }\n\n      const stars = document.createElement('span');\n      stars.className = 'stars';\n      stars.textContent = '★'.repeat(review.stars);\n      reviewHeader.appendChild(stars);\n      reviewHeader.appendChild(reviewName);\n\n      const reviewBody = document.createElement('div');\n      reviewBody.className = 'review-body';\n      reviewBody.textContent = review.body;\n\n      reviewContent.appendChild(reviewHeader);\n      reviewContent.appendChild(reviewBody);\n\n      testimonialItem.appendChild(reviewContent);\n      testimonialsList.appendChild(testimonialItem);\n    });\n\n    document.getElementById('page-info').textContent = `Page ${currentPage} of ${Math.ceil(testimonials.length / reviewsPerPage)}`;\n    document.getElementById('prev-page').disabled = currentPage === 1;\n    document.getElementById('next-page').disabled = currentPage === Math.ceil(testimonials.length / reviewsPerPage);\n  }\n\n  function changePage(direction) {\n    currentPage += direction;\n    renderTestimonials();\n  }\n\n  document.addEventListener('DOMContentLoaded', renderTestimonials);\n</script>\n\n</body>\n</html>",
        "custom_class": ""
      }
    },
