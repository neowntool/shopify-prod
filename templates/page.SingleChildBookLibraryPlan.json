x;\n}\n\n.np-card {\n  max-width: 420px;\n}\n\n.np-title {\n  font-size: 32px;\n  font-weight: 800;\n  margin-bottom: 10px;\n}\n\n.np-subtitle {\n  font-size: 14px;\n  margin-bottom: 24px;\n}\n\n.np-feature {\n  position: relative;\n  padding-left: 0px;\n  margin-bottom: 22px;\n}\n\n.np-dot {\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  position: absolute;\n  left: 100;\n  top: -5px;\nright: 0;\n}\n\n.np-line {\n  height: 2px;\n  width: 100%;\n  margin-bottom: 8px;\n}\n\n.np-feature h3 {\n  margin: 6px 0 4px;\n  font-size: 16px;\n}\n\n.np-feature p {\n  font-size: 13px;\n  margin: 0;\n}\n\n.np-pink { background: #ff2f92; }\n.np-pink-line { background: #ff2f92; }\n\n.np-yellow { background: #f5d400; }\n.np-yellow-line { background: #f5d400; }\n\n.np-purple { background: #7b4bff; }\n.np-purple-line { background: #7b4bff; }\n\n.np-blue { background: #28d7ff; }\n.np-blue-line { background: #28d7ff; }\n\n.np-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 24px;\n}\n\n.np-buttons img {\n  height: 38px;\n  margin-right: 8px;\n}\n\n.np-buttons{\ndisplay: flex;\n}\n.np-qr img {\n  width: 110px;\n  height: 110px;\n}\n</style>",
