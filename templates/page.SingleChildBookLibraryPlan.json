store p {\n  font-size: 13px;\n  margin-bottom: 6px;\n}\n\n.np2-store-btns img {\n  height: 34px;\n  margin-right: 6px;\n}\n\n.np2-or {\n  font-size: 14px;\n  font-weight: bold;\n}\n\n.np2-qr img {\n  width: 110px;\n  height: 110px;\n}\n@media(max-width: 767px){\n.np2-wrapper{\npadding: 0px;\n}\n.np2-footer{\ndisplay: none;\n}\n.np2-title{\ntext-align: center;\n}\n}\n</style>",
