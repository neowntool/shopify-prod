e":"collection_block","settings":{"collection":"0-2-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_0-2.png"}},"collection_block_tNjUKq":{"type":"collection_block","settings":{"collection":"3-5-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_3-5.png"}},"collection_block_4yk9Yy":{"type":"collection_block","settings":{"collection":"6-8-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_6-8.png"}},"collection_block_dTRXAa":{"type":"collection_block","settings":{"collection":"9-12-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_9-12.png"}},"collection_block_JHEWtC":{"type":"collection_block","settings":{"collection":"13-16-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_13-16.png"}},"collection_block_reie48":{"type":"collection_block","settings":{"collection":"16-years","title":"","item_image":"shopify:\/\/shop_images\/2.1.9_16.png"}}},"block_order":["collection_block_Hja69g","collection_block_tNjUKq","collection_block_4yk9Yy","collection_block_dTRXAa","collection_block_JHEWtC","collection_block_reie48"],"custom_css":["@media screen and (max-width: 767px) {.m-mixed-layout--mobile-grid {--grid-columns-mobile: 3; }}"],"settings":{"heading":"Book Collections by age","heading_size":"h3","subheading":"","description":"","header_alignment":"center","color_scheme":"","container":"container-fluid","layout":"grid","expanded":true,"card_style":"standard","text_alignment":"center","hover_effect":"scaling-down","show_product_count":false,"count_inline_title":false,"image_rounded":true,"items_per_row":6,"item_gap":30,"enable_slider":false,"show_pagination":false,"show_navigation":false,"autorotate":false,"autorotate_speed":5,"mobile_disable_slider":true,"use_scroll_mobile":false,"mobile_gap":10,"hidden_slide_control_mobile":false,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"collapsible_tabs_mPcRRM":{"type":"collapsible-tabs","blocks":{"item_RdkBYb":{"type":"item","settings":{"header":"Do you deliver all over India? ","text_size":"h5","content":"<p>Currently, we only deliver books all over India. <\/p><p>Delivery is free within Mumbai, Thane, Navi Mumbai, and Mira-Bhayander. <\/p><p>Outside Mumbai: There is an additional delivery charge for Book Library deliveries outside Mumbai. <\/p><p>(Toy Library is only operating in Mumbai as of now) <\/p>","content_page":"","open":false}},"item_z4mXU7":{"type":"item","settings":{"header":"How does the Library Subscription work? ","text_size":"h5","content":"<p>Step 1: 📚🧸You can subscribe to any plan from our website. <\/p><p>Step 2: 📲Download the neOwn app to select your books. <\/p><p>Step 3: 📦Books will be delivered and the pickup and exchange will happen after maximum 30 days<\/p><p>Step 4: 🔁Finally you return and repeat the same for all the following months of your subscription!<\/p>","content_page":"","open":false}},"item_Ghtyna":{"type":"item","settings":{"header":"How can I select my books? ","text_size":"h5","content":"<p>Once you have subscribed, you can download our app📲 from which you can select the books 📚<\/p><p>You can select any books of your choice, and in case you are not sure what to pick we have a book expert in-house who can help you out if needed 💖<\/p>","content_page":"","open":false}},"item_WdCHmi":{"type":"item","settings":{"header":"How to download the neOwn app? ","text_size":"h5","content":"<p>📲 neOwn App Link: <\/p><p>🔗 Android: <a href=\"https:\/\/play.google.com\/store\/apps\/details?id=com.neown\"><span style=\"text-decoration:underline\">https:\/\/play.google.com\/store\/apps\/details?id=com.neown<\/span><\/a> <\/p><p>🔗 Apple: <a href=\"https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525\"><span style=\"text-decoration:underline\">https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525<\/span><\/a> <\/p>","content_page":"","open":false}},"item_8MqHRj":{"type":"item","settings":{"header":"What if I damage a Library Book? What if I lose a Library Book? ","text_size":"h5","content":"<p>If the damage is minor and can be repaired by us, there will be no additional charge to you.<\/p><p>If the damage is major such that it cannot be circulated anymore, or if the book is lost\/misplaced, we will charge you 40% of the MRP of the item (and you can keep the item).<\/p><p>neOwn trusts moms to take the utmost care of books so that we can all collectively enjoy them!<\/p>","content_page":"","open":false}},"item_kYA9Xf":{"type":"item","settings":{"header":"Is there any deposit or registration fee?","text_size":"h5","content":"<p>No, there is no deposit or registration fee. <\/p>","content_page":"","open":false}},"item_h6kw34":{"type":"item","settings":{"header":"Do I get to choose my books or do you send pre-curated books? ","text_size":"h5","content":"<p>You can choose your books! If you require any help with selection, you can take recommendations from our in-house book expert. <\/p>","content_page":"","open":false}},"item_aNDH8U":{"type":"item","settings":{"header":"There’s no place to enter my child’s details on the website, how will you know what kind of books I want? ","text_size":"h5","content":"<p>Our app asks for all these details to create a profile for your child. <\/p><p>Once you subscribe to any plan, you have to log in to our neOwn App to select your books. <\/p><p>Before you can view the catalog on the app, you have to enter all your child’s details - including their age, so that we can provide an age-appropriate catalog for them. <\/p>","content_page":"","open":false}},"item_4M43QA":{"type":"item","disabled":true,"settings":{"header":"Can I see your collection before subscribing? What kind of books do you have? ","text_size":"h5","content":"<p>Yes, you can see our collections here: <\/p><p>Book Collection: <\/p><p>We keep a very wide variety of fiction books for children between the ages of 0-15 years, and we also have a lot of non-fiction and educational books for children between the ages of 0-15 years. <\/p>","content_page":"","open":false}},"item_Uq9Rfr":{"type":"item","settings":{"header":"Can I get books for both my children in one library subscription, or do I need to subscribe to the ‘2 Siblings’ plan? ","text_size":"h5","content":"<p>No, you cannot get books for both children in one library subscription. You can subscribe to the ‘2 Siblings’ plan to get books for both your children, where you can get 3 books for each child or 5 books for each child. The reason for this is that we create a unique profile for each child with all their details and provide an age-appropriate curated catalog of books to choose from. This will enable you to see each child’s unique progress as well as all the books they have read in a more organised manner. <\/p>","content_page":"","open":false}},"item_9dML8g":{"type":"item","settings":{"header":"How do you sanitize the books? ","text_size":"h5","content":"<p>Our process to ensure the books are hygenic and in good condition: <\/p><ul><li>⁠We do a thorough check of all books twice - once after they have come back from customers and the second time before they are going to another customer <\/li><li>⁠⁠We also clean board books to ensure they are 100% sanitary <\/li><li>⁠⁠If any books are of bad quality we don't circulate them among customers anymore<\/li><\/ul>","content_page":"","open":false}},"item_7giwLe":{"type":"item","settings":{"header":"If I subscribe today, will my 30 days start now? ","text_size":"h5","content":"<p>No, your 30 days will start after the books have been delivered to you. <\/p><p>Once you subscribe, you have to download our app to select your books. After selection, they will be delivered in 2-5 days within Mumbai and 4-8 days outside Mumbai. <\/p><p>Your 30 days start from the day when the books are delivered. <\/p>","content_page":"","open":false}},"item_7HnUMH":{"type":"item","settings":{"header":"What are the shipping charges for outstation? ","text_size":"h5","content":"<p>The shipping charges for out-of-Mumbai deliveries are as follows: <\/p><p><strong>Plan Name<\/strong><\/p><p><strong>Number of items per month <\/strong><\/p><p><strong>Outside Mumbai Shipping Charge <\/strong><\/p><p>Book Library (1 child)<\/p><p>5 books per month<\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (3+3 Plan)<\/p><p>3+3 (total 6) books per month <\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (5+5 Plan)<\/p><p>5+5 books (total 10) per month<\/p><p>₹200\/- per month<\/p><p>Currently our Toy Library is only being serviced in Mumbai, Navi Mumbai, & Thane. <\/p>","content_page":"","open":false}},"item_QK6PYx":{"type":"item","settings":{"header":"My pin code is showing not serviceable. What do I do? ","text_size":"h5","content":"<p>We may still be able to deliver to you! WhatsApp us at +91 9137081640 and let us know your pin code, we’ll inform you if your area is serviceable. <\/p>","content_page":"","open":false}},"item_rrAeTE":{"type":"item","settings":{"header":"How do I return the Library books? ","text_size":"h5","content":"<p>Once you are done reading the books, you can select ‘Done Reading’ on our app. Then you have to select your next set of books. Once the next set is confirmed, our team will schedule a delivery for the new items and a pickup to return the old books. The return process is as follows: We’ll send our delivery partner directly to your doorstep for the pickup of the books. You’ll be notified of the timelines, and you can keep the books packed for when it's time for the pickup.<\/p>","content_page":"","open":false}},"item_i8tCm9":{"type":"item","settings":{"header":"Do you have other languages books?","text_size":"h5","content":"<p>Yes! We also have a limited collection of books in Hindi, Marathi, and Gujarati. <\/p>","content_page":"","open":false}},"item_X7TPNQ":{"type":"item","settings":{"header":"Can I cancel the Library Subscription at any time? ","text_size":"h5","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on 9137081640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","content_page":"","open":false}}},"block_order":["item_RdkBYb","item_z4mXU7","item_Ghtyna","item_WdCHmi","item_8MqHRj","item_kYA9Xf","item_h6kw34","item_aNDH8U","item_4M43QA","item_Uq9Rfr","item_9dML8g","item_7giwLe","item_7HnUMH","item_QK6PYx","item_rrAeTE","item_i8tCm9","item_X7TPNQ"],"settings":{"container":"container","color_scheme":"","image_position":"left","column_gap":100,"heading":"FAQs","heading_size":"h3","subheading":"","description":"","header_alignment":"center","padding_top":0,"padding_bottom":0,"animations":"inherit","custom_class":""}},"custom_code_QnxVk7":{"type":"custom-code","disabled":true,"custom_css":[],"settings":{"custom_css":".m-price {\n  visibility: hidden;\n}"}}},"order":["collection-header","slider_MQbpNN","main","featured_collection_eP3MNb","featured_collection_gbNdcX","empty_space_9zEXCC","custom_liquid_JBN9pi","rich_text_DcmpYe","custom_liquid_na4jVf","brands_list_NUdj3b","image_with_text_2_nKJgyg","collection_list_xTeMyt","collapsible_tabs_mPcRRM","custom_code_QnxVk7"]}