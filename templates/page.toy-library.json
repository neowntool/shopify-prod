    "lp1faq_WnmBNx": {
      "type": "lp1faq",
      "blocks": {
        "faq_WtHpd8": {
          "type": "faq",
          "settings": {
            "question": "How does the Toy/Combo subscription work?",
            "answer": "<p>Toys/Books are exchanged every 30 days as a part of this plan. You can keep each set only for a maximum of 30 days. The total number of exchanges depends on the duration of your chosen plan.</p>"
          }
        },
        "faq_Tl2DfS": {
          "type": "faq",
          "settings": {
            "question": "How does the Double the Fun Toy subscription work?",
            "answer": "<p>4 toys are exchanged every 15 days as a part of this plan. You can keep each set only for a maximum of 15 days.</p><p>The total number of exchanges depends on the duration of your chosen plan&nbsp;<br/>(3 month plan = 6 exchanges, 6 month plan = 12 exchanges and 12 month plan = 24 exchanges)<br/><br/></p>"
          }
        },
        "faq_Dc3FcB": {
          "type": "faq",
          "settings": {
            "question": "How does the Double the Fun Combo subscription work?",
            "answer": "<p>3 toys and 3 books are exchanged every 15 days as a part of this plan. You can keep each set only for a maximum of 15 days.</p><p>The total number of exchanges depends on the duration of your chosen plan&nbsp;<br/>(3 month plan = 6 exchanges, 6 month plan = 12 exchanges and 12 month plan = 24 exchanges)<br/><br/></p>"
          }
        },
        "faq_Sl0TbK": {
          "type": "faq",
          "settings": {
            "question": "How do I select toys and books?",
            "answer": "<p>Once you have subscribed, you can download our app from which you can select the Toys and books&nbsp;</p><p>You can select any toys and books of your choice, and in case you are not sure what to pick we have a toy expert in-house who can help you out if needed&nbsp;</p>"
          }
        },
        "faq_Cs4StD": {
          "type": "faq",
          "settings": {
            "question": "If I subscribe today, when will my cycle start?",
            "answer": "<p>Your cycle will start after the set of toys/books have been delivered to you.</p>"
          }
        },
        "faq_Pe2DpC": {
          "type": "faq",
          "settings": {
            "question": "Do I have to pay extra money for delivery/pickup?",
            "answer": "<p>No, delivery and pickup cost is included in the plan cost that you pay at the time of subscription.</p>"
          }
        },
        "faq_Dm6TgD": {
          "type": "faq",
          "settings": {
            "question": "What happens if a toy gets damaged?",
            "answer": "<p>If the damage is minor and can be repaired by us, there will be no additional charge to you.</p><p>If the damage is major such that it cannot be circulated anymore, or if the toy/book is lost/misplaced, we will charge you 40% of the MRP of the item (and you can keep the item).</p>"
          }
        },
        "faq_Pd1HpN": {
          "type": "faq",
          "settings": {
            "question": "How will pick-up & drop happen?",
            "answer": "<p>Select your next set of toys and books on the app, and we’ll schedule the delivery of your new set along with the pickup of your current set.</p>"
          }
        },
        "faq_Sh4HgN": {
          "type": "faq",
          "settings": {
            "question": "Are the toys safe and hygienic?",
            "answer": "<p>Our team physically sanitizes each board book and toy twice, once before sending it out and second after it reaches our office.</p>"
          }
        },
        "faq_By7TlL": {
          "type": "faq",
          "settings": {
            "question": "Can I buy the toy from your library?",
            "answer": "<p>No, we don’t sell our library toys.</p>"
          }
        },
        "faq_Ag5GpQ": {
          "type": "faq",
          "settings": {
            "question": "What age group do you cater to?",
            "answer": "<p>We cater toys to children aged 6 months to 8 years</p>"
          }
        },
        "faq_Sd8PsT": {
          "type": "faq",
          "settings": {
            "question": "Is there a security deposit?",
            "answer": "<p>No, there is no deposit or registration fee.</p>"
          }
        },
        "faq_Dl9OcY": {
          "type": "faq",
          "settings": {
            "question": "Do you deliver outside Mumbai?",
            "answer": "<p>Currently, Toy/Combo delivery is available only within Mumbai, Navi Mumbai and Thane city.</p>"
          }
        },
        "faq_Cd3WsP": {
          "type": "faq",
          "settings": {
            "question": "Why should I rent toys instead of buying them?",
            "answer": "<p>Renting toys gives your child access to a variety of age-appropriate toys while saving money, reducing clutter, encouraging learning, and promoting sustainability.&nbsp;</p>"
          }
        }
      },
