    "lp1faq_kwWx7N": {
      "type": "lp1faq",
      "blocks": {
        "faq_sipHow1": {
          "type": "faq",
          "settings": {
            "question": "How does the Neown Reading SIP work?",
            "answer": "<p>Pick a monthly plan of 3, 5 or 10 books and set up Autopay once. Every month you choose your child's books in the neOwn app, we deliver them to your door, and pick up the previous set when it's time to swap. No deposit needed.</p>"
          }
        },
        "faq_qt9Q8z": {
          "type": "faq",
          "settings": {
            "question": "How many books do I get, and how long can I keep them?",
            "answer": "<p>You get 3, 5 or 10 books every month, depending on your plan (on the Sibling Plan, that's for each child). Your monthly reading cycle starts on the day your books are delivered, and you can keep each set for up to 30 days before swapping it for a new one.</p>"
          }
        },
        "faq_sipPay1": {
          "type": "faq",
          "settings": {
            "question": "When and how will I be charged?",
            "answer": "<p>Your first month is charged when you set up Autopay. After that, the same amount is debited automatically every month on the same date, and you'll get a reminder before every debit.</p><p>You can pay with UPI Autopay from any UPI app that supports it, or with a debit/credit card. Payments are processed securely by Razorpay.</p>"
          }
        },
        "faq_fjYpqm": {
          "type": "faq",
          "settings": {
            "question": "How do I choose the books?",
            "answer": "<p>Once you subscribe, download the neOwn app and log in with the same mobile number. You can choose any books from the catalogue, and our in-house book experts are happy to help if you're not sure what to pick.</p><p>If you don't choose within 3 days, our team will curate a set for your child.</p>"
          }
        },
        "faq_sipSib1": {
          "type": "faq",
          "settings": {
            "question": "How does the Sibling Plan work?",
            "answer": "<p>The Sibling Plan covers 2 children. Each child gets their own 3, 5 or 10 books every month, and you choose books for each child separately in the app.</p>"
          }
        },
        "faq_NYiTha": {
          "type": "faq",
          "settings": {
            "question": "How do delivery and pickup work?",
            "answer": "<p>Delivery and pickup are free all over India. When you select your next set in the app, our team confirms it and schedules the delivery of the new books along with the pickup of the previous set.</p>"
          }
        },
        "faq_CmFcBA": {
          "type": "faq",
          "settings": {
            "question": "Can I cancel anytime? Is there a lock-in?",
            "answer": "<p>There's no lock-in, and you can cancel anytime. Just <a href=\"https://api.whatsapp.com/send/?phone=919324455972&text=Hi%2C+I+have+a+question+about+my+Neown+Reading+SIP&type=phone_number&app_absent=0\" target=\"_blank\">message us on WhatsApp</a> and we'll cancel your SIP. No further payments are taken, and we'll pick up the books at the end of your current cycle.</p>"
          }
        },
        "faq_sipFail": {
          "type": "faq",
          "settings": {
            "question": "What if a monthly payment fails?",
            "answer": "<p>Autopay retries the payment automatically over the next few days, so please keep enough balance in the linked account or card. If it still doesn't go through, your SIP is paused and we'll help you set up Autopay again.</p>"
          }
        },
        "faq_sipChg1": {
          "type": "faq",
          "settings": {
            "question": "Can I change my plan later?",
            "answer": "<p>Yes. Plan changes aren't available in the app yet, so just <a href=\"https://api.whatsapp.com/send/?phone=919324455972&text=Hi%2C+I+have+a+question+about+my+Neown+Reading+SIP&type=phone_number&app_absent=0\" target=\"_blank\">message us on WhatsApp</a> and our team will switch it for you.</p>"
          }
        },
        "faq_jGxKWL": {
          "type": "faq",
          "settings": {
            "question": "What if a book gets damaged or lost?",
            "answer": "<p>Minor damage: no charge.<br/>Major damage or a lost book: pay 40% of the book's MRP, and you can keep the book forever.</p>"
          }
        },
        "faq_CpLhHW": {
          "type": "faq",
          "settings": {
            "question": "Are the books clean and hygienic?",
            "answer": "<p>Yes. Here's how we keep every book hygienic and in good condition:</p><ul><li>We check every book twice: once when it comes back from a family, and again before it goes to the next one.</li><li>Board books are cleaned so they're 100% sanitary.</li><li>Books in poor condition are taken out of circulation.</li></ul>"
          }
        },
        "faq_VnpXaE": {
          "type": "faq",
          "settings": {
            "question": "My child is glued to screens. Will this even work?",
            "answer": "<p>That's exactly who neOwn is for. Regular access to physical books, chosen by the child in our app, gradually shifts the balance away from screens. Letting kids pick their own books is key.</p>"
          }
        },
        "faq_3CgqnH": {
          "type": "faq",
          "settings": {
            "question": "What if my child doesn't read the books?",
            "answer": "<p>Most kids start slow — that's perfectly normal. The physical presence of books at home is what starts the habit. New books every month keep curiosity alive. 85% of 3-month subscribers become consistent readers by the end of their plan.</p>"
          }
        },
        "faq_6jrEpL": {
          "type": "faq",
          "settings": {
            "question": "How do I download the neOwn app?",
            "answer": "<p>Android: <a href=\"https://play.google.com/store/apps/details?id=com.neown\" target=\"_blank\">Get it on Google Play</a><br/>iPhone: <a href=\"https://apps.apple.com/in/app/neown/id6483860525\" target=\"_blank\">Download on the App Store</a></p>"
          }
        }
      },
