    "lpl_faq": {
      "type": "lpl-faq",
      "settings": {},
      "blocks": {
        "lpl_faq_0": {
          "type": "question",
          "settings": {
            "question": "Do you deliver all over India?",
            "answer": "<p>Our Book Library delivers all over India. Delivery is free within Mumbai, Thane, Navi Mumbai and Mira-Bhayander; outside Mumbai there is an additional delivery charge.</p>"
          }
        },
        "lpl_faq_1": {
          "type": "question",
          "settings": {
            "question": "How does the library subscription work?",
            "answer": "<ol><li>Start the monthly plan on our website.</li><li>Download the neOwn app to select your books.</li><li>They're delivered to you, and pickup &amp; exchange happens after a maximum of 30 days.</li><li>Return and repeat every month of your subscription!</li></ol>"
          }
        },
        "lpl_faq_2": {
          "type": "question",
          "settings": {
            "question": "How can I select my books?",
            "answer": "<p>Once you've subscribed, download our app and pick any books you like. Not sure what to choose? Get free recommendations on WhatsApp.</p><p>Delivery takes 2–5 days within Mumbai and 4–8 days outside Mumbai.</p>"
          }
        },
        "lpl_faq_3": {
          "type": "question",
          "settings": {
            "question": "Is there any deposit or registration fee?",
            "answer": "<p>No — there is no deposit or registration fee.</p>"
          }
        },
        "lpl_faq_4": {
          "type": "question",
          "settings": {
            "question": "Do you give refunds?",
            "answer": "<p>Refunds are not provided. In an exceptional case where there's an error on neOwn's part and your subscription hasn't started yet, a refund may be issued at neOwn's discretion.</p>"
          }
        },
        "lpl_faq_5": {
          "type": "question",
          "settings": {
            "question": "What age groups do you cater to?",
            "answer": "<p>Books for every age from 0 to 15 years.</p>"
          }
        },
        "lpl_faq_6": {
          "type": "question",
          "settings": {
            "question": "What if a book gets damaged?",
            "answer": "<p>If the damage is minor and we can repair it, there's no charge. If it can't be circulated anymore, or is lost, we charge 40% of the MRP and you can keep the item.</p>"
          }
        },
        "lpl_faq_7": {
          "type": "question",
          "settings": {
            "question": "Are the books clean?",
            "answer": "<p>All books, including board books, are cleaned by our team before and after every delivery so they're 100% sanitary. Every book is checked twice, and anything in poor condition is taken out of circulation.</p>"
          }
        }
      },
