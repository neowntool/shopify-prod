    "custom_liquid_dcMqzj": {
      "type": "custom-liquid",
      "name": "Custom liquid",
      "settings": {
        "custom_liquid": "<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Video Player</title>\n    <style>\n\n        .thumbnail-container {\n            display: flex;\n            gap: 10px;\n            overflow-x: auto; /* Enables horizontal scrolling */\n            padding: 10px;\n            scroll-snap-type: x mandatory; /* Enables scroll snapping */\n        }\n\n        /* Hide scrollbar */\n        .thumbnail-container::-webkit-scrollbar {\n            display: none; /* For WebKit browsers (Chrome, Safari) */\n        }\n        .thumbnail-container {\n            -ms-overflow-style: none;  /* For Internet Explorer and Edge */\n            scrollbar-width: none;    /* For Firefox */\n        }\n\n        .thumbnail {\n            position: relative;\n            flex-shrink: 0; /* Prevents shrinking */\n            width: 30vw; /* 70% of the viewport width */\n            height: 30vh; /* 40% of the viewport height */\n            background: #333;\n            border-radius: 8px;\n            overflow: hidden;\n            cursor: pointer;\n            scroll-snap-align: center; /* Aligns items in the center when scrolling */\n        }\n\n        .thumbnail img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .fullscreen-player {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            background-color: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            display: none;\n        }\n\n        .fullscreen-player video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .close-btn {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: rgba(255, 255, 255, 0.8);\n            border: none;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            /* padding: 10px; */\n            font-size: 16px;\n            cursor: pointer;\n            z-index: 2000;\n            justify-content: center;\n            align-items: center;\n            transition: background 0.1s ease-out; \n        }\n\n        .close-btn:hover {\n            background: rgba(117, 117, 117, 0.8);\n        }\n\n        /* Responsive Styling */\n        @media (min-width: 768px) {\n            .thumbnail {\n                width: 100px;\n                height: 200px;\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .thumbnail {\n                width: 150px;\n                height: 300px;\n            }\n        }\n@media(max-width: 767px){\n.thumbnail{\nwidth: 70vw;\nheight: auto;\n}\n}\n    </style>\n</head>\n<body>\n    <div class=\"thumbnail-container\">\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/887bd9d275b24ac481637a372a0d58ae.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/1_Sapno_Ki_Rani.avifs?v=1732253357\" alt=\"Thumbnail for 1.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/3f0679673be34c0ab4160c8c81362b38.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/2_Growing_Up_Surrounded_by_Books.avifs?v=1732253357\" alt=\"Thumbnail for 2.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/32b40e2913324263a8052788eed28877.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/3_Playing_with_Toys.avifs?v=1732253357\" alt=\"Thumbnail for 3.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/4667aa9c1ac84b5cace8c692a23bbd78.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/workbooks4_compressed.avifs?v=1750066995\" alt=\"Thumbnail for 4.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/c732b2070b9645799bac421b8e24a470.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/5_POV_Building_the_Habit_of_Reading.avifs?v=1732253357\" alt=\"Thumbnail for 5.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/12aafa0d1bd74b23b756e325da0f3453.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/6_Book_Toy_Combo.avifs?v=1732253357\" alt=\"Thumbnail for 6.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/27e1f41d919d4019872169b65760b1e1.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/workbooks8compressed-ezgif.com-video-to-avif-converter.avifs?v=1750066995\" alt=\"Thumbnail for 7.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/27e1f41d919d4019872169b65760b1e1.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/8_Reading_improves_concentration.avifs?v=1732253357\" alt=\"Thumbnail for 8.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/2ae0436ab3594a82bc5083efc9ced68a.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/9_Weekly_Toys_Play_Schedule.avifs?v=1732253357\" alt=\"Thumbnail for 9.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/3bde7beb0c4f4504bd1331b5bc1cfb9b.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/10_Fun_Comfort_Go_Hand_in_Hand.avifs?v=1732253357\" alt=\"Thumbnail for 10.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/ffa910c4fba7427886be11ebc1590e6b.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/11_neOwn_library_customer_Unboxing.avifs?v=1732253358\" alt=\"Thumbnail for 11.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/e4aa58c2a4534f5fb069e35e95edef1e.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/12_Bath_Books.avifs?v=1732253357\" alt=\"Thumbnail for 12.mp4\">\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/eb10be539ec045a5b615ace4d9ff6cfb.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/workbooks7compressed.avifs?v=1750066995\" alt=\"Thumbnail for 7.mp4\" alt=\"Thumbnail for 13.mp4\">\n        </div>\n    </div>\n\n    <div class=\"fullscreen-player\" id=\"fullscreen-player\">\n        <button class=\"close-btn\" id=\"close-btn\">✕</button>\n        <video id=\"video-player\" controls autoplay></video>\n    </div>\n\n    <script>\n        const thumbnails = document.querySelectorAll('.thumbnail');\n        const fullscreenPlayer = document.getElementById('fullscreen-player');\n        const videoPlayer = document.getElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        // Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        // Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); // Stop video playback\n            videoPlayer.src = ''; // Clear video source\n        });\n    </script>",
        "custom_class": ""
      }
    },
    "page_faqs_jY7xLJ": {
      "type": "page-faqs",
      "blocks": {
        "accordion_XiWthW": {
          "type": "accordion",
          "settings": {
            "title": "Do you deliver all over India?",
            "content": "<p>Currently, we only deliver books all over India. </p><p>Delivery is free within Mumbai, Thane, Navi Mumbai, and Mira-Bhayander. </p><p>Outside Mumbai: There is an additional delivery charge for Book Library deliveries outside Mumbai. </p><p>(Toy Library is only operating in Mumbai as of now) </p>",
            "open": false
          }
        },
        "accordion_wWxapm": {
          "type": "accordion",
          "settings": {
            "title": "How does the Library Subscription work?",
            "content": "<p>Step 1: 📚🧸You can subscribe to any plan from our website. </p><p>Step 2: 📲Download the neOwn app to select your books. </p><p>Step 3: 📦Books will be delivered and the pickup and exchange will happen after maximum 30 days</p><p>Step 4: 🔁Finally you return and repeat the same for all the following months of your subscription!</p>",
            "open": false
          }
        },
        "accordion_98FnHe": {
          "type": "accordion",
          "settings": {
            "title": "How can I select my books?",
            "content": "<p>Once you have subscribed, you can download our app📲 from which you can select the books 📚</p><p>You can select any books of your choice, and in case you are not sure what to pick we have a book expert in-house who can help you out if needed 💖</p>",
            "open": false
          }
        },
        "accordion_TjN8da": {
          "type": "accordion",
          "settings": {
            "title": "How to download the neOwn app?",
            "content": "<p>📲 neOwn App Link: </p><p>🔗 Android: <a href=\"https://play.google.com/store/apps/details?id=com.neown\"><span style=\"text-decoration:underline\">https://play.google.com/store/apps/details?id=com.neown</span></a> </p><p>🔗 Apple: <a href=\"https://apps.apple.com/in/app/neown/id6483860525\"><span style=\"text-decoration:underline\">https://apps.apple.com/in/app/neown/id6483860525</span></a> </p>",
            "open": false
          }
        },
        "accordion_fhEYkH": {
          "type": "accordion",
          "settings": {
            "title": "What if I damage a Library Book? What if I lose a Library Book?",
            "content": "<p>If the damage is minor and can be repaired by us, there will be no additional charge to you.</p><p>If the damage is major such that it cannot be circulated anymore, or if the book is lost/misplaced, we will charge you 40% of the MRP of the item (and you can keep the item).</p><p>neOwn trusts moms to take the utmost care of books so that we can all collectively enjoy them!</p>",
            "open": false
          }
        },
        "accordion_JGFVja": {
          "type": "accordion",
          "settings": {
            "title": "Is there any deposit or registration fee?",
            "content": "<p>No, there is no deposit or registration fee. </p>",
            "open": false
          }
        },
        "accordion_VUQPmJ": {
          "type": "accordion",
          "settings": {
            "title": "Do I get to choose my books or do you send pre-curated books?",
            "content": "<p>You can choose your books! If you require any help with selection, you can take recommendations from our in-house book expert. </p>",
            "open": false
          }
        },
        "accordion_dXNAQy": {
          "type": "accordion",
          "settings": {
            "title": "There’s no place to enter my child’s details on the website, how will you know what kind of books I want?",
            "content": "<p>Our app asks for all these details to create a profile for your child. </p><p>Once you subscribe to any plan, you have to log in to our neOwn App to select your books. </p><p>Before you can view the catalog on the app, you have to enter all your child’s details - including their age, so that we can provide an age-appropriate catalog for them. </p>",
            "open": false
          }
        },
        "accordion_mXAMLA": {
          "type": "accordion",
          "settings": {
            "title": "Can I get books for both my children in one library subscription, or do I need to subscribe to the ‘2 Siblings’ plan?",
            "content": "<p>No, you cannot get books for both children in one library subscription. You can subscribe to the ‘2 Siblings’ plan to get books for both your children, where you can get 3 books for each child or 5 books for each child. The reason for this is that we create a unique profile for each child with all their details and provide an age-appropriate curated catalog of books to choose from. This will enable you to see each child’s unique progress as well as all the books they have read in a more organised manner. </p>",
            "open": false
          }
        },
        "accordion_ikFw3k": {
          "type": "accordion",
          "settings": {
            "title": "How do you sanitize the books?",
            "content": "<p>Our process to ensure the books are hygenic and in good condition: </p><ul><li>⁠We do a thorough check of all books twice - once after they have come back from customers and the second time before they are going to another customer </li><li>⁠⁠We also clean board books to ensure they are 100% sanitary </li><li>⁠⁠If any books are of bad quality we don't circulate them among customers anymore</li></ul>",
            "open": false
          }
        },
        "accordion_HTJKXC": {
          "type": "accordion",
          "settings": {
            "title": "If I subscribe today, will my 30 days start now?",
            "content": "<p>No, your 30 days will start after the books have been delivered to you. </p><p>Once you subscribe, you have to download our app to select your books. After selection, they will be delivered in 2-5 days within Mumbai and 4-8 days outside Mumbai. </p><p>Your 30 days start from the day when the books are delivered. </p>",
            "open": false
          }
        },
        "accordion_MnkN7P": {
          "type": "accordion",
          "disabled": true,
          "settings": {
            "title": "What are the shipping charges for outstation?",
            "content": "<p>The shipping charges for out-of-Mumbai deliveries are as follows: </p><p><strong>Plan Name</strong></p><p><strong>Number of items per month </strong></p><p><strong>Outside Mumbai Shipping Charge </strong></p><p>Book Library (1 child)</p><p>5 books per month</p><p>₹150/- per month</p><p>Book Library (2 siblings) (3+3 Plan)</p><p>3+3 (total 6) books per month </p><p>₹150/- per month</p><p>Book Library (2 siblings) (5+5 Plan)</p><p>5+5 books (total 10) per month</p><p>₹200/- per month</p><p>Currently our Toy Library is only being serviced in Mumbai, Navi Mumbai, & Thane. </p>",
            "open": false
          }
        },
        "accordion_aTVRQj": {
          "type": "accordion",
          "settings": {
            "title": "My pin code is showing not serviceable. What do I do?",
            "content": "<p>We may still be able to deliver to you! WhatsApp us at +91 93244 55972 and let us know your pin code, we’ll inform you if your area is serviceable. </p>",
            "open": false
          }
        },
        "accordion_79wQzC": {
          "type": "accordion",
          "settings": {
            "title": "How do I return the Library books?",
            "content": "<p>Once you are done reading the books, you can select ‘Done Reading’ on our app. Then you have to select your next set of books. Once the next set is confirmed, our team will schedule a delivery for the new items and a pickup to return the old books. The return process is as follows: We’ll send our delivery partner directly to your doorstep for the pickup of the books. You’ll be notified of the timelines, and you can keep the books packed for when it's time for the pickup.</p>",
            "open": false
          }
        },
        "accordion_Rp6NhE": {
          "type": "accordion",
          "settings": {
            "title": "Do you have other languages books?",
            "content": "<p>Yes! We also have a limited collection of books in Hindi, Marathi, and Gujarati. </p>",
            "open": false
          }
        },
        "accordion_MrqUic": {
          "type": "accordion",
          "settings": {
            "title": "Can I cancel the Library Subscription at any time?",
            "content": "<p>At this time, we do not offer order cancellation.</p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on +91 93244 55972, or you can get in touch directly with our founder at kranti@neown.in.</p>",
            "open": false
          }
        }
