enter;\">\n  <div class=\"reviews-container\"> \n    <!-- style=\"font-family: Arial, sans-serif; background-color: #f5f5f5; margin: 0 auto; padding: 20px; display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; width: 80%; max-width: 800px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); text-align: center; position: relative;\"> -->\n    <h2 style=\"margin-bottom: 20px; font-size: 1.5rem; font-weight: bold;\">What Mothers Have to Say<\/h2>\n    <div class=\"review-slide active\" style=\"display: block; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position:relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; margin: 20px auto\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Group_438.png?v=1733738996\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n      <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Kids love it!<\/h3>\n      <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">My kids love wearing their neOwn t-shirts!<\/p>\n      <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Pooja Shetty<\/p>\n    <\/div>\n    <\/div>\n\n    <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Group_450.png?v=1733742867\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n      <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Super comfy & great quality <\/h3>\n      <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">The fit is super comfy for my kids, and the quality is great! Plus, the colour doesn't fade even after multiple washes<\/p>\n      <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Kavita Gala<\/p>\n        <\/div>\n    <\/div>\n    <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Group_439.png?v=1733738996\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Love love love ❤️<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">Loved the quality & colour of the t-shirt<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Veronica Lewis<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Group_451.png?v=1733742874\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Nice T-shirts<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">The t-shirt is nice, and after washing also the colour & fabric are in good condition.<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Hiral Vakharia<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Group_446.png?v=1733742881\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Unique animal designs <\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">The animal designs are so unique my kid loves them <\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Palak Mishra<\/p>\n        <\/div>\n      <\/div>\n\n    <div class=\"nav-buttons\" style=\"margin-top: 15px;\">\n      <button onclick=\"prevSlide()\" style=\"background-color: #8a2be2; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; margin: 0 5px;\">&lt;<\/button>\n      <button onclick=\"nextSlide()\" style=\"background-color: #8a2be2; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; margin: 0 5px;\">&gt;<\/button>\n    <\/div>\n  <\/div>\n  <script>\n    let currentIndex = 0;\n    const slides = document.querySelectorAll('.review-slide');\n\n    function showSlide(index) {\n      slides.forEach((slide, i) => {\n        slide.style.display = i === index ? 'block' : 'none';\n      });\n    }\n\n    function nextSlide() {\n      currentIndex = (currentIndex + 1) % slides.length;\n      showSlide(currentIndex);\n    }\n\n    function prevSlide() {\n      currentIndex = (currentIndex - 1 + slides.length) % slides.length;\n      showSlide(currentIndex);\n    }\n\n    \/\/ Auto-scroll functionality\n    setInterval(() => {\n      nextSlide();\n    }, 3000);\n  <\/script>\n<\/div>","custom_class":""}},"rich_text_TaAXMi":{"type":"rich-text","blocks":{"heading_w34WKJ":{"type":"heading","settings":{"heading":"T-Shirts in Action","heading_size":"h3"}}},"block_order":["heading_w34WKJ"],"settings":{"container":"container","color_scheme":"","content_alignment":"center","padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"custom_liquid_H4L4L7":{"type":"custom-liquid","settings":{"custom_liquid":"<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Video Player<\/title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            \/* background-color: #000; *\/\n            color: #fff;\n            font-family: Arial, sans-serif;\n        }\n\n        .thumbnail-container {\n            display: flex;\n            gap: 10px;\n            overflow-x: auto; \/* Enables horizontal scrolling *\/\n            padding: 10px;\n            scroll-snap-type: x mandatory; \/* Enables scroll snapping *\/\n        }\n\n        \/* Hide scrollbar *\/\n        .thumbnail-container::-webkit-scrollbar {\n            display: none; \/* For WebKit browsers (Chrome, Safari) *\/\n        }\n        .thumbnail-container {\n            -ms-overflow-style: none;  \/* For Internet Explorer and Edge *\/\n            scrollbar-width: none;    \/* For Firefox *\/\n        }\n\n        .thumbnail {\n            position: relative;\n            flex-shrink: 0; \/* Prevents shrinking *\/\n            width: 30vw; \/* 70% of the viewport width *\/\n            height: 30vh; \/* 40% of the viewport height *\/\n            background: #333;\n            border-radius: 8px;\n            overflow: hidden;\n            cursor: pointer;\n            scroll-snap-align: center; \/* Aligns items in the center when scrolling *\/\n        }\n\n        .thumbnail img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .fullscreen-player {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            background-color: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            display: none;\n        }\n\n        .fullscreen-player video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .close-btn {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: rgba(255, 255, 255, 0.8);\n            border: none;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            \/* padding: 10px; *\/\n            font-size: 16px;\n            cursor: pointer;\n            z-index: 2000;\n            justify-content: center;\n            align-items: center;\n            transition: background 0.1s ease-out; \n        }\n\n        .close-btn:hover {\n            background: rgba(117, 117, 117, 0.8);\n        }\n\n        \/* Responsive Styling *\/\n        @media (min-width: 768px) {\n            .thumbnail {\n                width: 100px;\n                height: 200px;\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .thumbnail {\n                width: 150px;\n                height: 300px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"thumbnail-container\">\n        <div class=\"thumbnail