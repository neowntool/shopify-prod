hop_images\/neown-woman-reads-book-child-with-child-reading-book.png","link":"","link_2":"","second_image_offset_top":10,"title":"Gift a Subscription","sub_title":"","text":"<p>The Gift that Keeps Giving<\/p>","text_size":"medium","content_alignment":"center","button_label":"GIFT NOW","button_link":"https:\/\/wa.me\/919137081640?text=Hi,%20I%20want%20to%20gift%20a%20neOwn%20subscription","button_style":"m-button--primary","button_size":"","padding_top":20,"padding_bottom":20,"custom_class":"","animations":"inherit"}},"product-details-tabs":{"type":"product-details-tabs","disabled":true,"settings":{"container":"container-fluid","color_scheme":"","default_open":true,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"collapsible_tabs_Yq864N":{"type":"collapsible-tabs","blocks":{"item_nnGwHm":{"type":"item","settings":{"header":"Which Kidswear sizes do you have? ","text_size":"h5","content":"<p>Currently we offer 4 sizes for the following age groups: <\/p><ul><li>2-3 yrs<\/li><li>3-4 yrs<\/li><li>4-5 yrs<\/li><li>5-6 yrs <\/li><\/ul>","content_page":"","open":false}},"item_dKDzwB":{"type":"item","settings":{"header":"How long will it take to get my Kidswear order?","text_size":"h5","content":"<p>Once you have selected your items, delivery will occur within 2-5 working days. If you have any more questions, feel free to get in touch with us at +91 9137081640<\/p>","content_page":"","open":false}},"item_CgYYQW":{"type":"item","settings":{"header":"Can I cancel my Kidswear order?","text_size":"h5","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your product, we’d love to hear what you would like us to change or improve! WhatsApp us on 9137081640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","content_page":"","open":false}},"item_qFtthP":{"type":"item","settings":{"header":"Can I exchange my Kidswear order if it’s not the right size?","text_size":"h5","content":"<p>Yes! We have a 7-day exchange period where you can exchange your clothing (against the same product SKU) if it’s not the right size. <\/p>","content_page":"","open":false}},"item_bFqD6g":{"type":"item","settings":{"header":"What is your return\/exchange policy for Kidswear?","text_size":"h5","content":"<p>For Exchange due to size issue, you can request a size exchange within 7 days of receiving your products. <\/p><p>If you wish to Return the products, we offer neOwn store credit amounting to the value of the items to be returned within 7 days of receiving your products. <\/p><p>To exchange or return your products, please reach out to us with your order number and the new size you require. <\/p>","content_page":"","open":false}},"item_CFkXfB":{"type":"item","settings":{"header":"What is your refund policy for Kidswear?","text_size":"h5","content":"<p>At the moment, we only provide neOwn store credit as a refund. <\/p>","content_page":"","open":false}},"item_mtwFL7":{"type":"item","settings":{"header":"Where do you deliver Kidswear? ","text_size":"h5","content":"<p>We offer free delivery across India! <\/p>","content_page":"","open":false}},"item_ipQxjJ":{"type":"item","settings":{"header":"Do you have a Kidswear sizing guide?","text_size":"h5","content":"<p>Yes! You can check our size guide here. <\/p>","content_page":"","open":false}},"item_TmhTnE":{"type":"item","settings":{"header":"Do you offer customization or bulk gifting in Kidswear? ","text_size":"h5","content":"<p>Yes we do! Please WhatsApp us at +91 9137081640 with your requirement and we’ll get back to you.  <\/p>","content_page":"","open":false}},"item_xycw93":{"type":"item","settings":{"header":"How can I recycle neOwn Kidswear? ","text_size":"h5","content":"<p>Get ₹50\/- neOwn store credit for every neOwn t-shirt sent to us for recycling or reuse! <\/p><p>You can recycle your t-shirts in 3 easy steps: <\/p><p>Get in touch with the neOwn team to schedule a free pick-up for the clothes here<\/p><p>Pack the T-Shirts in the neOwn Poly-Bag provided for the return <\/p><p>Once the courier is booked, the T-Shirts will be picked up from your location and delivered back to us to be recycled or reused. <\/p><p>Please note: We accept t-shirts in any condition except for holes and tears. <\/p><p>To recycle with neOwn, please reach out to us with your order number and the items you wish to recycle. <\/p>","content_page":"","open":false}}},"block_order":["item_nnGwHm","item_dKDzwB","item_CgYYQW","item_qFtthP","item_bFqD6g","item_CFkXfB","item_mtwFL7","item_ipQxjJ","item_TmhTnE","item_xycw93"],"settings":{"container":"container","color_scheme":"","image_position":"left","column_gap":100,"heading":"FAQs","heading_size":"h3","subheading":"","description":"","header_alignment":"center","padding_top":0,"padding_bottom":0,"animations":"inherit","custom_class":""}}},"order":["slider_cewxrj","main","empty_space_kLcNYh","custom_liquid_3DdeGF","rich_text_TaAXMi","custom_liquid_H4L4L7","brands_list_VUULtN","featured_collection_GdXCV9","featured_collection_G3NWXe","collection_list_zTY9f9","featured_collection_xfRYXP","featured_collection_E4RFey","featured_collection_jw9wqg","featured_collection_JKrtBG","image_with_text_NYWtMe","product-details-tabs","collapsible_tabs_Yq864N"]}