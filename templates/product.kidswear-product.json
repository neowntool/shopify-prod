fullscreen-player\" id=\"fullscreen-player\">\n        <button class=\"close-btn\" id=\"close-btn\">✕<\/button>\n        <video id=\"video-player\" controls autoplay><\/video>\n    <\/div>\n\n    <script>\n        const thumbnails = document.querySelectorAll('.thumbnail');\n        const fullscreenPlayer = document.getElementById('fullscreen-player');\n        const videoPlayer = document.getElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        \/\/ Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        \/\/ Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); \/\/ Stop video playback\n            videoPlayer.src = ''; \/\/ Clear video source\n        });\n    <\/script>","custom_class":""}},"brands_list_VUULtN":{"type":"brands-list","blocks":{"image_LNYtq4":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_441.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_KjMJGE":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_442.png","image_by_url":"","image_link":"","max_width":"120px"}},"image_RPPJHB":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_444.png","image_by_url":"","image_link":"","max_width":"86px"}},"image_k4aDqL":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_443.png","image_by_url":"","image_link":"","max_width":"100px"}}},"block_order":["image_LNYtq4","image_KjMJGE","image_RPPJHB","image_k4aDqL"],"settings":{"heading":"Why choose neOwn Kidswear?","heading_size":"h3","subheading":"","header_