        "item_cwUPma": {
          "type": "item",
          "settings": {
            "header": "Do you give refunds?",
            "text_size": "h5",
            "content": "<p>No, refunds are not provided. <br/>In an exceptional case if there is an error on neOwn’s part and your subscription has not yet started, a refund may be issued at neOwn’s discretion. <br/>In case your subscription has started, then it will not be possible to provide a refund.</p>",
