        "item_VM8mni": {
          "type": "item",
          "settings": {
            "header": "How do you sanitize the books & toys? ",
            "text_size": "h5",
            "content": "<p>Our process to ensure the books & toys are hygenic and in good condition: </p><ul><li>All toys are cleaned by our team before and after they go to or come back from any customer to ensure they are 100% sanitary</li><li>⁠⁠We also clean board books to ensure they are 100% sanitary </li><li>⁠We do a thorough check of all books & toys twice - once after they have come back from customers and the second time before they are going to another customer </li><li>⁠⁠If any books or toys are of bad quality we don't circulate it among customers anymore</li></ul>",
            "content_page": "",
            "open": false
          }
        },
        "item_RcVE9H": {
          "type": "item",
          "settings": {
            "header": "What topics do you do have workshops on?",
            "text_size": "h5",
            "content": "<p>We at neOwn conduct a wide variety of skill-building workshops on: </p><ul><li>Creative Writing</li><li>Speech & Communication </li><li>Debate & Public Speaking</li><li>Math Skills</li><li>Coding & AI</li><li>Life Skills</li><li>Art & Design (including learning softwares like Canva, Photoshop, and more)</li><li>Music</li></ul>",
            "content_page": "",
            "open": false
          }
        },
