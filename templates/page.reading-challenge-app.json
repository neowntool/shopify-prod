style":"m-button--secondary","button_size":"m-button--small","infinite_load":false,"max_page_load":3,"mobile_disable_slider":false,"use_scroll_mobile":true,"item_gap_mobile":16,"padding_top":10,"padding_bottom":10,"custom_class":"","animations":"inherit"}},"brands_list_JKyRzD":{"type":"brands-list","blocks":{"image_jLY8Ap":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Expert_picks.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_cKEMyM":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Huge_savings.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_gbPkwd":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Doorstep_del.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_CMgz3E":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/no_storage_hassle.png","image_by_url":"","image_link":"","max_width":"150px"}}},"block_order":["image_jLY8Ap","image_cKEMyM","image_gbPkwd","image_CMgz3E"],"disabled":true,"name":"Brands list","settings":{"heading":"Why Choose neOwn?","heading_size":"h3","subheading":"","description":"","header_alignment":"center","container":"container-fluid","color_scheme":"","item_per_row":4,"column_gap":30,"row_gap":30,"column_gap_mobile":10,"row_gap_mobile":10,"enable_slider":false,"show_nav":false,"show_pagination":false,"autorotate":false,"autorotate_speed":3,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"rich_text_UHKPdn":{"type":"rich-text","blocks":{"heading_nLaxXj":{"type":"heading","settings":{"heading":"<b>FAQs<\/b>","heading_size":"h2"}}},"block_order":["heading_nLaxXj"],"settings":{"container":"container","color_scheme":"","content_alignment":"center","padding_top":12,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"page_faqs_jY7xLJ":{"type":"page-faqs","blocks":{"accordion_98FnHe":{"type":"accordion","settings":{"title":"How does the Reading Challenge work?","content":"<p>Step 1: Register by filling this form: <a href=\"https:\/\/tinyurl.com\/4j67yx4r\"><span style=\"text-decoration:underline\">https:\/\/tinyurl.com\/4j67yx4r<\/span><\/a>  <\/p><p>Step 2: Request to join the WhatsApp Group (we will approve the request 2-5 days before the upcoming challenge) <\/p><p>Step 3: Read the Challenge Instructions which will be sent on the WhatsApp Group 1 day before the challenge <\/p><p>Step 4: Await Instructions for App Download to track daily reading!<\/p><p>Step 5: Win Certificates & Badges upon successful completion of the challenge <\/p>","open":false}},"accordion_TjN8da":{"type":"accordion","settings":{"title":"How to download the neOwn app?","content":"<p>📲 neOwn App Link: <\/p><p>🔗 Android: <a href=\"https:\/\/play.google.com\/store\/apps\/details?id=com.neown\"><span style=\"text-decoration:underline\">https:\/\/play.google.com\/store\/apps\/details?id=com.neown<\/span><\/a> <\/p><p>🔗 Apple: <a href=\"https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525\"><span style=\"text-decoration:underline\">https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525<\/span><\/a> <\/p>","open":false}},"accordion_XiWthW":{"type":"accordion","settings":{"title":"Do I have to be a neOwn subscriber to join?","content":"<p>No, you don’t have to be a neOwn subscriber to join. Our Reading Challenges are open for all children between the ages of 0-14 years. <\/p>","open":false}},"accordion_wWxapm":{"type":"accordion","settings":{"title":"Can we participate from anywhere in India?","content":"<p>Yes! The challenge is conducted completely online. <\/p>","open":false}},"accordion_fhEYkH":{"type":"accordion","settings":{"title":"What are the rewards for participating in the Reading Challenge?","content":"<p>🏆Certificates (Platinum, Gold, Silver, Bronze)<\/p><p>🎁 Collectible Badges & goodies for Platinum Readers<\/p><p>📱Get Featured on our Instagram & on our website <\/p>","open":false}},"accordion_JGFVja":{"type":"accordion","settings":{"title":"Which age group is this Reading Challenge for?","content":"<p>The reading challenge is for children between the ages of 0-14 years. If your child is not reading independently yet, you can take it on as a challenge to read to them daily! <\/p>","open":false}},"accordion_VUQPmJ":{"type":"accordion","settings":{"title":"Which books have to be read? Can kids read books of their choice, or is any list going to be provided?","content":"<p>Kids can read any books of their choice! For our challenges, the focus is on consistency and habit of reading for 25 mins a day rather than on choice of books <\/p><p>We can share some recommendations, but it’s not necessary to read only from the list of recos. <\/p>","open":false}},"accordion_dXNAQy":{"type":"accordion","settings":{"title":"How will the monitoring be done?","content":"<p>The tracking of 20 mins daily reading has to be done on our app. <\/p><p>As for the books which are being read, we will do a weekly check-in on the WhatsApp Group where parents can share the book names and pics\/short reviews from the kids. <\/p><p>For any add-on challenges like Genre Explorer, Book Bingo, Vocabulary, etc - we share an additional Google Form to take your entries for those. <\/p>","open":false}},"accordion_ikFw3k":{"type":"accordion","settings":{"title":"Where can I see my child’s progress in the Reading Challenge?","content":"<p>You will be able to see your child's progress in the app itself. <\/p>","open":false}},"accordion_gdKihh":{"type":"accordion","settings":{"title":"I’m unable to join the Reading Challenge group, what do I do?","content":"<p>You will initially have to request to join the group and you will be added to the group 2-5 days before the next challenge begins. <\/p>","open":false}},"accordion_An7P48":{"type":"accordion","settings":{"title":"My child is under 5 years old and is not an independent reader yet. Can they participate in the Reading Challenge? How will they participate?","content":"<p>Yes, they can definitely participate! You can take it on as a challenge to read to them daily! The continued exposure and habit will help him to practice and improve their reading skills. <\/p>","open":false}},"accordion_hkpzbC":{"type":"accordion","settings":{"title":"My child is learning to read currently. How can I help her to succeed in the Reading Challenge?","content":"<p>We would suggest starting out by sitting and reading with them to slowly build their confidence in reading. For the first few days you can do reading for the entire Challenge time together. Then move on to reading for 10-15 mins together and letting her read independently for 10-15 mins for a few more days. And then finally she can attempt to do the Challenge’s full daily reading time independently! <\/p><p>Another way would be to give them books that are more simple than what they are used to. This will also help them practice the basics of reading and gain the confidence to read more! Then, you can slowly increase the difficulty level of the books.<\/p>","open":false}},"accordion_CDDD3E":{"type":"accordion","settings":{"title":"Do I have to read for the entire daily time in one go OR can I break it up throughout the day?","content":"<p>You can break it up or do it all in one go! As long as reading for the minimum daily time is done consistently. <\/p>","open":false}},"accordion_yfMLJP":{"type":"accordion","settings":{"title":"Can my child read at any time in the day?","content":"<p>Your child can read any time during the day, and you can mark their reading in the challenge at your convenience.<\/p>","open":false}},"accordion_mQpgdp":{"type":"accordion","settings":{"title":"Can I log my child's reading late in the night, in case I only get free at that time?","content":"<p>Yes, the daily poll will be active for the entire day + for the 2 following days, in case you forget to vote on any day. <\/p>","open":false}},"accordion_PAKXyM":{"type":"accordion","settings":{"title":"Do I need to record a video of my child reading?","content":"<p>No video recording is needed for the basic level of the challenge. You can vote on the app to track your child's daily reading. We will do a weekly check-in on the WhatsApp Group where parents can share the book names and pics\/short reviews of the books from the kids. <\/p>","open":false}},"accordion_rF4wgm":{"type":"accordion","disabled":true,"settings":{"title":"Can I cancel the Library Subscription at any time?","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on +91 91370 81640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","open":false}}},"block_order":["accordion_98FnHe","accordion_TjN8da","accordion_XiWthW","accordion_wWxapm","accordion_fhEYkH","accordion_JGFVja","accordion_VUQPmJ","accordion_dXNAQy","accordion_ikFw3k","accordion_gdKihh","accordion_An7P48","accordion_hkpzbC","accordion_CDDD3E","accordion_yfMLJP","accordion_mQpgdp","accordion_PAKXyM","accordion_rF4wgm"],"settings":{"headingsec":"","container":"container","color_scheme":"","menu":"","custom_class":""}},"custom_liquid_bjkGf8":{"type":"custom-liquid","disabled":true,"custom_css":[],"settings":{"custom_liquid":"<title>Responsive Div<\/title>\n    <style>\n        body {\n            margin: 0;\n            font-family: \"DM Sans\", sans-serif;\n            background-color: #f0f0f0;\n        }\n        .container-chat {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            \/* min-height: 100vh; *\/\n            padding: 20px;\n            background-color: #ffffff;\n        }\n        .content-chat {\n            background: linear-gradient(to bottom, #7A62E4, #a32ed5);\n            border-radius: 20px;\n            text-align: center;\n            padding: 90px;\n            max-width: 1200px;\n            width: 100%;\n            color: white;\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n        }\n        .content-chat h1 {\n            font-size: 28px;\n            color: #ffffff;\n            margin-bottom: 20px;\n        }\n        .content-chat p {\n            margin: 10px 0;\n            font-size: 18px;\n        }\n        .content-chat a {\n            display: inline-block;\n            background: white;\n            color: #EB5CE8;\n            padding: 15px 30px;\n            border-radius: 50px;\n            text-decoration: none;\n            font-weight: bold;\n            transition: background 0.3s, color 0.3s;\n            margin-top: 20px;\n        }\n        .content-chat a:hover {\n            background: #EB5CE8;\n            color: white;\n        }\n        @media (max-width: 600px) {\n            .content-chat {\n                padding: 20px;\n            }\n            .content-chat h1 {\n                font-size: 22px;\n            }\n            .content-chat p {\n                font-size: 16px;\n            }\n            .content-chat a {\n                padding: 10px 20px;\n                font-size: 16px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"container-chat\">\n        <div class=\"content-chat\">\n            <h1>Still not convinced?<\/h1>\n            <p>Join our FREE Parents’ Community on WhatsApp<\/p>\n            <p>📚 Kids Sessions: Online book club, storytelling, & creative writing<\/p>\n            <p>💡 Monthly Reading Challenges<\/p>\n            <p>💬 Q&A sessions with experts<\/p>\n            <a href=\"https:\/\/chat.whatsapp.com\/Ixt3hz8fc6g6digIYWBeOj\">Join Now<\/a>\n        <\/div>\n    <\/div>\n<\/body>","custom_class":""}}},"order":["main","slider_nk8kRa","custom_liquid_BMd3Hp","rich_text_NbVHdB","image_with_text_2_tbd8pm","new_featured_product_yfEYxn","empty_space_xGj4LT","rich_text_riyCbf","custom_liquid_eiDFU6","image_with_text_2_yzCgGN","rich_text_gtPVCt","scrolling_promotion_XreH74","empty_space_XNQ7di","featur