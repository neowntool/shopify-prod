rkshops-mob_15b1369e-99cb-4f2c-896a-0d343e9d97b0.png","use_content_above":true,"custom_class":"","animations":"inherit","enable_bg_zoom_effect":true}},"featured_collection_KkDqnN":{"type":"featured-collection","disabled":true,"name":"Featured collection","settings":{"heading":"Upcoming Workshops!","heading_size":"h3","subheading":"","description":"","header_alignment":"center","color_scheme":"default","container":"container-fluid","collection":"upcoming-workshops","enable_flashsale":false,"show_countdown":false,"product_to_show":8,"items_per_row":4,"item_gap":30,"pcard_layout":"","pcard_image_ratio":"original","show_vendor":false,"hide_title":true,"enable_slider":false,"show_pagination":false,"show_navigation":false,"show_button_on_header":false,"button_type":"link","button_text":"View More","button_style":"m-button--link","button_size":"m-button--small","infinite_load":false,"max_page_load":3,"mobile_disable_slider":false,"use_scroll_mobile":true,"item_gap_mobile":16,"padding_top":10,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"product-details-tabs":{"type":"product-details-tabs","disabled":true,"custom_css":[".m-tabs__header {justify-content: flex-start;}"],"settings":{"container":"container","color_scheme":"","default_open":true,"padding_top":0,"padding_bottom":50,"custom_class":"","animations":"inherit"}},"custom_liquid_K6CC8r":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reviews Slider<\/title>\n<\/head>\n<style>\n\n    .reviews-container {\n      width: 90%;\n      max-width: 1000px;\n      background-color: white;\n      padding: 20px;\n      border-radius: 10px;\n      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n      text-align: center;\n      position: relative;\n      \n    }\n<\/style>\n<body>\n<div style=\"display: flex; justify-content: center; align-items: center;\">\n  <div class=\"reviews-container\"> \n    <!-- style=\"font-family: Arial, sans-serif; background-color: #f5f5f5; margin: 0 auto; padding: 20px; display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; width: 80%; max-width: 800px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); text-align: center; position: relative;\"> -->\n    <h2 style=\"margin-bottom: 20px; font-size: 1.5rem; font-weight: bold;\">What Mothers Have to Say<\/h2>\n    <div class=\"review-slide active\" style=\"display: block; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position:relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; margin: 20px auto\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Namrata_Gulati.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n      <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Very engaging!<\/h3>\n      <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">Thanks for the session. It was very interactive. Reyansh sat through the whole session which is quite a big deal for him 😅<\/p>\n      <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Namrata Gulati<\/p>\n      <\/div>\n    <\/div>\n    <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Kritika_Hire.png?v=1745923828\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n      <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Helped to enhance skills<\/h3>\n      <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">Anjika loved the class way too much. She likes to read. From last November we introduced her to novels. This class helped her how to enhance her writing skills.❤️<\/p>\n      <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Kritika Hire<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Aparna_Sagar.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Built her confidence<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">First time she attended this type of workshop and I am sure it will help her to develop basic writing skills and techniques along with self-expression and confidence. Thank you neOwn team for arranging and encouraging her to attend this workshop.🥰❤️<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Aparna Sagar<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Sana_Sayed.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Great time investment<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">Zahra enjoyed the sessions. It was amazing, in flow and kept the children glued to the screen and in the sync with the topics.<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Sana Sayed<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Harbans_Kaur.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Very encouraging environment<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">\"Thank you so much. Bandagi loved you. Especially your encouraging words for every kid\"<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Harbans Kaur<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px; position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Anjali_Bajpai.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Great first time! 😊<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">This was his first time interacting with group on an online platform and he loved it :)<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Anjali Bajpai<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px;position: relative;\">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%;margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Kirti_Pednekar.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">So informative!<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">Thank you neOwn team for arranging the session.. It's informative and helpful for kids.. Vaibhav enjoyed it. 👍<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Kirti Pednekar<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"review-slide\" style=\"display: none; text-align: center; padding: 20px; border-radius: 10px; background-color: #f8f0ff; margin: 0 auto; height: 350px;position: relative; \">\n        <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; margin: 20 auto\"\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0687\/8557\/0066\/files\/Sneha_Doshi.png?v=1745923827\" alt=\"Reviewer Image\" style=\"width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; object-fit: cover;\">\n        <h3 style=\"margin: 10px 0 5px; font-size: 1.2rem; font-weight: bold;\">Great teaching style<\/h3>\n        <p style=\"font-size: 0.9rem; color: #555; margin-bottom: 10px;\">I was so happy with the explanations & activity, it was simple but very interesting - really engaged my son and I can confidently say he did learn a lot!<\/p>\n        <p class=\"reviewer-name\" style=\"font-weight: bold; color: #C50076;\">Sneha Doshi<\/p>\n        <\/div>\n      <\/div>\n    <div class=\"nav-buttons\" style=\"margin-top: 15px;\">\n      <button onclick=\"prevSlide()\" style=\"background-color: #8a2be2; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; margin: 0 5px;\">&lt;<\/button>\n      <button onclick=\"nextSlide()\" style=\"background-color: #8a2be2; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; margin: 0 5px;\">&gt;<\/button>\n    <\/div>\n  <\/div>\n  <script>\n    let currentIndex = 0;\n    const slides = document.querySelectorAll('.review-slide');\n\n    function showSlide(index) {\n      slides.forEach((slide, i) => {\n        slide.style.display = i === index ? 'block' : 'none';\n      });\n    }\n\n    function nextSlide() {\n      currentIndex = (currentIndex + 1) % slides.length;\n      showSlide(currentIndex);\n    }\n\n    function prevSlide() {\n      currentIndex = (currentIndex - 1 + slides.length) % slides.length;\n      showSlide(currentIndex);\n    }\n\n    \/\/ Auto-scroll functionality\n    setInterval(() => {\n      nextSlide();\n    }, 3000);\n  <\/script>\n<\/div>","custom_class":""}},"brands_list_CCmPYV":{"type":"brands-list","blocks":{"image_3y4NgH":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Learn_life_skills.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_ER