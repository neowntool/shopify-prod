ElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        \/\/ Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        \/\/ Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); \/\/ Stop video playback\n            videoPlayer.src = ''; \/\/ Clear video source\n        });\n    <\/script>","custom_class":""}},"brands_list_NUdj3b":{"type":"brands-list","blocks":{"image_nen7bY":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_441.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_naA3QC":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_442.png","image_by_url":"","image_link":"","max_width":"120px"}},"image_WRfeye":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_444.png","image_by_url":"","image_link":"","max_width":"86px"}},"image_XHMQKC":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Group_443.png","image_by_url":"","image_link":"","max_width":"100px"}}},"block_order":["image_nen7bY","image_naA3QC","image_WRfeye","image_XHMQKC"],"settings":{"heading":"Why choose neOwn Kidswear?","heading_size":"h3","subheading":"","header_alignment":"center","container":"container-fluid","color_scheme":"","item_per_row":4,"column_gap":30,"row_gap":30,"column_gap_mobile":10,"row_gap_mobile":10,"enable_slider":false,"show_nav":false,"show_pagination":false,"autorotate":false,"autorotate_speed":3,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"image_with_text_cF9r8X":{"type":"image-with-text","custo