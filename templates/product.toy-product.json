    "custom_liquid_H4L4L7": {
      "type": "custom-liquid",
      "custom_css": [
        "@media (max-width: 767px) {.thumbnail {width: 55vw; height: auto; }}"
      ],
      "settings": {
        "custom_liquid": "<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Video Player</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            /* background-color: #000; */\n            color: #fff;\n            font-family: Arial, sans-serif;\n        }\n\n        .thumbnail-container {\n            display: flex;\n            gap: 10px;\n            overflow-x: auto; /* Enables horizontal scrolling */\n            padding: 10px;\n            scroll-snap-type: x mandatory; /* Enables scroll snapping */\n        }\n\n        /* Hide scrollbar */\n        .thumbnail-container::-webkit-scrollbar {\n            display: none; /* For WebKit browsers (Chrome, Safari) */\n        }\n        .thumbnail-container {\n            -ms-overflow-style: none;  /* For Internet Explorer and Edge */\n            scrollbar-width: none;    /* For Firefox */\n        }\n\n        .thumbnail {\n            position: relative;\n            flex-shrink: 0; /* Prevents shrinking */\n            width: 30vw; /* 70% of the viewport width */\n            height: 30vh; /* 40% of the viewport height */\n            background: #333;\n            border-radius: 8px;\n            overflow: hidden;\n            cursor: pointer;\n            scroll-snap-align: center; /* Aligns items in the center when scrolling */\n        }\n\n        .thumbnail img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .fullscreen-player {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            background-color: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            display: none;\n        }\n\n        .fullscreen-player video {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n        }\n\n        .close-btn {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: rgba(255, 255, 255, 0.8);\n            border: none;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            /* padding: 10px; */\n            font-size: 16px;\n            cursor: pointer;\n            z-index: 2000;\n            justify-content: center;\n            align-items: center;\n            transition: background 0.1s ease-out; \n        }\n\n        .close-btn:hover {\n            background: rgba(117, 117, 117, 0.8);\n        }\n\n        /* Responsive Styling */\n        @media (min-width: 768px) {\n            .thumbnail {\n                width: 100px;\n                height: 200px;\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .thumbnail {\n                width: 150px;\n                height: 300px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"thumbnail-container\">\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/960cea5034f64f73a82b1f2977e4050a.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/1._3_Best_Puzzles_for_5_yr_old.avifs?v=1734706733\" alt=\"Thumbnail for 1.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/c9827e0085c54eb8b7d027d5e0936fa4.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/2._5_Montessori_Toys.avifs?v=1734706734\" alt=\"Thumbnail for 2.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/9b796e73afeb43c9b0bd39d123b9b721.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/3._5_toys_for_kids_under_5_yrs.avifs?v=1734706733\" alt=\"Thumbnail for 3.mp4\">\n        </div>\n        <div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/7067be115c0a4e6bbcaf0049e27acf13.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/4._Activity_Toys_to_Boost_Brain_cc6602d9-1bd4-40a6-8ae4-17b281eaf96b.avifs?v=1734706733\" alt=\"Thumbnail for 4.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/4ab03306a0344d60ab651cd7d84b9487.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/5._Childhood_Toys_2f9920ce-def0-4dad-9f42-3ac6989cc9be.avifs?v=1734706734\" alt=\"Thumbnail for 5.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/5b35c29d785d4bb09c58909b221cc1bd.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/6._Fraction_Puzzle_c5b6a935-d786-433a-9881-c975477254c0.avifs?v=1734706896\" alt=\"Thumbnail for 6.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/ba866f70f8f247f088cb2116114ad4f8.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/7._Rainbow_Stacker_Toy_6e87d446-2dc1-4039-a454-f0edb4cd1bde.avifs?v=1734706897\" alt=\"Thumbnail for 7.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/587b405a1fb2476a85f328f8a92ef371.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/8._Screen_Time_Toys_9da0bea5-c56c-4be7-b53e-16602adf0198.avifs?v=1734706897\" alt=\"Thumbnail for 8.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/b48345b9d202443ca31c480d6aa0f718.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/9._Spellings_Toy_3dbb1d68-bd6f-47f8-9fd7-7f94d25df1c4.avifs?v=1734706897\" alt=\"Thumbnail for 9.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/ccae5aa157c84b18bc3f58e8b38efe0e.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/10._Toys_for_Cognitive_Development_fd5c8957-d13e-4b47-8048-31f30d2a425c.avifs?v=1734706896\" alt=\"Thumbnail for 10.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/0c25bb271a2843b297e529cbcd632d4b.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/11._Toys_for_Toddlers_Development_1c25799e-2397-4d7a-9700-cfe1aedc414a.avifs?v=1734706896\" alt=\"Thumbnail for 11.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/9df4edb0a6114619b195d43e9ceeb870.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/12._Toys_to_keep_your_child_entertained_03a589dc-3200-4e1d-9c66-2325a3d23d73.avifs?v=1734706897\" alt=\"Thumbnail for 12.mp4\">\n\n        </div><div class=\"thumbnail\" data-video=\"https://cdn.shopify.com/videos/c/o/v/29c1345030184b958a1000990074b5fa.mp4\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0687/8557/0066/files/13._Toys_to_Reduce_Tantrums_2d6f3958-2858-41a0-93bf-710918b7a44c.avifs?v=1734706897\" alt=\"Thumbnail for 13.mp4\">\n\n\n\n    </div>\n\n    <div class=\"fullscreen-player\" id=\"fullscreen-player\">\n        <button class=\"close-btn\" id=\"close-btn\">✕</button>\n        <video id=\"video-player\" controls autoplay></video>\n    </div>\n\n    <script>\n        const thumbnails = document.querySelectorAll('.thumbnail');\n        const fullscreenPlayer = document.getElementById('fullscreen-player');\n        const videoPlayer = document.getElementById('video-player');\n        const closeBtn = document.getElementById('close-btn');\n\n        // Open fullscreen video player\n        thumbnails.forEach((thumbnail) => {\n            thumbnail.addEventListener('click', () => {\n                const videoSrc = thumbnail.dataset.video;\n                videoPlayer.src = videoSrc;\n                fullscreenPlayer.style.display = 'flex';\n                videoPlayer.play();\n            });\n        });\n\n        // Close fullscreen video player\n        closeBtn.addEventListener('click', () => {\n            fullscreenPlayer.style.display = 'none';\n            videoPlayer.pause(); // Stop video playback\n            videoPlayer.src = ''; // Clear video source\n        });\n    </script>\n</body>",
        "custom_class": ""
      }
    },
