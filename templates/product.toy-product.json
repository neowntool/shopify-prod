        "sku": "",
        "left_liquid": "<div class=\"np-wrapper\"> <div class=\"np-card\"> <h1 class=\"np-title\">Smart Parenting<br>Starts Here</h1> <p class=\"np-subtitle\"> Discover books & toys, manage subscriptions, and keep learning simple—all from one app. </p> <div class=\"np-feature\"> <span class=\"np-dot np-pink\"></span> <div class=\"np-line np-pink-line\"></div> <h3>Easy Selection</h3> <p>Browse 75,000+ books & 1500+ toys by age, interest, and reading level</p> </div> <div class=\"np-feature\"> <span class=\"np-dot np-yellow\"></span> <div class=\"np-line np-yellow-line\"></div> <h3>Expert Recommendations</h3> <p>Get personalized book suggestions based on reading history</p> </div> <div class=\"np-feature\"> <span class=\"np-dot np-purple\"></span> <div class=\"np-line np-purple-line\"></div> <h3>Waitlist Books</h3> <p>Books in circulation? Waitlist them to get your next</p> </div> <div class=\"np-feature\"> <span class=\"np-dot np-blue\"></span> <div class=\"np-line np-blue-line\"></div> <h3>Reading Challenge</h3> <p>Build discipline & a strong habit of reading daily & get rewards</p> </div> <div class=\"np-footer\"> <div class=\"np-download\"> <p>Download the neOwn app</p> <div class=\"np-buttons\"><a href=\"https://apps.apple.com/in/app/neown/id6483860525\" target=\"_blank\"> <img src=\"https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg\" alt=\"App Store\"></a> <a href=\"https://play.google.com/store/apps/details?id=com.neown\" target=\"_blank\"> <img src=\"https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg\" alt=\"Google Play\"></a> </div> </div> </div> </div> </div>",
        "right_image": "shopify://shop_images/ChatGPT_Image_Feb_13_2026_04_01_12_PM_1.png",
        "image_position": "left"
      }
