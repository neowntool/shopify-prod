        "custom_liquid_RTGKXY": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign genres = product.metafields.custom.developmental_skill.value %}\n\n{% if genres != blank %}\n<div class=\"gg-labels-wrapper-unique\">\n\n  {% for genre in genres %}\n    <div class=\"gg-label-box-unique\">{{ genre }}</div>\n  {% endfor %}\n\n</div>\n{% endif %}\n\n<style>\n.gg-labels-wrapper-unique {\n  display: flex;\n  gap: 10px;\n  margin: 10px 0;\n  flex-wrap: wrap;\n}\n\n.gg-label-box-unique {\n  background-color: #F0EBFF;\n  padding: 8px 14px;\n  border-radius: 8px;\n  font-size: 16px;\n  font-weight: 500;\n  color: #333;\n  text-align: center;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  width: auto; \n}\n</style>"
          }
