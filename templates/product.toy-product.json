        "custom_liquid_34BgNJ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"gg-tabs-wrapper-unique\">\n\n  <div class=\"gg-tabs-nav-unique\">\n    <button class=\"gg-tab-btn-unique active\">PRODUCT DETAILS</button>\n  </div>\n\n  <div class=\"gg-tabs-content-unique\">\n    <div class=\"gg-tab-panel-unique active\">\n\n      {% if product.metafields.custom.toy_brand != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Brand:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.toy_brand.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.age != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Age:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.age.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.age_category != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Age Category:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.age_category }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.type_of_toy != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Product Type:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.type_of_toy.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.material != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Material:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.material.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.genres != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Genres:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.genres.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.developmental_skill != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Developmental Skill:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.developmental_skill.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n      {% if product.metafields.custom.author_multi != blank %}\n      <div class=\"gg-detail-row-unique\">\n        <div class=\"gg-detail-label-unique\">Author:</div>\n        <div class=\"gg-detail-value-unique\">\n          {{ product.metafields.custom.author_multi.value | join: \", \" }}\n        </div>\n      </div>\n      {% endif %}\n\n    </div>\n  </div>\n\n</div>\n\n<style>\n.gg-tabs-wrapper-unique {\n  margin-top: 30px;\n  font-family: inherit;\n}\n\n.gg-tabs-nav-unique {\n  display: flex;\n  border-bottom: 1px solid #ddd;\n}\n\n.gg-tab-btn-unique {\n  background: none;\n  border: none;\n  padding: 12px 20px;\n  cursor: default;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  border-bottom: 2px solid #000;\n}\n\n.gg-tabs-content-unique {\n  padding-top: 20px;\n}\n\n.gg-detail-row-unique {\n  display: flex;\n  margin-bottom: 14px;\n}\n\n.gg-detail-label-unique {\n  width: 180px;\n  font-weight: 500;\n  color: #555;\n}\n\n.gg-detail-value-unique {\n  font-weight: 600;\n  color: #222;\n}\n</style>"
