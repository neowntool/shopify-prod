w":5,"item_gap":30,"pcard_layout":"","pcard_image_ratio":"","show_vendor":false,"hide_title":false,"enable_slider":true,"show_pagination":false,"show_navigation":true,"show_button_on_header":true,"button_type":"link","button_text":"View more","button_style":"m-button--secondary","button_size":"m-button--small","infinite_load":false,"max_page_load":3,"mobile_disable_slider":false,"use_scroll_mobile":true,"item_gap_mobile":16,"padding_top":10,"padding_bottom":10,"custom_class":"","animations":"inherit"}},"brands_list_JKyRzD":{"type":"brands-list","blocks":{"image_jLY8Ap":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Expert_picks.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_cKEMyM":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Huge_savings.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_gbPkwd":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Doorstep_del.png","image_by_url":"","image_link":"","max_width":"150px"}},"image_CMgz3E":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/no_storage_hassle.png","image_by_url":"","image_link":"","max_width":"150px"}}},"block_order":["image_jLY8Ap","image_cKEMyM","image_gbPkwd","image_CMgz3E"],"name":"Brands list","settings":{"heading":"Why Choose neOwn?","heading_size":"h3","subheading":"","description":"","header_alignment":"center","container":"container-fluid","color_scheme":"","item_per_row":4,"column_gap":30,"row_gap":30,"column_gap_mobile":10,"row_gap_mobile":10,"enable_slider":false,"show_nav":false,"show_pagination":false,"autorotate":false,"autorotate_speed":3,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"rich_text_UHKPdn":{"type":"rich-text","blocks":{"heading_nLaxXj":{"type":"heading","settings":{"heading":"<b>FAQs<\/b>","heading_size":"h2"}}},"block_order":["heading_nLaxXj"],"settings":{"container":"container","color_scheme":"","content_alignment":"center","padding_top":100,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"page_faqs_jY7xLJ":{"type":"page-faqs","blocks":{"accordion_XiWthW":{"type":"accordion","settings":{"title":"Do you deliver all over India?","content":"<p>Currently, we only deliver books all over India. <\/p><p>Delivery is free within Mumbai, Thane, Navi Mumbai, and Mira-Bhayander. <\/p><p>Outside Mumbai: There is an additional delivery charge for Book Library deliveries outside Mumbai. <\/p><p>(Toy Library is only operating in Mumbai as of now) <\/p>","open":false}},"accordion_wWxapm":{"type":"accordion","settings":{"title":"How does the Library Subscription work?","content":"<p>Step 1: 📚🧸You can subscribe to any plan from our website. <\/p><p>Step 2: 📲Download the neOwn app to select your books. <\/p><p>Step 3: 📦Books will be delivered and the pickup and exchange will happen after maximum 30 days<\/p><p>Step 4: 🔁Finally you return and repeat the same for all the following months of your subscription!<\/p>","open":false}},"accordion_98FnHe":{"type":"accordion","settings":{"title":"How can I select my books?","content":"<p>Once you have subscribed, you can download our app📲 from which you can select the books 📚<\/p><p>You can select any books of your choice, and in case you are not sure what to pick we have a book expert in-house who can help you out if needed 💖<\/p>","open":false}},"accordion_TjN8da":{"type":"accordion","settings":{"title":"How to download the neOwn app?","content":"<p>📲 neOwn App Link: <\/p><p>🔗 Android: <a href=\"https:\/\/play.google.com\/store\/apps\/details?id=com.neown\"><span style=\"text-decoration:underline\">https:\/\/play.google.com\/store\/apps\/details?id=com.neown<\/span><\/a> <\/p><p>🔗 Apple: <a href=\"https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525\"><span style=\"text-decoration:underline\">https:\/\/apps.apple.com\/in\/app\/neown\/id6483860525<\/span><\/a> <\/p>","open":false}},"accordion_fhEYkH":{"type":"accordion","settings":{"title":"What if I damage a Library Book? What if I lose a Library Book?","content":"<p>If the damage is minor and can be repaired by us, there will be no additional charge to you.<\/p><p>If the damage is major such that it cannot be circulated anymore, or if the book is lost\/misplaced, we will charge you 40% of the MRP of the item (and you can keep the item).<\/p><p>neOwn trusts moms to take the utmost care of books so that we can all collectively enjoy them!<\/p>","open":false}},"accordion_JGFVja":{"type":"accordion","settings":{"title":"Is there any deposit or registration fee?","content":"<p>No, there is no deposit or registration fee. <\/p>","open":false}},"accordion_VUQPmJ":{"type":"accordion","settings":{"title":"Do I get to choose my books or do you send pre-curated books?","content":"<p>You can choose your books! If you require any help with selection, you can take recommendations from our in-house book expert. <\/p>","open":false}},"accordion_dXNAQy":{"type":"accordion","settings":{"title":"There’s no place to enter my child’s details on the website, how will you know what kind of books I want?","content":"<p>Our app asks for all these details to create a profile for your child. <\/p><p>Once you subscribe to any plan, you have to log in to our neOwn App to select your books. <\/p><p>Before you can view the catalog on the app, you have to enter all your child’s details - including their age, so that we can provide an age-appropriate catalog for them. <\/p>","open":false}},"accordion_ikFw3k":{"type":"accordion","disabled":true,"settings":{"title":"Can I see your collection before subscribing? What kind of books do you have?","content":"<p>Yes, you can see our collections here: <\/p><p>Book Collection: <\/p><p>We keep a very wide variety of fiction books for children between the ages of 0-15 years, and we also have a lot of non-fiction and educational books for children between the ages of 0-15 years. <\/p>","open":false}},"accordion_gdKihh":{"type":"accordion","settings":{"title":"Can I get books for both my children in one library subscription, or do I need to subscribe to the ‘2 Siblings’ plan?","content":"<p>No, you cannot get books for both children in one library subscription. You can subscribe to the ‘2 Siblings’ plan to get books for both your children, where you can get 3 books for each child or 5 books for each child. The reason for this is that we create a unique profile for each child with all their details and provide an age-appropriate curated catalog of books to choose from. This will enable you to see each child’s unique progress as well as all the books they have read in a more organised manner. <\/p>","open":false}},"accordion_An7P48":{"type":"accordion","settings":{"title":"How do you sanitize the books?","content":"<p>Our process to ensure the books are hygenic and in good condition: <\/p><ul><li>⁠We do a thorough check of all books twice - once after they have come back from customers and the second time before they are going to another customer <\/li><li>⁠⁠We also clean board books to ensure they are 100% sanitary <\/li><li>⁠⁠If any books are of bad quality we don't circulate them among customers anymore<\/li><\/ul>","open":false}},"accordion_hkpzbC":{"type":"accordion","settings":{"title":"If I subscribe today, will my 30 days start now?","content":"<p>No, your 30 days will start after the books have been delivered to you. <\/p><p>Once you subscribe, you have to download our app to select your books. After selection, they will be delivered in 2-5 days within Mumbai and 4-8 days outside Mumbai. <\/p><p>Your 30 days start from the day when the books are delivered. <\/p>","open":false}},"accordion_CDDD3E":{"type":"accordion","disabled":true,"settings":{"title":"What are the shipping charges for outstation?","content":"<p>The shipping charges for out-of-Mumbai deliveries are as follows: <\/p><p><strong>Plan Name<\/strong><\/p><p><strong>Number of items per month <\/strong><\/p><p><strong>Outside Mumbai Shipping Charge <\/strong><\/p><p>Book Library (1 child)<\/p><p>5 books per month<\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (3+3 Plan)<\/p><p>3+3 (total 6) books per month <\/p><p>₹150\/- per month<\/p><p>Book Library (2 siblings) (5+5 Plan)<\/p><p>5+5 books (total 10) per month<\/p><p>₹200\/- per month<\/p><p>Currently our Toy Library is only being serviced in Mumbai, Navi Mumbai, & Thane. <\/p>","open":false}},"accordion_yfMLJP":{"type":"accordion","settings":{"title":"My pin code is showing not serviceable. What do I do?","content":"<p>We may still be able to deliver to you! WhatsApp us at +91 91370 81640 and let us know your pin code, we’ll inform you if your area is serviceable. <\/p>","open":false}},"accordion_mQpgdp":{"type":"accordion","settings":{"title":"How do I return the Library books?","content":"<p>Once you are done reading the books, you can select ‘Done Reading’ on our app. Then you have to select your next set of books. Once the next set is confirmed, our team will schedule a delivery for the new items and a pickup to return the old books. The return process is as follows: We’ll send our delivery partner directly to your doorstep for the pickup of the books. You’ll be notified of the timelines, and you can keep the books packed for when it's time for the pickup.<\/p>","open":false}},"accordion_PAKXyM":{"type":"accordion","settings":{"title":"Do you have other languages books?","content":"<p>Yes! We also have a limited collection of books in Hindi, Marathi, and Gujarati. <\/p>","open":false}},"accordion_rF4wgm":{"type":"accordion","settings":{"title":"Can I cancel the Library Subscription at any time?","content":"<p>At this time, we do not offer order cancellation.<\/p><p>In case you’re facing any problems or are unhappy with your subscription, we’d love to hear what you would like us to change or improve! WhatsApp us on +91 91370 81640, or you can get in touch directly with our founder at kranti@neown.in.<\/p>","open":false}}},"block_order":["accordion_XiWthW","accordion_wWxapm","accordion_98FnHe","accordion_TjN8da","accordion_fhEYkH","accordion_JGFVja","accordion_VUQPmJ","accordion_dXNAQy","accordion_ikFw3k","accordion_gdKihh","accordion_An7P48","accordion_hkpzbC","accordion_CDDD3E","accordion_yfMLJP","accordion_mQpgdp","accordion_PAKXyM","accordion_rF4wgm"],"settings":{"headingsec":"","container":"container","color_scheme":"","menu":"","custom_class":""}},"custom_liquid_bjkGf8":{"type":"custom-liquid","custom_css":[],"settings":{"custom_liquid":"<title>Responsive Div<\/title>\n    <style>\n        body {\n            margin: 0;\n            font-family: \"DM Sans\", sans-serif;\n            background-color: #f0f0f0;\n        }\n        .container-chat {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            \/* min-height: 100vh; *\/\n            padding: 20px;\n            background-color: #ffffff;\n        }\n        .content-chat {\n            background: linear-gradient(to bottom, #7A62E4, #a32ed5);\n            border-radius: 20px;\n            text-align: center;\n            padding: 90px;\n            max-width: 1200px;\n            width: 100%;\n            color: white;\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n        }\n        .content-chat h1 {\n            font-size: 28px;\n            color: #ffffff;\n            margin-bottom: 20px;\n        }\n        .content-chat p {\n            margin: 10px 0;\n            font-size: 18px;\n        }\n        .content-chat a {\n            display: inline-block;\n            background: white;\n            color: #EB5CE8;\n            padding: 15px 30px;\n            border-radius: 50px;\n            text-decoration: none;\n            font-weight: bold;\n            transition: background 0.3s, color 0.3s;\n            margin-top: 20px;\n        }\n        .content-chat a:hover {\n            background: #EB5CE8;\n            color: white;\n        }\n        @media (max-width: 600px) {\n            .content-chat {\n                padding: 20px;\n            }\n            .content-chat h1 {\n                font-size: 22px;\n            }\n            .content-chat p {\n                font-size: 16px;\n            }\n            .content-chat a {\n                padding: 10px 20px;\n                font-size: 16px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"container-chat\">\n        <div class=\"content-chat\">\n            <h1>Still not convinced?<\/h1>\n            <p>Join our FREE Parents’ Community on WhatsApp<\/p>\n            <p>📚 Kids Sessions: Online book club, storytelling, & creative writing<\/p>\n            <p>💡 Monthly Reading Challenges<\/p>\n            <p>💬 Q&A sessions with experts<\/p>\n            <a href=\"https:\/\/chat.whatsapp.com\/Ixt3hz8fc6g6digIYWBeOj\">Join Now<\/a>\n        <\/div>\n    <\/div>\n<\/body>","custom_class":""}}},"order":["main","slider_nk8kRa","custom_liquid_BMd3Hp","new_featured_product_yfEYxn","empty_space_xGj4LT","image_with_text_2_tbd8pm","image_with_text_2_fURLEb","image_with_text_2_eQkrng","image_with_text_2_QnKDJM","rich_text_NbVHdB","image_with_text_2_CQbrCm","empty_space_9g3Wgr","custom_liquid_eiDFU6","image_with_text_2_yzCgGN","rich_text_gtPVCt","scrolling_promotion_XreH74","empty_space_XNQ7di","featured_collection_daej9d","featured_collection_QkfdC8","featured_collection_RbGLcc","brands_list_JKyRzD","rich_text_UHKPdn","page_faqs_jY7xLJ","custom_liquid_bjkGf8"]}